}
APS = ("U6-Plus-Salon-TV", "U6-Lite-Office", "UAP-AC-Lite-Habitacion", "U6-Lite-Salon-Relay")
FLEET = ("cobra", "hifipi", "dockassist", "vinylstreamer", "unifi", "cwwk", "agent-lxc", "workbench-lxc")
