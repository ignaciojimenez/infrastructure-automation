#!/usr/bin/env python3
"""Network behaviour baseline around an OPNsense upgrade.

    bin/opnsense-validate pre      # before: baseline, plus a /conf/config.xml backup
    bin/opnsense-validate post     # after: same checks, diffed against the latest pre

Read-only: nothing is configured, restarted or renewed. Reaches the firewall as
`ssh opnsense` (one Touch ID; ControlMaster reuses it), the fleet as read_agent
(`<host>-agent`, which posts its usual ssh_alert), and queries DNS from the laptop.

Each check records id, command, observed, expected and PASS/FAIL/INFO. The
diff compares status plus a normalised value, so the answer is "what behaved
differently", not a judgement. Never in the diff value (they move between runs
on their own): uptime, WireGuard handshake ages, lease counts and DHCPACK
counts, gateway delay/loss and the dpinger
loss/delay alarms derived from them (only "down" counts), ping RTTs, external A records, the DNSBL test
domain, the sweep's timestamp, the bouncer's last pull, AP firmware. The
OPNsense version is expected to change; `post` instead FAILs if it did not.

Results go to ~/validation (mode 700, files 600; OPNSENSE_VALIDATE_DIR to
override), never the repo: they hold MACs and the backup holds secrets. Egress
lines drop the public address, so no WAN address is recorded.

The sweep is read, not triggered: it runs hourly at :37. `post` refuses a sweep
older than both the pre run and the firewall's boot; --wait-sweep waits for one.
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OUT_DIR = Path(os.environ.get("OPNSENSE_VALIDATE_DIR", Path.home() / "validation"))
FW = "opnsense"
RESOLVER = "10.30.40.254"

# Every name must answer with exactly this one A record and its PTR.
HOSTS = {
