#!/bin/sh
# Put Transmission's RPC login into vault without ever printing it.
#
#   bin/transmission-rpc-credentials               # prompt for a new password
#   bin/transmission-rpc-credentials --from FILE   # copy it from a settings.json on cobra
#
# Writes vault_transmission_rpc_username and vault_transmission_rpc_password_hash,
# replacing any earlier value of either. The password is stored as Transmission's
# own hash (libtransmission/crypto-utils.c, tr_ssha1): `{` + sha1(password + salt)
# in lowercase hex + an 8-character salt. Transmission keeps a `{`-prefixed value
# verbatim, so the deployed settings.json converges instead of being rehashed.
# The role's assert (tasks/credentials.yml) checks the same shape.
#
# Deploy afterwards:
#   ansible-playbook ansible/playbooks/services.yml --limit cobra --tags transmission
set -eu

CDPATH=''
ROOT=$(cd -- "$(dirname -- "$0")/.." && pwd)
VAULT=ansible/inventory/group_vars/all/vault.yml
HOST=cobra
SHAPE='^[{][0-9a-f]{40}[./0-9A-Za-z]{8}$'

cd "$ROOT"

if [ "${1:-}" = --from ]; then
    [ $# -eq 2 ] || { echo "usage: $0 [--from FILE]" >&2; exit 2; }
    # $2 is meant to expand here: it names the file on cobra.
    # shellcheck disable=SC2029
    lines=$(ssh "$HOST" "sudo -n grep -E '\"rpc-(username|password)\"' '$2'")
    user=$(printf '%s\n' "$lines" | sed -n 's/.*"rpc-username": *"\([^"]*\)".*/\1/p')
    hash=$(printf '%s\n' "$lines" | sed -n 's/.*"rpc-password": *"\([^"]*\)".*/\1/p')
else
    printf 'RPC username: '
    read -r user
    stty -echo
    trap 'stty echo' EXIT
    printf 'RPC password: '
    read -r pw
    printf '\nAgain: '
    read -r pw2
    stty echo
    printf '\n'
    [ "$pw" = "$pw2" ] || { echo "passwords differ; nothing written" >&2; exit 1; }
    # On stdin, not argv or the environment, so it never shows in ps.
    hash=$(printf '%s' "$pw" | python3 -c '
import hashlib, secrets, sys
alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ./"
salt = "".join(secrets.choice(alphabet) for _ in range(8))
print("{" + hashlib.sha1((sys.stdin.read() + salt).encode()).hexdigest() + salt)
')
    unset pw pw2
fi

# Refuse anything the role would refuse, so a bad value never reaches vault.
[ -n "$user" ] || { echo "no username found; nothing written" >&2; exit 1; }
printf '%s' "$hash" | grep -Eq "$SHAPE" \
    || { echo "password is not a Transmission hash (${#hash} chars); nothing written" >&2; exit 1; }
case "$user$hash" in
    *\"* | *\\*) echo "value contains a quote or backslash; nothing written" >&2; exit 1 ;;
esac

# The plaintext vault exists only in 0600 temp files, removed on any exit.
umask 077
old=$(mktemp "${TMPDIR:-/tmp}/vault.XXXXXX")
new=$(mktemp "${TMPDIR:-/tmp}/vault.XXXXXX")
trap 'rm -f "$old" "$new"; stty echo 2>/dev/null || true' EXIT

# Not a pipe: sh has no pipefail, and a failed decrypt feeding grep would leave
# a vault holding only the two lines below.
ansible-vault view "$VAULT" > "$old"
before=$(wc -l < "$old")
[ "$before" -gt 10 ] || { echo "decrypted vault has $before lines; refusing" >&2; exit 1; }
grep -v -E '^vault_transmission_rpc_(username|password_hash):' "$old" > "$new" || true
printf 'vault_transmission_rpc_username: "%s"\n' "$user" >> "$new"
printf 'vault_transmission_rpc_password_hash: "%s"\n' "$hash" >> "$new"
after=$(wc -l < "$new")
[ "$after" -ge "$before" ] || { echo "would drop vault lines ($before -> $after); refusing" >&2; exit 1; }

ansible-vault encrypt "$new"
# shellcheck disable=SC2016  # a literal $, the vault header
head -1 "$new" | grep -q '^\$ANSIBLE_VAULT;' \
    || { echo "encryption did not happen; vault left unchanged" >&2; exit 1; }
cp "$new" "$VAULT"

echo "vault: wrote vault_transmission_rpc_username (${#user} chars)" \
    "and vault_transmission_rpc_password_hash (${#hash} chars)"
