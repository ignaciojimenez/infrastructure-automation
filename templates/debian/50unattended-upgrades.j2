// Unattended-Upgrade configuration - Migrated from raspberrypi-ansible
// Managed by Ansible — do not edit here. See ansible/playbooks/tasks/debian_updates.yml
// Based on https://gist.github.com/anatolebeuzon/98ff195f3375e8ca621e7df3955b4f23

// Patterns match the Origin/Codename/Label fields of each repo's InRelease
// file (/var/lib/apt/lists/*_InRelease). Read those before adding one: a
// pattern that matches nothing fails silently (PER-200 found three).
Unattended-Upgrade::Origins-Pattern {
        // Debian security updates. Since bullseye the security archive's
        // codename is "<release>-security", so this is the only form that matches.
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
{% if enable_unattended_point_releases | default(true) %}

        // Debian point releases — the same set Debian's own shipped default
        // allows. Not feature updates: "mainly corrections for security issues,
        // along with a few adjustments for serious problems", batched about
        // every two months. stable-updates (-updates) stays out, as in Debian's
        // default. Off on Proxmox: PVE needs full-upgrade, which this cannot do.
        "origin=Debian,codename=${distro_codename},label=Debian";
{% endif %}
{% if enable_unattended_rpi_repo | default(false) %}

        // Raspberry Pi's own repo: kernel, firmware, bootloader EEPROM (flashed
        // at the next boot by rpi-eeprom-update), AND its "+rpt" rebuilds of
        // Debian packages — openssl, mesa, pipewire, wireless firmware. It
        // publishes no separate security label, so this is all of it or none.
        // A kernel sets reboot-required, so Automatic-Reboot below applies it.
        "origin=Raspberry Pi Foundation,codename=${distro_codename},label=Raspberry Pi Foundation";
{% endif %}
{% if custom_origins is defined %}

        // Per-host vendor repositories, set as `custom_origins` in inventory.
        // Third-party repos publish no Debian-Security label, so the patterns
        // above can never match them and their software would receive no
        // automatic updates at all. Listing an origin here opts that repo in.
        // Prefer repos whose suite pins a major version (e.g. mongodb-org/8.0,
        // unifi-9.4) — those can only deliver patches within the pinned line.
{% for origin in custom_origins %}
        "{{ origin }}";
{% endfor %}
{% endif %}
};

// Package blacklist: packages that should *never* be automatically upgraded.
// Docker is not listed because it needs no listing: download.docker.com is in
// no allowed origin above, so it is never upgraded unattended. Keep it that way.
Unattended-Upgrade::Package-Blacklist {
{% if custom_blacklist is defined %}
{% for package in custom_blacklist %}
        "{{ package }}";
{% endfor %}
{% endif %}
};

// Email notifications (optional)
{% if notification_email is defined %}
Unattended-Upgrade::Mail "{{ notification_email }}";
Unattended-Upgrade::MailReport "only-on-error";
{% else %}
//Unattended-Upgrade::Mail "";
{% endif %}

// Remove unused dependencies from the upgrade process
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Remove unused kernel packages
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";

// Automatically reboot *WITHOUT CONFIRMATION* if
//  the file /var/run/reboot-required is found after the upgrade
Unattended-Upgrade::Automatic-Reboot "{{ auto_reboot | default(true) }}";

// If automatic reboot is enabled and needed, reboot at the specific
// time instead of immediately
//  Default: "now"
Unattended-Upgrade::Automatic-Reboot-Time "{{ auto_reboot_time | default('04:00') }}";
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";

// Logging
Unattended-Upgrade::SyslogEnable "true";
Unattended-Upgrade::SyslogFacility "daemon";

// Download and install upgrades in minimal steps
Unattended-Upgrade::MinimalSteps "true";

// Bandwidth limits (in kb/s, 0 = unlimited)
{% if bandwidth_limit is defined %}
Acquire::http::Dl-Limit "{{ bandwidth_limit }}";
{% else %}
//Acquire::http::Dl-Limit "0";
{% endif %}
