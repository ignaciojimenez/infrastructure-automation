# Home Assistant Automations - Managed by Ansible

# Lights on when dark — fires at sunset (if someone home) or on arrival (if already dark)
- id: '1614473127522'
  alias: Lights on when dark
  trigger:
    - platform: numeric_state
      entity_id: sun.sun
      value_template: '{{ "{{ state_attr(\"sun.sun\", \"elevation\") }}" }}'
      below: '1.5'
    - platform: state
      entity_id: group.persons
      to: "home"
      for:
        minutes: 2
  condition:
    - condition: numeric_state
      entity_id: sun.sun
      attribute: elevation
      below: 1.5
    - condition: state
      entity_id: group.persons
      state: home
    - condition: state
      entity_id: light.all_lights
      state: "off"
  action:
    - service: scene.turn_on
      target:
        entity_id: scene.chill
  mode: single

# Lights off automations
- id: '1638915083194'
  alias: lights off - week
  trigger:
    - platform: time
      at: '00:30:00'
  condition:
    - condition: time
      weekday: [mon, tue, wed, thu]
  action:
    - service: light.turn_off
      target:
        entity_id: light.all_lights
  mode: single

- id: '1638916130644'
  alias: lights off - weekend
  trigger:
    - platform: time
      at: '02:30:00'
  condition:
    - condition: time
      weekday: [fri, sat, sun]
  action:
    - service: light.turn_off
      target:
        entity_id: light.all_lights
  mode: single

# Daily backups
- id: '1687725012156'
  alias: Daily backups
  trigger:
    - platform: time
      at: '03:00:00'
  action:
    - service: backup.create
  mode: single

 # Away/Home mode
# Uses Tado API (presenceLock) to properly set home/away without fighting
# Tado's own schedules. Template trigger treats "not_home" and "unknown" as away,
# preventing hourly device-tracker polling blips from resetting the timer.
- id: "away_mode_everyone_left"
  alias: "Away Mode - Everyone Left"
  trigger:
    - platform: template
      value_template: >
        {{ '{{ states("group.persons") != "home" }}' }}
      for:
        minutes: 10
  condition:
    - condition: state
      entity_id: input_boolean.guest_mode
      state: "off"
  action:
    - service: shell_command.tado_set_away
    - service: input_select.select_option
      target:
        entity_id: input_select.tado_mode
      data:
        option: "Away"
    - service: light.turn_off
      target:
        entity_id: light.all_lights
  mode: single

- id: "home_mode_first_arrives"
  alias: "Home Mode - First Person Arrives"
  trigger:
    - platform: template
      value_template: >
        {{ '{{ states("group.persons") == "home" }}' }}
      for:
        minutes: 3
  action:
    - service: shell_command.tado_set_home
    - service: input_select.select_option
      target:
        entity_id: input_select.tado_mode
      data:
        option: "Home"
    - service: rest_command.slack_notify
      data:
        message: "Welcome home! Tado set to HOME."
  mode: single

# Guest mode
- id: "guest_mode_enabled"
  alias: "Guest Mode - Disable Auto Away"
  trigger:
    - platform: state
      entity_id: input_boolean.guest_mode
      to: "on"
  action:
    - service: automation.turn_off
      target:
        entity_id: automation.away_mode_everyone_left
  mode: single

- id: "guest_mode_disabled"
  alias: "Guest Mode Off - Enable Auto Away"
  trigger:
    - platform: state
      entity_id: input_boolean.guest_mode
      to: "off"
  action:
    - service: automation.turn_on
      target:
        entity_id: automation.away_mode_everyone_left
  mode: single

# Shelly bulb monitoring - alerts when bulbs go offline/online.
# Watched list = homeassistant_lights (the light.all_lights group members).
- id: "shelly_bulb_offline_alert"
  alias: "Shelly Bulb Offline Alert"
  trigger:
    - platform: state
      entity_id:
{% for light in homeassistant_lights %}
        - {{ light }}
{% endfor %}
      to:
        - "unavailable"
        - "unknown"
      for:
        minutes: 5
    # Startup sweep: a bulb already dead when HA boots never transitions,
    # so the state trigger alone misses it.
    - platform: homeassistant
      event: start
  action:
    - choose:
        - conditions:
            - condition: template
              value_template: "{{ '{{ trigger is defined and trigger.platform == \'homeassistant\' }}' }}"
          sequence:
            - delay:
                minutes: 5
            - condition: template
              value_template: "{{ '{{ expand(\'light.all_lights\') | selectattr(\'state\', \'in\', [\'unavailable\', \'unknown\']) | list | count > 0 }}' }}"
            - service: rest_command.slack_notify
              data:
                message: "{{ '{{' }} \"⚠️ Shelly bulb(s) offline since HA start: \" ~ (expand('light.all_lights') | selectattr('state', 'in', ['unavailable', 'unknown']) | map(attribute='name') | join(', ')) {{ '}}' }}"
      default:
        - service: rest_command.slack_notify
          data:
            message: "{{ '{{' }} \"⚠️ Shelly bulb offline: \" ~ (trigger.to_state.attributes.friendly_name | default(trigger.entity_id)) {{ '}}' }}"
  mode: parallel

- id: "shelly_bulb_online_recovery"
  alias: "Shelly Bulb Online Recovery"
  trigger:
    - platform: state
      entity_id:
{% for light in homeassistant_lights %}
        - {{ light }}
{% endfor %}
      from:
        - "unavailable"
        - "unknown"
      to:
        - "on"
        - "off"
  action:
    - service: rest_command.slack_notify
      data:
        message: "{{ '{{' }} \"✅ Shelly bulb back online: \" ~ (trigger.to_state.attributes.friendly_name | default(trigger.entity_id)) {{ '}}' }}"
  mode: parallel

# HomeKit heating availability monitoring
- id: "homekit_tado_climate_offline_alert"
  alias: "HomeKit Tado Climate Offline Alert"
  trigger:
    - platform: state
      entity_id:
        - climate.tado_smart_thermostat_ru3393984256
        - climate.tado_smart_thermostat_su3182126080
        - climate.tado_smart_radiator_thermostat_va3363583744
        - climate.tado_smart_radiator_thermostat_va0290656256
        - climate.tado_smart_radiator_thermostat_va2220036096
        - climate.tado_smart_radiator_thermostat_va0612513536
        - climate.tado_smart_radiator_thermostat_va1065432832
        - climate.tado_smart_radiator_thermostat_va2323724032
      to: "unavailable"
      # 20 min: these entities are monitoring-only (heads heat on their local
      # schedule regardless), so short RF blips are immaterial — don't page them.
      for:
        minutes: 20
  # Global 6h cooldown: a flapping head pages once per 6h, not every outage.
  # Heads keep heating on their local schedule while unavailable in HA, so a
  # page delayed by the shared cooldown is an accepted trade for zero helpers.
  condition:
    - condition: template
      value_template: "{{ '{{' }} this.attributes.last_triggered is none or now() - this.attributes.last_triggered > timedelta(hours=6) {{ '}}' }}"
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"⚠️ Heating offline: \" ~ (trigger.to_state.attributes.friendly_name | default(trigger.entity_id)) {{ '}}' }}"
  mode: parallel

- id: "homekit_tado_climate_online_recovery"
  alias: "HomeKit Tado Climate Online Recovery"
  trigger:
    - platform: state
      entity_id:
        - climate.tado_smart_thermostat_ru3393984256
        - climate.tado_smart_thermostat_su3182126080
        - climate.tado_smart_radiator_thermostat_va3363583744
        - climate.tado_smart_radiator_thermostat_va0290656256
        - climate.tado_smart_radiator_thermostat_va2220036096
        - climate.tado_smart_radiator_thermostat_va0612513536
        - climate.tado_smart_radiator_thermostat_va1065432832
        - climate.tado_smart_radiator_thermostat_va2323724032
      from: "unavailable"
  action:
    - service: rest_command.slack_notify
      data:
        message: "{{ '{{' }} \"✅ Heating back online: \" ~ (trigger.to_state.attributes.friendly_name | default(trigger.entity_id)) {{ '}}' }}"
  mode: parallel

# Eve door sensors - notification when doors open while nobody is home
# Only triggers if group.persons has been not_home for at least 5 minutes
# (avoids false alerts when leaving home and crossing geofence)
# Sensor mapping:
#   binary_sensor.eve_door_20ebn9901_door   -> Balcony Door
#   binary_sensor.eve_door_20ebn9901_door_2 -> Entrance Door
- id: "eve_door_open_while_away"
  alias: "Door Opened While Away"
  trigger:
    - platform: state
      entity_id: binary_sensor.eve_door_20ebn9901_door
      to: "on"
      id: balcony
    - platform: state
      entity_id: binary_sensor.eve_door_20ebn9901_door_2
      to: "on"
      id: entrance
  condition:
    - condition: state
      entity_id: group.persons
      state: "not_home"
      for:
        minutes: 5
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"🚪 Balcony\" if trigger.id == \"balcony\" else \"🚪 Entrance\" {{ '}}' }} door opened while away"
  mode: single

# ============================================================
# TRAIN COMMUTE NOTIFICATION
# ============================================================
# Sends train platform info when Choco leaves home on weekday mornings

- id: "train_commute_notification"
  alias: "Train Commute - Platform Notification"
  description: "Send NS train platform info when leaving for work (combined Tado + Companion app)"
  trigger:
    - platform: state
      entity_id: "{{ ha_primary_presence_sensor | default('binary_sensor.primary_presence') }}"
      from: "on"
      to: "off"
  condition:
    - condition: time
      after: "07:00:00"
      before: "10:00:00"
      weekday:
        - mon
        - tue
        - wed
        - thu
        - fri
    - condition: state
      entity_id: input_boolean.train_notified_today
      state: "off"
  action:
    - service: input_boolean.turn_on
      target:
        entity_id: input_boolean.train_notified_today
    - service: shell_command.notify_train_platform
  mode: single

- id: "train_notification_reset"
  alias: "Train Notification - Daily Reset"
  description: "Reset train notification flag at midnight"
  trigger:
    - platform: time
      at: "00:00:00"
  action:
    - service: input_boolean.turn_off
      target:
        entity_id: input_boolean.train_notified_today
  mode: single

# ============================================================
# SECURITY MONITORING
# ============================================================
- id: 'security_login_failure_alert'
  alias: 'Security: Failed Login Attempts Alert'
  description: 'Alert on failed login attempts and IP bans via Slack'
  trigger:
    - platform: persistent_notification
      update_type: added
  condition:
    - condition: template
      value_template: >
        {{ '{% set message = trigger.notification.message | default("") %}' }}
        {{ '{% set title = trigger.notification.title | default("") %}' }}
        {{ '{{ "Login attempt" in message or "login attempt" in message or' }}
           {{ '"Too many login attempts" in message or "Banned" in message or' }}
           {{ '"invalid authentication" in message }}' }}
  action:
    - service: rest_command.slack_alert
      data:
        message: >
          {{ '🚨 Security Alert - {{ now().strftime("%Y-%m-%d %H:%M:%S") }}' }}
          
          {{ '{% set msg = trigger.notification.message | default("") %}' }}
          {{ '{% set title = trigger.notification.title | default("") %}' }}
          {{ '{% if "Too many login attempts" in msg or "Banned" in msg %}' }}
          {{ '*IP BANNED*' }}
          {{ '{% elif "invalid authentication" in msg or "login attempt" in msg %}' }}
          {{ '*Failed Login Attempt*' }}
          {{ '{% else %}' }}
          {{ '*Security Event*' }}
          {{ '{% endif %}' }}
          
          {{ '{{ title }}' }}
          {{ '{{ msg }}' }}
  mode: queued
  max: 10

# ─── Shelly Gas detectors (mains-powered, always online) ───────────────────
# Life-safety: the detector's own siren is primary; Slack is the remote-warning
# layer. Critical events (alarm, sensor fault) -> slack_alert; the rest -> notify.
# Friendly name resolves to the HA Area if set (assign both units to an Area for
# clean messages), else falls back to the device's entity name.

- id: "shelly_gas_alarm"
  alias: "Shelly Gas - Alarm"
  trigger:
    - platform: state
      entity_id:
        - sensor.shellygas_8c4f0059f510_gas_detected
        - sensor.shellygas_8c4f0059fb5f_gas_detected
      to:
        - "mild"
        - "heavy"
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"🚨🔥 GAS ALARM — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Gas detected\", \"\"), true)) ~ \": \" ~ (trigger.to_state.state | upper) ~ \" (\" ~ states(trigger.entity_id | replace(\"_gas_detected\", \"_gas_concentration\")) ~ \" ppm)\" {{ '}}' }}"
  mode: parallel

- id: "shelly_gas_self_test"
  alias: "Shelly Gas - Self-test Running"
  trigger:
    - platform: state
      entity_id:
        - sensor.shellygas_8c4f0059f510_gas_detected
        - sensor.shellygas_8c4f0059fb5f_gas_detected
      to: "test"
  action:
    - service: rest_command.slack_notify
      data:
        message: "{{ '{{' }} \"🧪 Gas detector self-test running — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Gas detected\", \"\"), true)) {{ '}}' }}"
  mode: parallel

- id: "shelly_gas_cleared"
  alias: "Shelly Gas - Cleared"
  trigger:
    - platform: state
      entity_id:
        - sensor.shellygas_8c4f0059f510_gas_detected
        - sensor.shellygas_8c4f0059fb5f_gas_detected
      from:
        - "mild"
        - "heavy"
      to: "none"
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"✅ Gas cleared — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Gas detected\", \"\"), true)) {{ '}}' }}"
  mode: parallel

- id: "shelly_gas_fault"
  alias: "Shelly Gas - Sensor Fault or Offline"
  trigger:
    - platform: state
      entity_id:
        - sensor.shellygas_8c4f0059f510_operation
        - sensor.shellygas_8c4f0059fb5f_operation
      to:
        - "fault"
        - "unavailable"
      for:
        minutes: 5
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"⚠️ Gas detector FAULT/OFFLINE — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Operation\", \"\"), true)) ~ \" (state: \" ~ trigger.to_state.state ~ \")\" {{ '}}' }}"
  mode: parallel

- id: "shelly_gas_fault_recovery"
  alias: "Shelly Gas - Sensor Recovered"
  trigger:
    - platform: state
      entity_id:
        - sensor.shellygas_8c4f0059f510_operation
        - sensor.shellygas_8c4f0059fb5f_operation
      from:
        - "fault"
        - "unavailable"
      to: "normal"
  condition:
    # Mirror the FAULT automation's 5-min debounce: only announce recovery if the
    # sensor was genuinely unavailable/fault long enough to have raised a FAULT
    # alert. Suppresses phantom "back to normal" messages from brief CoIoT/Wi-Fi
    # poll blips and from HA restarts (where the prior-state duration is ~0).
    - condition: template
      value_template: "{{ '{{' }} trigger.from_state is not none and (trigger.to_state.last_changed - trigger.from_state.last_changed).total_seconds() >= 300 {{ '}}' }}"
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"✅ Gas detector back to normal — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Operation\", \"\"), true)) {{ '}}' }}"
  mode: parallel

# ─── Shelly Plus Smoke detector (battery-powered, sleeping device) ──────────
# Life-safety: the detector's own siren is primary; Slack is the remote layer.
# Alarm / cleared / low-battery / offline -> slack_alert; recovery -> notify.
# Test the alarm path by pressing the unit's physical test button (it drives
# the smoke binary_sensor "on", firing the alarm automation to #home-alerts).
# Offline uses a long (26h) debounce: this device only wakes to report
# periodically, so a short "unavailable" window is normal, not a fault.

- id: "shelly_smoke_alarm"
  alias: "Shelly Smoke - Alarm"
  trigger:
    - platform: state
      entity_id:
        - binary_sensor.shellyplussmoke_3076f523fd68_smoke
      to: "on"
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"🚨🔥 SMOKE ALARM — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Smoke\", \"\"), true)) {{ '}}' }}"
  mode: parallel

- id: "shelly_smoke_cleared"
  alias: "Shelly Smoke - Cleared"
  trigger:
    - platform: state
      entity_id:
        - binary_sensor.shellyplussmoke_3076f523fd68_smoke
      from: "on"
      to: "off"
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"✅ Smoke cleared — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Smoke\", \"\"), true)) {{ '}}' }}"
  mode: parallel

- id: "shelly_smoke_low_battery"
  alias: "Shelly Smoke - Low Battery"
  trigger:
    - platform: numeric_state
      entity_id:
        - sensor.shellyplussmoke_3076f523fd68_battery
      below: 15
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"🪫 Smoke detector low battery — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Battery\", \"\"), true)) ~ \": \" ~ trigger.to_state.state ~ \"%\" {{ '}}' }}"
  mode: parallel

- id: "shelly_smoke_offline"
  alias: "Shelly Smoke - Offline (not reporting)"
  trigger:
    - platform: state
      entity_id:
        - binary_sensor.shellyplussmoke_3076f523fd68_smoke
      to: "unavailable"
      for:
        hours: 26
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"⚠️ Smoke detector OFFLINE (not reporting) — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Smoke\", \"\"), true)) {{ '}}' }}"
  mode: parallel

- id: "shelly_smoke_online_recovery"
  alias: "Shelly Smoke - Back Online"
  trigger:
    - platform: state
      entity_id:
        - binary_sensor.shellyplussmoke_3076f523fd68_smoke
      from: "unavailable"
  action:
    - service: rest_command.slack_notify
      data:
        message: "{{ '{{' }} \"✅ Smoke detector back online — \" ~ (area_name(trigger.entity_id) | default(trigger.to_state.attributes.friendly_name | replace(\" Smoke\", \"\"), true)) {{ '}}' }}"
  mode: parallel

# ── Amp power control ──────────────────────────────────────────────────────────
# Drive the Pioneer's Shelly plug from source activity. binary_sensor.amp_source_active
# is the OR of all inputs (hifipi AirPlay/Spotify/MPD playing, or the TV powered on).
# Input selection (TV vs Pi) is handled by "Amp - select input" below, keyed off
# sensor.amp_active_source.
- id: "amp_power_on"
  alias: "Amp - power on when a source is active"
  trigger:
    - platform: state
      entity_id: binary_sensor.amp_source_active
      to: "on"
  condition:
    - condition: state
      entity_id: switch.living_room_shellyplugsg3_pioneer
      state: "off"
  action:
    - service: switch.turn_on
      target:
        entity_id: switch.living_room_shellyplugsg3_pioneer
  mode: single

# 5-minute grace so brief gaps (track changes, short TV pauses) don't cut the amp.
- id: "amp_power_off"
  alias: "Amp - power off when idle"
  trigger:
    - platform: state
      entity_id: binary_sensor.amp_source_active
      to: "off"
      for:
        minutes: 5
  condition:
    - condition: state
      entity_id: switch.living_room_shellyplugsg3_pioneer
      state: "on"
  action:
    - service: switch.turn_off
      target:
        entity_id: switch.living_room_shellyplugsg3_pioneer
  mode: single

# After an HA restart, triggers don't fire for the startup state-settle, so the
# plug can be left out of sync with the sources. Reconcile once entities have
# reconnected (~30s covers MQTT/androidtv/MPD coming back).
- id: "amp_reconcile_on_start"
  alias: "Amp - reconcile plug on HA start"
  trigger:
    - platform: homeassistant
      event: start
  action:
    - delay: "00:00:30"
    - if:
        - condition: state
          entity_id: binary_sensor.amp_source_active
          state: "on"
      then:
        - service: switch.turn_on
          target:
            entity_id: switch.living_room_shellyplugsg3_pioneer
      else:
        - service: switch.turn_off
          target:
            entity_id: switch.living_room_shellyplugsg3_pioneer
  mode: single

# Feed the amp the active source: the RM4 Mini IR blaster drives the 4-way RCA
# switch sitting in front of the amp's single input. Positions learned on the
# blaster: rca_switcher/input_pi and rca_switcher/input_tv (seed copy of the
# learned codes lives in roles/services/homeassistant/files/). The second
# trigger covers power-on: while the plug is off, source changes are skipped by
# the condition, so re-align the switch the moment the amp comes on. The 3s
# debounce keeps a brief source flip (e.g. a short playback gap with the TV on)
# from thrashing the switch; power-on alignment stays instant.
- id: "amp_input_select"
  alias: "Amp - select input for active source"
  trigger:
    - platform: state
      entity_id: sensor.amp_active_source
      to:
        - "pi"
        - "tv"
      for:
        seconds: 3
    - platform: state
      entity_id: switch.living_room_shellyplugsg3_pioneer
      to: "on"
  condition:
    - condition: state
      entity_id: switch.living_room_shellyplugsg3_pioneer
      state: "on"
    - condition: template
      value_template: "{{ '{{' }} states('sensor.amp_active_source') in ['pi', 'tv'] {{ '}}' }}"
  action:
    - service: remote.send_command
      target:
        entity_id: remote.rm4_mini_ir_blaster
      data:
        device: rca_switcher
        command: "{{ '{{' }} 'input_' ~ states('sensor.amp_active_source') {{ '}}' }}"
  mode: restart

# Watchdog: the amp-on trigger is deliberately instant (phantom-start debounce
# lives in detect_audio on vinylstreamer), so if the detector ever regresses the
# plug cycles again. Page on abnormal cycling instead of delaying the amp.
- id: "amp_plug_cycling_watchdog"
  alias: "Amp - alert on plug cycling"
  trigger:
    - platform: numeric_state
      entity_id: sensor.amp_plug_on_count_1h
      above: 3
  action:
    - service: rest_command.slack_alert
      data:
        message: "{{ '{{' }} \"🔌 Amp plug cycling: switched on \" ~ states(\"sensor.amp_plug_on_count_1h\") ~ \" times in the last hour — check detect_audio on vinylstreamer for phantom starts\" {{ '}}' }}"
  mode: single
{% if enable_vinylstreamer_watchdog | default(false) %}

# ── vinylstreamer wifi-lockout watchdog ────────────────────────────────────────
# vinylstreamer stays UP and healthy but falls off the network: NetworkManager
# reaches `failed (reason 'no-secrets')` after 4 retries and then emits nothing
# at all — measured silent for 3.6 days, 09–13 Aug 2026. Only a power cycle has
# ever brought it back, and Ignacio had been doing that by hand from the Shelly
# app. These three automations take that over.
#
# 🔴 READ THIS BEFORE TRUSTING IT. A power cycle is remediation, not a diagnosis,
# and an auto-remediation that works quietly is indistinguishable from a fault
# that went away. So the design deliberately makes it LOUD:
#
#   * every outage reaches #home-alerts (slack_alert), including — especially —
#     the outages this automation decides NOT to act on. Since 2026-08-23 the
#     automation also re-checks every {{ vinylstreamer_down_after_minutes }} min
#     while the host stays down; those repeats go to #home-logging rather than
#     the watched channel, so one outage still pages once per *decision*, not
#     once per check;
#   * a recovery says whether a power cycle was involved or whether the host came
#     back on its own, because "it fixed itself" is the single most useful data
#     point W1 is missing;
#   * a failed power cycle is its own, louder alert;
#   * and sensor.vinylstreamer_plug_cycles_7d meters the crutch, escalating
#     when the plug stops being a safety net.
#
# The root cause stays open as W1 (NetworkManager autoconnect-retries, powersave,
# and signal 52/100). See docs/TODO.md and the L-I plan file.

- id: "vinylstreamer_offline_power_cycle"
  alias: "Vinylstreamer - offline, power cycle the plug"
  trigger:
    # The outage itself. Fires once, on the transition into "off".
    - platform: state
      id: went_offline
      entity_id: binary_sensor.vinylstreamer_online
      to: "off"
      for:
        minutes: {{ vinylstreamer_down_after_minutes }}
    # 🔴 The re-arm, added 2026-08-23. WITHOUT THIS THE COOLDOWN CANCELS A CYCLE
    # INSTEAD OF POSTPONING IT, and the host stays down forever.
    #
    # Measured on 2026-08-23: the host dropped at 01:58:06, this automation
    # fired correctly at 02:13:06, and branch 3 refused because a cycle had run
    # 29 min earlier (01:44:06). The cooldown expired at 07:44 with the host
    # still down — and nothing re-evaluated, because a state trigger needs a
    # *transition* and the sensor never left "off". Net result: eligible but
    # untried for 8 h, until a human noticed at ~10:50.
    #
    # `vinylstreamer_cycle_cooldown_hours` was always meant as a rate limit
    # ("at most one cycle per 6 h"), not a veto ("at most one cycle per
    # outage, and none if the outage began inside the window"). This trigger
    # makes the config mean what it says.
    - platform: time_pattern
      id: still_offline
      minutes: "/{{ vinylstreamer_down_after_minutes }}"
  # The original design had NO `condition:` block, so that every outage posted
  # and a held guard could never be mistaken for a broken trigger. That property
  # is preserved: `went_offline` is unconditional exactly as before. The guard
  # applies only to the new periodic trigger, which would otherwise run against
  # a perfectly healthy host every {{ vinylstreamer_down_after_minutes }} min.
  condition:
    - condition: or
      conditions:
        - condition: trigger
          id: went_offline
        - condition: state
          entity_id: binary_sensor.vinylstreamer_online
          state: "off"
          for:
            minutes: {{ vinylstreamer_down_after_minutes }}
  action:
    - choose:
        # 1. The plug is unreachable too, so power or the network is out at the
        #    outlet — not a vinylstreamer fault. The whole fleet has gone dark on
        #    external power at least twice; cycling into the tail of one of those
        #    is exactly the wrong reflex. The plug is the witness precisely
        #    because it shares the socket and the VLAN with the host it feeds.
        - conditions:
            - condition: or
              conditions:
                - condition: state
                  entity_id: {{ vinylstreamer_plug_entity }}
                  state: "unavailable"
                - condition: state
                  entity_id: {{ vinylstreamer_plug_entity }}
                  state: "unknown"
          sequence:
            # First sighting pages; the periodic re-checks trace quietly. Same
            # reasoning as the cooldown branch below.
            - choose:
                - conditions:
                    - condition: trigger
                      id: went_offline
                  sequence:
                    - service: rest_command.slack_alert
                      data:
                        message: >-
                          ⚠️ vinylstreamer offline {{ vinylstreamer_down_after_minutes }} min — and its plug is
                          unreachable as well, so this looks like a site-wide power or network event
                          rather than the wifi lockout. NOT power-cycling.
              default:
                - service: rest_command.slack_notify
                  data:
                    message: >-
                      ⏳ vinylstreamer still offline and its plug is still unreachable — still treating
                      this as a site-wide event, not the wifi lockout. NOT power-cycling.

        # 2. The plug is off. The host being down is already explained, and
        #    someone switched it off on purpose. Report it; do not override it.
        - conditions:
            - condition: state
              entity_id: {{ vinylstreamer_plug_entity }}
              state: "off"
          sequence:
            # First sighting pages; the periodic re-checks trace quietly. A plug
            # switched off by hand is a standing decision, not a new event.
            - choose:
                - conditions:
                    - condition: trigger
                      id: went_offline
                  sequence:
                    - service: rest_command.slack_alert
                      data:
                        message: >-
                          ⚠️ vinylstreamer offline {{ vinylstreamer_down_after_minutes }} min — its plug is
                          switched OFF, which explains it. Assuming that was deliberate: NOT switching it
                          back on. Turn the plug on to bring the host back.
              default:
                - service: rest_command.slack_notify
                  data:
                    message: >-
                      ⏳ vinylstreamer still offline with its plug still switched OFF — still assuming
                      that is deliberate. Turn the plug on to bring the host back.

        # 3. Rate limit. A plug that reboots a Pi in a loop is a worse failure
        #    than the one it fixes — but silence here would be the plug hiding a
        #    fault it cannot fix, which is the failure mode this whole design is
        #    built against. So this branch is the LOUDEST of the four.
        - conditions:
            - condition: template
              value_template: "{{ '{{' }} now().timestamp() - (state_attr(\"input_datetime.vinylstreamer_last_power_cycle\", \"timestamp\") | default(0, true)) < {{ vinylstreamer_cycle_cooldown_hours * 3600 }} {{ '}}' }}"
          sequence:
            # The FIRST refusal pages, exactly as before. The periodic re-checks
            # that follow do not — a 6 h cooldown re-checked every
            # {{ vinylstreamer_down_after_minutes }} min would post
            # {{ (vinylstreamer_cycle_cooldown_hours * 60 / vinylstreamer_down_after_minutes) | int }}
            # times per outage to the watched channel, which is how a channel
            # stops being read. They still post to #home-logging, so "the guard
            # is holding" stays visible and never looks like a dead trigger.
            - choose:
                - conditions:
                    - condition: trigger
                      id: went_offline
                  sequence:
                    - service: rest_command.slack_alert
                      data:
                        message: >-
                          🔴 vinylstreamer STILL offline, and it was already power-cycled at
                          {{ '{{ states("input_datetime.vinylstreamer_last_power_cycle") }}' }} —
                          inside the {{ vinylstreamer_cycle_cooldown_hours }}h cooldown, so NOT cycling
                          yet. Retrying automatically the moment the cooldown expires.
              default:
                - service: rest_command.slack_notify
                  data:
                    message: >-
                      ⏳ vinylstreamer still offline; last cycle
                      {{ '{{ states("input_datetime.vinylstreamer_last_power_cycle") }}' }},
                      still inside the {{ vinylstreamer_cycle_cooldown_hours }}h cooldown. Will cycle
                      when it expires.

      # 4. The real thing.
      default:
        # Stamp the clock FIRST: if anything below fails, the rate limit must
        # still hold, or a broken cycle becomes a reboot loop.
        - service: input_datetime.set_datetime
          target:
            entity_id: input_datetime.vinylstreamer_last_power_cycle
          data:
            timestamp: "{{ '{{ now().timestamp() }}' }}"
        - service: rest_command.slack_alert
          data:
            message: >-
              🔌 vinylstreamer offline {{ vinylstreamer_down_after_minutes }} min — power-cycling its
              plug ({{ vinylstreamer_power_cycle_seconds }}s off). Cycles in the 7 days before this one:
              {{ '{{ states("sensor.vinylstreamer_plug_cycles_7d") }}' }}.
              This is remediation, not a fix — the root cause is still open as W1.
        - service: switch.turn_off
          target:
            entity_id: {{ vinylstreamer_plug_entity }}
        - delay:
            seconds: {{ vinylstreamer_power_cycle_seconds }}
        - service: switch.turn_on
          target:
            entity_id: {{ vinylstreamer_plug_entity }}
        # Success is announced by "back online" below, so only report the
        # failure here — otherwise a working recovery pages twice.
        #
        # A flat delay-then-look, deliberately not wait_for_trigger. The probe
        # runs once a minute and the host is only unreachable for ~105 s (15 s
        # cut + ~90 s boot), so the sensor may never record an off->on
        # transition at all — and wait_for_trigger waits for a transition, not
        # a state. It would then time out on a host that had recovered fine and
        # page a false "did NOT come back". Reading the state after a fixed
        # settle cannot make that mistake in either direction.
        - delay: "00:05:00"
        - if:
            - condition: state
              entity_id: binary_sensor.vinylstreamer_online
              state: "off"
          then:
            - service: rest_command.slack_alert
              data:
                message: >-
                  🔴 vinylstreamer did NOT come back within 6 min of its power cycle. The plug did
                  its job and the host is still gone, so this is not the wifi lockout. Needs a human.
  mode: single

- id: "vinylstreamer_offline_stamp"
  alias: "Vinylstreamer - stamp when the outage started"
  # Fires immediately, with no `for:` — this records WHEN the host dropped, not
  # whether the drop is worth acting on. The 15-minute judgement stays in the
  # power-cycle automation.
  #
  # 🔴 `from: "on"` is load-bearing. Without it an HA restart, which walks every
  # entity through unavailable -> off, would re-stamp mid-outage and destroy the
  # very number this exists to preserve — reintroducing the bug in a new place.
  trigger:
    - platform: state
      entity_id: binary_sensor.vinylstreamer_online
      from: "on"
      to: "off"
  action:
    - service: input_datetime.set_datetime
      target:
        entity_id: input_datetime.vinylstreamer_offline_since
      data:
        timestamp: "{{ '{{ now().timestamp() }}' }}"
  mode: single

- id: "vinylstreamer_back_online"
  alias: "Vinylstreamer - back online"
  trigger:
    - platform: state
      entity_id: binary_sensor.vinylstreamer_online
      from: "off"
      to: "on"
  condition:
    # Only announce outages long enough to have been reported. Mirrors the gas
    # detector's recovery debounce: suppresses HA-restart artefacts and short
    # probe blips.
    #
    # 🔴 Measured from input_datetime.vinylstreamer_offline_since, NOT from the
    # sensor's last_changed. An HA restart re-creates the entity and resets
    # last_changed, which broke this in BOTH directions: on 2026-08-23 a
    # 22-hour outage was announced as "22 min" (restart at 23:24, recovery at
    # 23:46), and a recovery landing <15 min after a restart would have been
    # suppressed entirely — a real outage ending with total silence.
    #
    # Falls back to the old comparison when the stamp is missing (first deploy,
    # or an outage that began before this automation existed), so the worst case
    # is the previous behaviour rather than no message at all.
    - condition: template
      value_template: >-
        {{ '{%' }} set raw = state_attr("input_datetime.vinylstreamer_offline_since", "timestamp") {{ '%}' }}
        {{ '{%' }} set t = raw if raw and raw > 946684800 else none {{ '%}' }}
        {{ '{%' }} set fallback = (trigger.to_state.last_changed - trigger.from_state.last_changed).total_seconds()
           if trigger.from_state is not none else 0 {{ '%}' }}
        {{ '{{' }} (now().timestamp() - t if t else fallback) >= {{ vinylstreamer_down_after_minutes * 60 }} {{ '}}' }}
  action:
    # The self-recovery case is the point of this message. If vinylstreamer comes
    # back WITHOUT a power cycle, that contradicts the "NetworkManager gives up
    # permanently" model in W1 — and it is the measurement W1 is missing.
    #
    # 🔴 Judged from a count of real cuts, NOT from
    # input_datetime.vinylstreamer_last_power_cycle and NOT from the plug's
    # last_changed. Both were tried on 2026-08-16 and both are wrong:
    #   * the input_datetime records only cycles *this automation* performed, so
    #     a cycle Ignacio does by hand from the Shelly app — precisely the thing
    #     being automated, done on 13 and 15 Aug — reads as "recovered on its
    #     own". Observed live: the test recovery at 10:54 said exactly that.
    #   * the plug's last_changed is reset by the Shelly's `unavailable -> on`
    #     reconnect blips and by every HA restart — measured at 12 s old
    #     immediately after a deploy, with no cut anywhere near it.
    # sensor.vinylstreamer_plug_cuts_10m counts entries into "off", which only a
    # genuine cut produces. This is the sentence that tells W1 whether the fault
    # can clear itself, so it has to be right.
    - service: rest_command.slack_alert
      data:
        message: >-
          ✅ vinylstreamer back online after
          {{ '{%' }} set raw = state_attr("input_datetime.vinylstreamer_offline_since", "timestamp") {{ '%}' }}
          {{ '{%' }} set t = raw if raw and raw > 946684800 else none {{ '%}' }}
          {{ '{%' }} set secs = (now().timestamp() - t) if t
             else (trigger.to_state.last_changed - trigger.from_state.last_changed).total_seconds() {{ '%}' }}
          {{ '{{' }} (secs / 3600) | round(1) ~ " h" if secs >= 3600 else (secs / 60) | round(0) | int ~ " min" {{ '}}' }}
          offline.
          {{ '{{ "Recovered after a power cycle (automatic or by hand)." if states("sensor.vinylstreamer_plug_cuts_10m") | int(0) > 0 else "Recovered on its own, with NO power cycle — record this against W1." }}' }}
  mode: single

- id: "vinylstreamer_cycles_escalation"
  alias: "Vinylstreamer - power cycles are masking a fault"
  trigger:
    - platform: numeric_state
      entity_id: sensor.vinylstreamer_plug_cycles_7d
      above: {{ vinylstreamer_cycles_7d_escalate }}
  action:
    - service: rest_command.slack_alert
      data:
        message: >-
          🔁 vinylstreamer has needed
          {{ '{{ states("sensor.vinylstreamer_plug_cycles_7d") }}' }}
          power cycles in the last 7 days (threshold {{ vinylstreamer_cycles_7d_escalate }}). The plug
          has stopped being a safety net and started being a crutch — it is now hiding a worsening
          fault. Escalate to the root cause: W1 in docs/TODO.md (NetworkManager autoconnect-retries,
          brcmfmac powersave, and signal 52/100).
  mode: single
{% endif %}
