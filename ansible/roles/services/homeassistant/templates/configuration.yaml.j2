# Home Assistant Configuration
# Managed by Ansible - Manual changes will be overwritten

# Core configuration
homeassistant:
  external_url: "{{ homeassistant_external_url | default('http://homeassistant.local:8123') }}"
  internal_url: "http://localhost:8123"
  customize:
    climate.tado_smart_thermostat_ru3393984256:
      friendly_name: "Living Room Thermostat"
    climate.tado_smart_radiator_thermostat_va1065432832:
      friendly_name: "Living Room Radiator 1"
    climate.tado_smart_radiator_thermostat_va2323724032:
      friendly_name: "Living Room Radiator 2"
    climate.tado_smart_thermostat_su3182126080:
      friendly_name: "Master Bedroom Thermostat"
    climate.tado_smart_radiator_thermostat_va0290656256:
      friendly_name: "Master Bedroom Radiator"
    climate.tado_smart_radiator_thermostat_va2220036096:
      friendly_name: "Office Radiator"
    climate.tado_smart_radiator_thermostat_va3363583744:
      friendly_name: "Hallway Radiator"
    climate.tado_smart_radiator_thermostat_va0612513536:
      friendly_name: "Bathroom Radiator"

# Loads default set of integrations. Do not remove.
default_config:

# Load frontend themes from the themes folder
frontend:
  themes: !include_dir_merge_named themes

# Text-to-speech
tts:
  - platform: google_translate

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

#### Manual configs from this point
group: !include groups.yaml

{% if homeassistant_lights | default([]) | length > 0 %}
# Light Groups
light:
  - platform: group
    name: All lights
    entities:
{% for light in homeassistant_lights %}
      - {{ light }}
{% endfor %}
{% endif %}

# Logger configuration
logger:
  default: warning

# Input Select
input_select:
  tado_mode:
    name: Tado Mode
    options:
      - Home
      - Away
    initial: Home
    icon: mdi:home-thermometer

# Input Booleans
input_boolean:
  guest_mode:
    name: Guest Mode
    icon: mdi:account-multiple
  train_notified_today:
    name: Train Notification Sent Today
    icon: mdi:train
{% if enable_vinylstreamer_watchdog | default(false) %}

# Input Datetimes
input_datetime:
  # Rate-limit clock for the vinylstreamer power cycle. Deliberately NOT
  # automation.last_triggered: the automation runs (and posts) on every outage,
  # including the ones it refuses to act on, so last_triggered would advance
  # without a cycle having happened and the rate limit would never expire.
  # This is written only by the branch that actually cuts power.
  vinylstreamer_last_power_cycle:
    name: Vinylstreamer Last Power Cycle
    has_date: true
    has_time: true
    icon: mdi:restart-alert

  # When the host actually went off the network. NOT derivable from the
  # sensor's own last_changed, which is what the recovery message used until
  # 2026-08-24: an HA restart re-creates the entity and resets last_changed, so
  # a 22-HOUR outage that spanned the 23:24 restart was reported as "22 min".
  # An input_datetime survives restarts, so it measures the outage rather than
  # the uptime of the thing watching it.
  #
  # It is stamped only on a genuine on -> off edge, never on unavailable -> off,
  # so a restart during an outage cannot overwrite the real start time.
  vinylstreamer_offline_since:
    name: Vinylstreamer Offline Since
    has_date: true
    has_time: true
    icon: mdi:lan-disconnect
    # 🔴 An unset input_datetime does NOT read as null — it defaults to TODAY AT
    # MIDNIGHT, which is a perfectly valid timestamp. Without this sentinel the
    # "have we ever stamped?" test passes on a value nobody wrote, and the first
    # recovery after a fresh deploy reports the time since midnight as the
    # outage length (measured: 21.8 h). That is the same class of confidently
    # wrong number this entity exists to eliminate, so it gets an epoch value
    # that no real outage can produce, and the templates treat pre-2000 as
    # "never stamped".
    initial: "1970-01-01 00:00:00"
{% endif %}

# Template sensors (modern syntax)
template:
  - binary_sensor:
      # Presence detection
      - name: "Home Occupied"
        unique_id: home_occupied
        device_class: occupancy
        state: >
          {{ '{{ is_state("group.persons", "home") }}' }}
        icon: >
          {{ '{% if is_state("group.persons", "home") %}' }}
            mdi:home-account
          {{ '{% else %}' }}
            mdi:home-outline
          {{ '{% endif %}' }}
      
      # Primary user presence (Companion App device tracker)
      - name: "{{ ha_primary_person_display | default('Primary') }} Presence"
        unique_id: "{{ ha_primary_person_display | default('primary') | lower }}_presence_combined"
        device_class: presence
        state: '{{ "{{ is_state(\"" }}{{ ha_primary_device_tracker | default("device_tracker.phone") }}{{ "\", \"home\") }}" }}'

      # Secondary user presence (Companion App device tracker)
      - name: "{{ ha_secondary_person_display | default('Secondary') }} Presence"
        unique_id: "{{ ha_secondary_person_display | default('secondary') | lower }}_presence_combined"
        device_class: presence
        state: '{{ "{{ is_state(\"" }}{{ ha_secondary_device_tracker | default("device_tracker.phone_secondary") }}{{ "\", \"home\") }}" }}'

      # Amp power control — is any source feeding the Pioneer? OR of every input:
      # hifipi AirPlay/Spotify/MPD actively playing, vinyl detected on the
      # turntable (MQTT push from vinylstreamer — instant, unlike the ~10s MPD
      # poll that also covers the same playback), or the TV powered on. Drives
      # the Shelly plug (switch.living_room_shellyplugsg3_pioneer) via automations.
      - name: "Amp Source Active"
        unique_id: amp_source_active
        device_class: running
        state: >
          {{ '{{ is_state("binary_sensor.shairport_sync_hifipi_playing", "on") or is_state("binary_sensor.raspotify_hifipi_playing", "on") or is_state("binary_sensor.vinyl_vinylstreamer_playing", "on") or is_state("media_player.music_player_daemon", "playing") or is_state("media_player.cobi_tv_3", "on") }}' }}
  - sensor:
      # Amp input selection — which source the RM4 IR blaster should select on the
      # 4-way RCA switch (consumed by the "Amp - select input" automation).
      # Active Pi playback wins over a merely powered-on TV. Values: pi / tv / none.
      - name: "Amp Active Source"
        unique_id: amp_active_source
        state: >
          {{ '{% if is_state("binary_sensor.shairport_sync_hifipi_playing", "on") or is_state("binary_sensor.raspotify_hifipi_playing", "on") or is_state("binary_sensor.vinyl_vinylstreamer_playing", "on") or is_state("media_player.music_player_daemon", "playing") %}pi{% elif is_state("media_player.cobi_tv_3", "on") %}tv{% else %}none{% endif %}' }}

# Amp plug cycling watchdog input — how many times the plug switched ON in the
# last rolling hour. Phantom-start debounce lives in detect_audio on vinylstreamer
# (the only place that sees the raw signal); the amp-on automation is deliberately
# instant, so this counter is the safety net that pages instead of adding delay.
sensor:
  - platform: history_stats
    name: "Amp Plug On Count 1h"
    entity_id: switch.living_room_shellyplugsg3_pioneer
    state: "on"
    type: count
    duration: "01:00:00"
    end: "{{ '{{ now() }}' }}"
{% if enable_vinylstreamer_watchdog | default(false) %}
  # Power cycles in the last 7 days — the anti-masking meter. The escalation
  # automation trips on this, so an auto-recovery that starts firing weekly
  # reports itself instead of quietly papering over a worsening radio.
  #
  # 🔴 Counts transitions to "off", NOT to "on", and the difference is the whole
  # measurement. history_stats `count` counts entries into the given state from
  # ANY state, including `unavailable`. Measured on this very plug 2026-08-16:
  # 8 transitions to "on" in 7 days, of which 8 were `unavailable -> on` — Shelly
  # wifi/integration blips, three of them inside six minutes — and ZERO were a
  # power cycle. Counting "on" would have made this meter read 7 on the day it
  # was installed and escalate on a plug that had never once been switched off.
  # The plug is energised permanently, so an entry into "off" is a deliberate cut
  # and nothing else: this automation, or Ignacio from the Shelly app. Both count,
  # which is the point — the human doing it by hand is the fault recurring too.
  # 7 days is inside the recorder's default 10-day purge window.
  - platform: history_stats
    name: "Vinylstreamer Plug Cycles 7d"
    entity_id: {{ vinylstreamer_plug_entity }}
    state: "off"
    type: count
    duration:
      days: 7
    end: "{{ '{{ now() }}' }}"
  # Same measurement over a short window, used by the recovery message to say
  # whether the host was brought back by a power cut or came back by itself.
  # It cannot be `states.<plug>.last_changed`: that is reset by the Shelly's
  # `unavailable -> on` reconnect blips (8 in 7 days, measured) AND by every HA
  # restart — observed reading 12 s old immediately after a deploy. Either would
  # report a self-recovery as "the plug fixed it", corrupting the one data point
  # W1 is missing. An entry into "off" is only ever a real cut.
  - platform: history_stats
    name: "Vinylstreamer Plug Cuts 10m"
    entity_id: {{ vinylstreamer_plug_entity }}
    state: "off"
    type: count
    duration:
      minutes: 10
    end: "{{ '{{ now() }}' }}"
{% endif %}
{% if enable_vinylstreamer_watchdog | default(false) %}

# vinylstreamer liveness — the ONLY external detection this host has. Everything
# else about it is self-reported, and this fault takes the host off the network,
# so the host itself can never report it (docs/TODO.md, L-I §3).
#
# command_line, not the `ping` integration: ping became a config-entry-only
# integration and would live in .storage where the repo cannot manage it, and
# it does not give us the multi-packet probe. `-c 3` matters — a single ICMP
# sample is what produced vinylstreamer's false "Internet: unreachable" on
# 2026-08-13. Verified in the container 2026-08-16: /bin/ping is busybox,
# live host -> ON rc=0 in 2 s, dead host -> OFF rc=1 in 4 s.
command_line:
  - binary_sensor:
      name: "Vinylstreamer Online"
      unique_id: vinylstreamer_online
      command: "ping -c 3 -W 2 {{ vinylstreamer_ip }} >/dev/null 2>&1 && echo ON || echo OFF"
      payload_on: "ON"
      payload_off: "OFF"
      device_class: connectivity
      scan_interval: 60
      # 4 s measured worst case; 20 s leaves room without stacking probes.
      command_timeout: 20
{% endif %}

# MQTT entities — Raspotify (Spotify Connect) now-playing state from hifipi.
# shairport-sync publishes its own entities via MQTT autodiscovery; librespot
# has no discovery, so its play/stop state is defined explicitly here.
mqtt:
  binary_sensor:
    # Vinyl playback detected on the turntable — pushed by detect_audio on
    # vinylstreamer the moment sustained signal is confirmed. Feeds
    # amp_source_active so the plug reacts instantly (the MPD entity covers
    # the same playback but only via ~10s polling).
    - name: "Playing"
      unique_id: vinyl_vinylstreamer_playing
      state_topic: "vinyl/vinylstreamer/playing"
      payload_on: "1"
      payload_off: "0"
      device_class: running
      icon: mdi:record-player
      device:
        identifiers: ["vinyl_vinylstreamer"]
        name: "Vinyl (vinylstreamer)"
        manufacturer: "detect_audio"
        model: "Turntable stream"
    - name: "Playing"
      unique_id: raspotify_hifipi_playing
      state_topic: "{{ raspotify_mqtt_base_topic | default('raspotify/hifipi') }}/playing"
      payload_on: "1"
      payload_off: "0"
      device_class: running
      icon: mdi:spotify
      device:
        identifiers: ["raspotify_hifipi"]
        name: "Raspotify (hifipi)"
        manufacturer: "librespot"
        model: "Spotify Connect"
  sensor:
    - name: "State"
      unique_id: raspotify_hifipi_state
      state_topic: "{{ raspotify_mqtt_base_topic | default('raspotify/hifipi') }}/state"
      icon: mdi:spotify
      device:
        identifiers: ["raspotify_hifipi"]
        name: "Raspotify (hifipi)"
        manufacturer: "librespot"
        model: "Spotify Connect"

# Slack notifications (webhooks stored in secrets.yaml)
rest_command:
  slack_notify:
    url: !secret slack_log_webhook
    method: post
    headers:
      Content-Type: application/json
    payload: >
      {
        "text": "{{ '{{ message }}' }}"
      }
  slack_alert:
    url: !secret slack_alert_webhook
    method: post
    headers:
      Content-Type: application/json
    payload: >
      {
        "text": "{{ '{{ message }}' }}"
      }

# HTTP configuration for reverse proxy (Cloudflare Tunnel)
http:
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1
    - ::1
  ip_ban_enabled: true
  login_attempts_threshold: 5

# Shell commands
shell_command:
  notify_train_platform: '/config/scripts/notify_train_platform.sh'
  tado_set_away: '/config/scripts/tado_presence.sh AWAY'
  tado_set_home: '/config/scripts/tado_presence.sh HOME'
