# Unattended builder — PER-85 part 2
# Managed by Ansible (roles/services/workbench). Do not edit on the host.

[Unit]
Description=Fleet builder poll (PER-85)

[Timer]
OnCalendar={{ builder_timer_oncalendar }}
# A missed tick is not caught up: the next one reads the same queue.
Persistent=false

[Install]
WantedBy=timers.target
