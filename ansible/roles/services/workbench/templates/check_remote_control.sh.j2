#!/bin/sh
# Is the Remote Control session actually up? — PER-66
#
# Managed by Ansible (roles/services/workbench). Do not edit on the host.
#
# A workbench that is reachable but has no agent running on it is useless in
# exactly the way that is hardest to notice: the box pings, the container runs,
# every existing fleet check stays green, and the phone simply finds nothing to
# talk to. agent-lxc already demonstrated the shape of this failure by going
# quiet for 12 days behind healthy-looking infrastructure.
#
# So this deliberately does NOT ask "is the host up" or "is the unit enabled".
# systemd can report a service active while the process inside tmux has died,
# and an enabled unit says nothing about whether it is running right now. It
# asks the only question worth asking: is there a live claude process attached
# to the session the phone drives?
#
# Exit 0 = up. Exit 1 = down, and enhanced_monitoring_wrapper turns that into
# a #home-alerts page.

set -u

SESSION="{{ workbench_tmux_session }}"
AGENT_USER="{{ workbench_agent_user }}"

fail() {
    echo "CRITICAL: $1"
    exit 1
}

command -v tmux >/dev/null 2>&1 || fail "tmux is not installed — the workbench cannot host a session at all"

# Asked with pgrep rather than `tmux has-session`, and that is not a stylistic
# choice: tmux talks to a per-user socket, so answering it for another account
# means `su`, and this cron runs as the unprivileged infrastructure user. `su`
# would prompt for a password, fail every time, and report the workbench down
# whether or not it was — a check that always fails teaches nothing, exactly
# like one that always passes.
#
# Matched with -f against the argv, NOT `-x tmux`. The tmux server renames
# itself to `tmux: server`, so an exact-name match never hits it: the first
# version of this check reported CRITICAL against a container where Remote
# Control was demonstrably running. Caught by running the healthy path by hand
# before this got a cron, which is the only reason it did not page.
if ! pgrep -u "$AGENT_USER" -f "tmux.*-s $SESSION" >/dev/null 2>&1; then
    fail "no tmux server hosting session '$SESSION' as $AGENT_USER"
fi

# The half that matters. Match the process by its own command line rather than
# by asking systemd or tmux whether they think it is fine: a pane whose command
# exited leaves the session alive and empty, which is precisely the state that
# would otherwise read as healthy.
#
# pgrep -f matches against the full argv, and -u scopes it to the agent account
# so a lookalike running as anyone else cannot satisfy the check.
#
# Scoped to AGENT_USER, not `id -u`: this check is run by cron as the
# infrastructure user, because that is where this repo's monitoring lives. The
# process it is looking for belongs to a different account entirely, so asking
# about the caller's uid would look in the wrong place and report healthy only
# when the answer was already wrong.
# `-x claude` matches the process name exactly, deliberately not
# `-f 'claude.*--remote-control'`. The tmux server's own argv contains the
# claude command it was asked to run, so an argv match reports the agent alive
# whenever tmux is — and would read healthy against a session whose pane had
# exited. It happens that tmux dies with its last pane here, so the two agree
# today; relying on that is relying on a coincidence rather than on the check.
if ! pgrep -u "$AGENT_USER" -x claude >/dev/null 2>&1; then
    fail "tmux session '$SESSION' is alive but no 'claude --remote-control' process is running in it"
fi

# Report the pid so the log line is worth reading when this is green — a check
# whose success output is just "OK" teaches nothing when you go back to it.
PID="$(pgrep -u "$AGENT_USER" -x claude | head -1)"
echo "OK: Remote Control up in tmux session '$SESSION' (pid $PID)"
exit 0
