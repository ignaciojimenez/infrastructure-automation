# Managed by Ansible — do not edit manually
#
# Fleet access for the Tier 1 sweep. Mirrors the laptop's `*-agent` pattern,
# but with explicit per-host blocks rather than the laptop's ProxyCommand
# trick: HostName is the fully qualified <host>.{{ fleet_dns_domain }}, resolved
# by Unbound on the gateway, so no netcat hop is needed and nothing depends on
# the container's search domain.

Host {% for h in agent_fleet_hosts %}{{ h.name }}-agent {% endfor %}

    User {{ agent_access_user | default('read_agent') }}
    IdentityFile {{ agent_ssh_key_path }}
    IdentitiesOnly yes
    IdentityAgent none
    BatchMode yes
    ControlPath none
    ConnectTimeout {{ agent_ssh_timeout }}
    StrictHostKeyChecking accept-new

# HostKeyAlias pins each host key to the host's DNS name, not to whatever
# HostName is. known_hosts is keyed by HostName, so without it a domain change
# looks like a never-seen host and accept-new silently trusts whoever answers
# first — and the domain is fed by DHCP registrations, not hand-set records.
# The DNS name is `dns_name` when the host has one (group_vars/agent.yml), so
# renaming an entry to its hostname keeps the key already pinned.
{% for h in agent_fleet_hosts %}
Host {{ h.name }}-agent
    HostName {{ h.dns_name | default(h.name) }}.{{ fleet_dns_domain }}
    HostKeyAlias {{ h.dns_name | default(h.name) }}
{% endfor %}
