# Managed by Ansible — do not edit manually.
#
# Sourced by the Tier 2 scripts. Deliberately NOT passed as cron arguments:
# anything on a cron command line is readable via `crontab -l`, shows up in
# `ps` while the job runs, and is echoed back in cron mail on failure. The
# fleet's existing wrapper invocations still carry their Slack tokens inline —
# that is docs/TODO.md Priority 3, and this file is the pattern that closes it.
#
# Mode 0640, root:{{ infrastructure_group }}.

# Spend-capped key in its own Console workspace — revocable in one click
# without touching anything else.
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}
{% if vault_fireworks_api_key is defined %}
FIREWORKS_API_KEY={{ vault_fireworks_api_key }}
{% endif %}

# Slack delivery. alert -> #home-alerts (watched), logging -> #home-logging.
AGENT_SLACK_ALERT={{ alert_token }}
AGENT_SLACK_LOGGING={{ logging_token }}
