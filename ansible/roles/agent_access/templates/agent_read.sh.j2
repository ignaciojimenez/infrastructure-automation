#!/bin/sh
# agent_read — read-only access to the infrastructure user's monitoring logs
# and check scripts, for the {{ agent_access_user }} account.
# Managed by Ansible — do not edit manually.
#
# Runs as root (via sudo) to reach the infrastructure user's 0700 home, which
# is where per-service monitoring output and the check scripts live and which
# read_agent otherwise cannot see. Names are validated to reject slashes and
# "..", so — unlike a `sudo cat /home/user/.logs/*` glob, whose `*` spans `/`
# and would match `../../etc/...` — this cannot be coaxed into reading files
# outside the two whitelisted directories.
#
# Read-only by construction: it only ever `cat`s or `ls`s. It is root-owned and
# not writable by {{ agent_access_user }}, so the account cannot alter what it
# reads.
set -u

LOG_DIR="/home/{{ infrastructure_user }}/.logs"
SCRIPT_DIR="/home/{{ infrastructure_user }}/.scripts"

usage() {
    echo "usage: agent_read {list-logs | list-scripts | log <name> | script <name>}" >&2
    exit 2
}

valid_name() {
    case "$1" in
        '' | */* | *..*) return 1 ;;              # no empty, no slash, no ..
        *[!A-Za-z0-9._-]*) return 1 ;;            # only safe filename chars
        *) return 0 ;;
    esac
}

case "${1:-}" in
    list-logs)    ls -1 "$LOG_DIR"    2>/dev/null; exit 0 ;;
    list-scripts) ls -1 "$SCRIPT_DIR" 2>/dev/null; exit 0 ;;
    log)          valid_name "${2:-}" || usage; f="$LOG_DIR/$2" ;;
    script)       valid_name "${2:-}" || usage; f="$SCRIPT_DIR/$2" ;;
    *)            usage ;;
esac

[ -f "$f" ] || { echo "not found: $f" >&2; exit 1; }

# Rotated logs are gzipped (logrotate: daily, rotate 7, compress). `cat`ing one
# returns raw compressed bytes, and THAT is the bug this handles — not that it
# fails, but that it succeeds uselessly. A grep over those bytes matches nothing
# and exits 0, which reads exactly like "the event never happened" rather than
# "this file is unreadable". Measured 2026-08-27: a rotated log reported 0
# ladder starts where gunzip found 8.
#
# So: decompress when we can, and REFUSE loudly when we cannot. Never hand back
# bytes the caller will silently mis-read.
case "$f" in
    *.gz)
        if command -v zcat >/dev/null 2>&1; then
            zcat "$f"
        elif command -v gunzip >/dev/null 2>&1; then
            gunzip -c "$f"
        else
            echo "cannot read $f: file is gzip-compressed and neither zcat nor gunzip is installed" >&2
            echo "refusing to emit compressed bytes: a grep over them would return 0 matches and read as 'not found'" >&2
            exit 1
        fi
        ;;
    *)
        cat "$f"
        ;;
esac
