#!/bin/sh
# Test-container control, the only privileged thing {{ rig_access_user }} may do.
# Managed by Ansible (roles/rig_access). Do not edit on the host.
#
# Runs as root via an enumerated sudoers entry — ten exact command lines, no
# wildcards — so sudo refuses anything outside the grant before this file is
# reached. The checks below are therefore belt and braces, not the control.
#
# 🔴 `create` takes NO arguments from the caller. Every value it hands the
# provisioner is a literal written here at deploy time, keyed by VMID. There is
# no pass-through, so there is nothing to inject into: the bind-mount escape
# (`--mp0 /:/host`) cannot be expressed through this interface at all.

set -eu

TAG="rig_ct"
VERB="${1:-}"
VMID="${2:-}"

die() {
    logger -t "$TAG" -p auth.warning "refused: $1 (verb=[${VERB}] vmid=[${VMID}])"
    echo "rig_ct: $1" >&2
    exit 2
}

# Exactly two arguments. Never more — a third would mean something upstream
# started passing input through, which is the failure this design exists to
# make impossible.
[ "$#" -eq 2 ] || die "expects exactly 2 arguments, got $#"

case "$VMID" in
{% for vmid in rig_access_vmids %}
    {{ vmid }}) ;;
{% endfor %}
    *) die "VMID not in the allowlist" ;;
esac

case "$VERB" in
{% for verb in rig_access_verbs %}
    {{ verb }}) ;;
{% endfor %}
    *) die "verb not in the allowlist" ;;
esac

logger -t "$TAG" -p auth.notice "$VERB $VMID requested"

exists() { pct config "$1" >/dev/null 2>&1; }

case "$VERB" in
    status)
        pct status "$VMID"
        ;;
    start)
        exists "$VMID" || die "CT $VMID does not exist"
        pct status "$VMID" | grep -q running || pct start "$VMID"
        pct status "$VMID"
        ;;
    stop)
        exists "$VMID" || die "CT $VMID does not exist"
        pct status "$VMID" | grep -q running && pct stop "$VMID" || true
        pct status "$VMID"
        ;;
    destroy)
        # Irreversible, and the reason the allowlist is enforced three times.
        # Guarded on existence so a repeat call is a no-op rather than an
        # error: the loop that calls this must be safe to re-run.
        if exists "$VMID"; then
            pct status "$VMID" | grep -q running && pct stop "$VMID" || true
            pct destroy "$VMID" --purge
            logger -t "$TAG" -p auth.notice "destroyed CT $VMID"
            echo "destroyed $VMID"
        else
            echo "absent $VMID"
        fi
        ;;
    create)
        if exists "$VMID"; then
            echo "exists $VMID"
            exit 0
        fi
        # Built by the same script a human runs on the laptop's behalf, so
        # there is one definition of what a test container is, not two kept in
        # step by hand. It creates, starts, checks systemd, installs the test
        # prerequisites, creates {{ infrastructure_user }} with sudo, and
        # authorises the workbench key for that user and root.
        #
        # That last step is why the key is installed HERE: a container fresh
        # from `pct create` has no keys at all, and this is the only moment
        # anything holds root on it. The key is the one this file was rendered
        # with — baked in at deploy time, never passed in.
        #
        # `env -i` and every TEST_CT_* written out: the script falls back to
        # its own defaults for anything unset, and nothing about this run may
        # depend on what happened to be in the environment. Every value below
        # is literal. Nothing here came from the caller.
        case "$VMID" in
{% for vmid in rig_access_vmids %}
{% set h = rig_access_hosts[vmid] %}
            {{ vmid }})
                env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
                    TEST_CT_VMID={{ vmid }} \
                    TEST_CT_HOSTNAME={{ h.hostname }} \
                    TEST_CT_IP={{ h.ip }} \
                    TEST_CT_CIDR=24 \
                    TEST_CT_GATEWAY={{ rig_access_gateway }} \
                    TEST_CT_NAMESERVER={{ rig_access_nameserver }} \
                    TEST_CT_BRIDGE={{ rig_access_bridge }} \
                    TEST_CT_STORAGE={{ rig_access_storage }} \
                    TEST_CT_ROOTFS_GB={{ rig_access_rootfs_gb }} \
                    TEST_CT_MEMORY={{ rig_access_memory }} \
                    TEST_CT_SWAP={{ rig_access_swap }} \
                    TEST_CT_CORES={{ rig_access_cores }} \
                    TEST_CT_TEMPLATE_STORAGE={{ rig_access_template_storage }} \
                    TEST_CT_TEMPLATE={{ h.template }} \
                    TEST_CT_USER={{ infrastructure_user }} \
                    TEST_CT_BARE=0 \
                    TEST_CT_PUBKEY={{ rig_access_pubkey | quote }} \
                    sh {{ rig_access_provisioner }}
                ;;
{% endfor %}
        esac
        logger -t "$TAG" -p auth.notice "created and provisioned CT $VMID"
        echo "created $VMID"
        ;;
esac
