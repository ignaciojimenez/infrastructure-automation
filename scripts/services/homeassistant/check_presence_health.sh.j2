#!/bin/sh
# check_presence_health.sh — have we lost a phone as a presence source?
# Managed by Ansible — do not edit manually.
#
# The chain is
#
#   Companion App -> device_tracker.* -> person.* -> group.persons -> Tado API
#
# and this script watches the left-hand end, the only place presence is
# actually produced. (Renamed from check_tado_health.sh on 2026-08-26: Tado
# consumes presence, it does not produce it.)
#
# What it is for: noticing that a phone has stopped feeding Home Assistant, so
# home/away can no longer be trusted for that person. Not a same-day freeze
# detector — see "the gap" below.
#
# The rule (2026-11-24): a phone that is in use must be charged, and the
# Companion App reports on every charging transition. So a live app cannot stay
# silent past a bound set by its battery, wherever its owner is. The check
# therefore asks one question per phone:
#
#   when did ANY of its entities last hear from the phone?
#
# and pages when that is more than {{ presence_stale_hours }} h ago, home or away. "Any" is the tracker plus
# every sensor the app registers under the same device name (battery level and
# state, pressure, ...): a charge sends the battery sensors and a location in
# the same report, and a move sends a location, so the newest of them is the
# phone's last word.
#
# How this replaced two earlier rules, both measured wrong on a real phone:
#   * "tracker stale AND home" (PER-57): a phone left indoors went 18–32 h
#     without a location and paged four times in six days.
#   * "stale AND home AND ignores request_location_update": the recorder showed
#     her app alive (a sensor update at 13:33, a report at 22:12 on 11-20) and
#     still ignoring the request. HA's docs call the command "a little bit hit
#     or miss" and say "Do not rely on this functionality". It is gone.
#
# ⚠️ The threshold is a choice, not a measurement. Over 2026-11-14..24 the
# longest silence across ALL entities was 9.4 h for one phone and 30.5 h for
# the other (home, not charged, 95% -> 65%). Any threshold under 30.5 h pages
# on that day. See presence_stale_hours.
#
# ⚠️ The gap: a phone that freezes while its owner is out keeps them `home` for
# up to {{ presence_stale_hours }} h before this pages.
#
# ⚠️ A Home Assistant restart is not a report (2026-10-04). On start HA
# restores every entity and stamps `last_reported` with the moment it did so;
# taken at face value, every deploy would reset every phone's clock. So stamps
# inside the restart's restore window are ignored, and each phone's last real
# report is kept in {{ presence_last_seen_state_file }}
# to carry it across the restart.
#
# Ignored on purpose: the `notify.<phone>` entity. It shares the phone's name,
# and its stamp moves whenever HA pushes TO the phone — HA's act, not the
# phone's.
set -eu

SECRETS_FILE="{{ homeassistant_config_dir }}/secrets.yaml"
HA_URL="http://localhost:8123"
STALE_HOURS="{{ presence_stale_hours }}"
STATE_FILE="{{ presence_last_seen_state_file }}"

# cron has no LANG; pin stdout so the status markers below cannot raise
# UnicodeEncodeError at the moment the check has something to say.
PYTHONIOENCODING=utf-8
export PYTHONIOENCODING

HA_TOKEN=$(sed -n 's/^ha_monitor_token:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' \
           "$SECRETS_FILE" 2>/dev/null | head -1)
if [ -z "$HA_TOKEN" ]; then
    echo "❌ ha_monitor_token not found in $SECRETS_FILE — this check cannot run"
    exit 1
fi

# Persons deliberately NOT monitored. Placeholders with no human behind them —
# listing them here is cheaper than teaching the discovery below to guess.
PRESENCE_IGNORE=$(cat <<'IGNOREEOF'
{% for p in presence_ignore_persons | default([]) %}
{{ p }}
{% endfor %}
IGNOREEOF
)
export PRESENCE_IGNORE

# When HA last started, from Docker rather than HA: a restored entity cannot
# tell you it was restored. Empty if Docker cannot say — the check then runs
# without the restart guard, and says so.
HA_STARTED=$(docker inspect "{{ homeassistant_container_name }}" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["State"]["StartedAt"])' \
      2>/dev/null) || HA_STARTED=""

python3 - "$HA_TOKEN" "$HA_URL" "$STALE_HOURS" "$STATE_FILE" "$HA_STARTED" <<'PYEOF'
import datetime
import json
import os
import re
import sys
from urllib.request import Request, urlopen
from urllib.error import HTTPError, URLError

token, ha_url, stale_hours, state_file = (sys.argv[1], sys.argv[2],
                                          float(sys.argv[3]), sys.argv[4])
now = datetime.datetime.now(datetime.timezone.utc)

# How long after HA starts its restored stamps keep landing. Observed: 34 s on
# dockassist; five minutes leaves room for a slow boot.
RESTORE_WINDOW = datetime.timedelta(minutes=5)

# Domains the Companion App writes. `notify` is excluded: HA moves it.
PHONE_DOMAINS = ("device_tracker.", "sensor.", "binary_sensor.")


def parse_stamp(stamp):
    """ISO-8601 from HA or Docker, or None. Docker writes `Z` and nanoseconds."""
    if not stamp:
        return None
    stamp = re.sub(r"(\.\d{6})\d+", r"\1", stamp.replace("Z", "+00:00"))
    try:
        return datetime.datetime.fromisoformat(stamp)
    except ValueError:
        return None


ha_started = parse_stamp(sys.argv[5] if len(sys.argv) > 5 else "")
ignored = {p.strip() for p in os.environ.get("PRESENCE_IGNORE", "").splitlines() if p.strip()}


def all_states():
    req = Request("%s/api/states" % ha_url)
    req.add_header("Authorization", "Bearer %s" % token)
    with urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode("utf-8"))


def load_seen():
    try:
        with open(state_file) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def restored_at_start(t):
    """True if HA wrote this stamp itself while restoring state on start."""
    return (ha_started is not None
            and datetime.timedelta(0) <= t - ha_started <= RESTORE_WINDOW)


def hours(t):
    return (now - t).total_seconds() / 3600.0


issues = []
notes = []
if ha_started is None:
    notes.append("cannot read Home Assistant's start time from Docker — a "
                 "restart would read as every phone reporting")

try:
    states = all_states()
except (HTTPError, URLError, TimeoutError, OSError) as exc:
    print("❌ cannot reach Home Assistant to enumerate presence: %s" % exc)
    sys.exit(1)

by_id = {s["entity_id"]: s for s in states if isinstance(s, dict) and "entity_id" in s}

# Discover what to watch from HA's own model: every person's `device_trackers`.
# A replaced or added phone is covered the moment it is attached to a person,
# with no list here to forget to edit.
persons = [s for eid, s in by_id.items()
           if eid.startswith("person.") and eid not in ignored]
if not persons:
    print("❌ no person entities found — presence cannot be judged, and HA "
          "having none is itself wrong")
    sys.exit(1)

seen = load_seen()      # tracker -> ISO stamp of the phone's last real report
new_seen = {}


def last_heard(tid):
    """(when the phone behind `tid` last reported, n entities read, note) or
    (None, 0, note) if it never has as far as this check can tell."""
    tracker = by_id[tid]
    name = tracker.get("attributes", {}).get("friendly_name") or ""
    family = [tracker]
    if name:
        # The app names every sensor "<device name> <sensor>". Matching on the
        # name rather than the entity id survives HA's `_2` suffixes, which
        # land on different ends of the id for different phones.
        family += [s for eid, s in by_id.items()
                   if eid != tid and eid.startswith(PHONE_DOMAINS)
                   and (s.get("attributes", {}).get("friendly_name") or "")
                   .startswith(name + " ")]
    real, restored = [], []
    for s in family:
        t = parse_stamp(s.get("last_reported") or s.get("last_updated"))
        if t is not None:
            (restored if restored_at_start(t) else real).append(t)
    stored = parse_stamp(seen.get(tid))
    best = max(real + ([stored] if stored else []), default=None)
    note = None
    if best is None and restored:
        # Restarted before this check ever recorded the phone: the restart is
        # the earliest moment we can vouch for. Counting from it is late, not
        # wrong — it pages {{ presence_stale_hours }} h after the restart if nothing arrives.
        best = max(restored)
        note = "no report since Home Assistant restarted at %s; counting from it" % (
            ha_started.isoformat(timespec="seconds"))
    if best is not None:
        new_seen[tid] = best.isoformat()
    return best, len(family), note


watched = 0
for person in sorted(persons, key=lambda s: s["entity_id"]):
    pid = person["entity_id"]
    label = person.get("attributes", {}).get("friendly_name") or pid
    if person.get("state") in ("unknown", "unavailable"):
        issues.append("%s person entity is %s" % (label, person.get("state")))

    trackers = person.get("attributes", {}).get("device_trackers") or []
    if not trackers:
        notes.append("%s has no device_trackers attached — presence for them is "
                     "unconfigured, so nothing here can watch it" % label)
        continue

    judged = {}
    for tid in trackers:
        st = by_id.get(tid)
        if st is None:
            judged[tid] = ("missing", None, 0, None)
        elif st.get("state") == "unavailable":
            judged[tid] = ("unavailable", None, 0, None)
        else:
            when, n, note = last_heard(tid)
            fresh = when is not None and hours(when) <= stale_hours
            judged[tid] = ("fresh" if fresh else "silent", when, n, note)

    # A person is as live as their freshest phone (PER-172): HA's person entity
    # follows the most recent report, so a retired phone still attached after a
    # swap cannot mislead presence while another reports.
    fresh = [t for t, j in judged.items() if j[0] == "fresh"]
    for tid, (verdict, when, n, note) in judged.items():
        st = by_id.get(tid) or {}
        tlabel = "%s / %s" % (label, st.get("attributes", {}).get("friendly_name") or tid)
        if note:
            notes.append("%s: %s" % (tlabel, note))
        if verdict == "fresh":
            watched += 1
            continue
        if fresh:
            notes.append("%s is %s, not judged — %s reports for them"
                         % (tid, "missing from HA" if verdict == "missing" else verdict,
                            fresh[0]))
            continue
        watched += 1
        if verdict == "missing":
            issues.append("%s: tracker %s is attached but does not exist in HA"
                          % (label, tid))
        elif verdict == "unavailable":
            issues.append("%s tracker is unavailable — the app is not reporting at all"
                          % tlabel)
        elif when is None:
            issues.append("%s: no timestamp on any of its entities — cannot tell "
                          "when the phone last reported" % tlabel)
        else:
            issues.append(
                "%s: no report from the phone in %.0f h (threshold %.0f h, any of "
                "%d entities). A phone in use reports at least on every charge, so "
                "the app has stopped or the phone has been off — home/away for "
                "%s cannot be trusted until it reports again."
                % (tlabel, hours(when), stale_hours, n, label))

if new_seen != seen:
    try:
        tmp = state_file + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(new_seen, fh, indent=1, sort_keys=True)
        os.replace(tmp, state_file)
    except OSError as exc:
        # Without the record a restart silently resets every phone's clock.
        issues.append("cannot write %s: %s" % (state_file, exc))

for note in notes:
    print("⚠️  %s" % note)

if issues:
    for issue in issues:
        print("❌ %s" % issue)
    sys.exit(min(len(issues), 125))

print("✅ presence is live: %d person(s), %d phone(s), each reported within %.0f h"
      % (len(persons), watched, stale_hours))
sys.exit(0)
PYEOF
