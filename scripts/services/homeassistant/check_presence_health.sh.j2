#!/bin/sh
# check_presence_health.sh — is the presence signal still trustworthy?
# Managed by Ansible — do not edit manually.
#
# RENAMED from check_tado_health.sh on 2026-08-26. The old name cost a real
# conversation: it does not check Tado. Tado is downstream — it *consumes*
# presence. The chain is
#
#   Companion App -> device_tracker.* -> person.* -> group.persons -> Tado API
#
# and this script watches the left-hand end, the only place presence is
# actually produced. There is one presence source, not two.
#
# Three failure modes, and the third is the reason for the rewrite:
#
#   1. tracker `unavailable` — the app is gone. Loud and obvious.
#   2. person `unknown`/`unavailable` — the entity is misconfigured.
#   3. tracker FROZEN — still reporting a state, just not updating. The old
#      header claimed "verifies device trackers are fresh"; the code only ever
#      tested for `unavailable`, so a stuck tracker was invisible. A tracker
#      stuck on `home` means heating runs all day and every away-automation
#      stays asleep.
#
# ⚠️ Why staleness is never enough on its own, measured rather than assumed.
#
# Silence does not tell a frozen app from a phone that has nothing to say. iOS
# reports location on zone enter/exit, significant location change, background
# fetch at the OS's discretion, or when asked — so a phone that stays in the
# house can go a day or more without a word. 7 days of history (2026-08-26)
# showed healthy gaps of 470 and 721 min, which set the threshold below; then
# Candela stayed home and the check paged four times in six days (11, 14, 15,
# 16 Sep, PER-57) on gaps of 18–32 h while her phone was perfectly healthy.
#
# No threshold fixes that: someone home for a weekend is a 48 h gap. So the
# rule is **stale AND home AND does not answer when asked**:
#
#   stale + not_home -> someone is out with their phone off. Benign.
#   stale + home     -> ASK. Send `request_location_update`, a silent push the
#                       Companion App answers with a fresh location. The next
#                       run looks: `last_reported` moved = stationary, healthy.
#   ...no answer     -> presence is frozen claiming someone is in. This is the
#                       one that costs money and comfort, and it pages.
#
# The push is invisible to the phone's owner (Companion App docs) and is rate
# limited here to one per tracker per {{ presence_probe_interval_hours }} h: HA's push relay enforces a
# daily per-device quota, and a check that burns it would silence the real
# notifications that phone receives.
#
# {{ presence_stale_hours }}h before asking; {{ presence_probe_answer_minutes }} min for the answer, so one push
# delivered late is not a page.
#
# ⚠️ A Home Assistant restart is not an answer (2026-10-04). On start HA
# restores every entity and stamps `last_reported` with the moment it did so.
# Candela's app had been silent 19 h and this check had paged; an Ansible
# deploy restarted HA at 21:13, every one of her sensors read "reported 34 s
# after boot", and the 21:30 run cleared the page with "✅ all reporting" and
# dropped the outstanding request. Cloudflare showed no request from her app
# at all. So while a request is outstanding, a stamp inside the restart's
# restore window is read as HA's, and the tracker is judged by the stamp it had
# when asked. The cost runs the safe way: a phone that genuinely answers inside
# those few minutes keeps paging until its next report.
set -eu

SECRETS_FILE="{{ homeassistant_config_dir }}/secrets.yaml"
HA_URL="http://localhost:8123"
STALE_HOURS="{{ presence_stale_hours }}"
PROBE_ANSWER_MINUTES="{{ presence_probe_answer_minutes }}"
PROBE_INTERVAL_HOURS="{{ presence_probe_interval_hours }}"
STATE_FILE="{{ presence_probe_state_file }}"

# cron has no LANG; pin stdout so the status markers below cannot raise
# UnicodeEncodeError at the moment the check has something to say.
PYTHONIOENCODING=utf-8
export PYTHONIOENCODING

HA_TOKEN=$(sed -n 's/^ha_monitor_token:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' \
           "$SECRETS_FILE" 2>/dev/null | head -1)
if [ -z "$HA_TOKEN" ]; then
    echo "❌ ha_monitor_token not found in $SECRETS_FILE — this check cannot run"
    exit 1
fi

# Persons deliberately NOT monitored. Placeholders with no human behind them —
# listing them here is cheaper than teaching the discovery below to guess.
PRESENCE_IGNORE=$(cat <<'IGNOREEOF'
{% for p in presence_ignore_persons | default([]) %}
{{ p }}
{% endfor %}
IGNOREEOF
)
export PRESENCE_IGNORE

# When HA last started, from Docker rather than HA: a restored entity cannot
# tell you it was restored. Empty if Docker cannot say — the check then runs as
# it did before, and says so.
HA_STARTED=$(docker inspect "{{ homeassistant_container_name }}" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["State"]["StartedAt"])' \
      2>/dev/null) || HA_STARTED=""

python3 - "$HA_TOKEN" "$HA_URL" "$STALE_HOURS" "$STATE_FILE" \
          "$PROBE_ANSWER_MINUTES" "$PROBE_INTERVAL_HOURS" "$HA_STARTED" <<'PYEOF'
import datetime
import json
import os
import re
import sys
import unicodedata
from urllib.request import Request, urlopen
from urllib.error import HTTPError, URLError

token, ha_url, stale_hours, state_file = (sys.argv[1], sys.argv[2],
                                          float(sys.argv[3]), sys.argv[4])
answer_minutes, probe_interval_hours = float(sys.argv[5]), float(sys.argv[6])
now = datetime.datetime.now(datetime.timezone.utc)

# How long after HA starts its restored stamps keep landing. Observed: 34 s on
# dockassist; five minutes leaves room for a slow boot.
RESTORE_WINDOW = datetime.timedelta(minutes=5)


def parse_stamp(stamp):
    """ISO-8601 from HA or Docker, or None. Docker writes `Z` and nanoseconds."""
    if not stamp:
        return None
    stamp = re.sub(r"(\.\d{6})\d+", r"\1", stamp.replace("Z", "+00:00"))
    try:
        return datetime.datetime.fromisoformat(stamp)
    except ValueError:
        return None


ha_started = parse_stamp(sys.argv[7] if len(sys.argv) > 7 else "")


ignored = {p.strip() for p in os.environ.get("PRESENCE_IGNORE", "").splitlines() if p.strip()}


def get_state(entity_id):
    req = Request("%s/api/states/%s" % (ha_url, entity_id))
    req.add_header("Authorization", "Bearer %s" % token)
    with urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode("utf-8"))


def all_states():
    req = Request("%s/api/states" % ha_url)
    req.add_header("Authorization", "Bearer %s" % token)
    with urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode("utf-8"))


def call_service(domain, service, payload):
    req = Request("%s/api/services/%s/%s" % (ha_url, domain, service),
                  data=json.dumps(payload).encode("utf-8"), method="POST")
    req.add_header("Authorization", "Bearer %s" % token)
    req.add_header("Content-Type", "application/json")
    with urlopen(req, timeout=15) as resp:
        resp.read()


def notify_services():
    req = Request("%s/api/services" % ha_url)
    req.add_header("Authorization", "Bearer %s" % token)
    with urlopen(req, timeout=15) as resp:
        domains = json.loads(resp.read().decode("utf-8"))
    for d in domains:
        if d.get("domain") == "notify":
            return set(d.get("services") or {})
    return set()


def slugify(text):
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
    return re.sub(r"[^a-z0-9]+", "_", text.lower()).strip("_")


def notify_service_for(tid, tracker, available):
    """The Companion App's notify service for this tracker, or None.

    HA names it `mobile_app_<slug of device name>`, and a tracker's
    friendly_name is that device name unless someone renamed the entity. The
    entity id is the fallback, with and without the `_2` HA appends on a
    re-registered phone — which is exactly Candela's: the tracker is
    `iphone_de_candela_2`. Only a name that HA actually lists is returned, so
    a wrong guess is "cannot ask", never a push to nowhere.
    """
    obj = tid.split(".", 1)[1]
    candidates = []
    name = tracker.get("attributes", {}).get("friendly_name")
    if name:
        candidates.append("mobile_app_" + slugify(name))
    candidates += ["mobile_app_" + obj, "mobile_app_" + re.sub(r"_\d+$", "", obj)]
    for c in candidates:
        if c in available:
            return c
    return None


def load_probes():
    try:
        with open(state_file) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_probes(probes):
    tmp = state_file + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(probes, fh, indent=1, sort_keys=True)
    os.replace(tmp, state_file)


def age_minutes(stamp):
    """Minutes since `stamp`, or None if it is missing or unreadable."""
    t = parse_stamp(stamp)
    return None if t is None else (now - t).total_seconds() / 60.0


def restored_at_start(stamp):
    """True if HA wrote this stamp itself while restoring state on start."""
    t = parse_stamp(stamp)
    return (ha_started is not None and t is not None
            and datetime.timedelta(0) <= t - ha_started <= RESTORE_WINDOW)


issues = []
notes = []
if ha_started is None:
    notes.append("cannot read Home Assistant's start time from Docker — a "
                 "restart during a freeze would read as the phone answering")

# ---------------------------------------------------------------------------
# Discover what to watch, rather than being told.
#
# Every `person` entity carries a `device_trackers` attribute naming exactly the
# trackers HA uses to decide where that person is. Walking that is strictly
# better than naming phones in inventory, or than matching `source_type == gps`:
#
#   * a phone replaced or added is picked up the moment it is attached to a
#     person in HA's UI — no repo change, and no silent gap while nobody
#     remembers to edit a list;
#   * a stray tracker that feeds nobody is correctly ignored, because it cannot
#     affect presence;
#   * it mirrors HA's own model instead of guessing at one.
#
# This is the same lesson as the entity check: a hardcoded list stops covering
# whatever is added after it was written.
# ---------------------------------------------------------------------------
try:
    states = all_states()
except (HTTPError, URLError, TimeoutError, OSError) as exc:
    print("❌ cannot reach Home Assistant to enumerate presence: %s" % exc)
    sys.exit(1)

by_id = {s["entity_id"]: s for s in states if isinstance(s, dict) and "entity_id" in s}
persons = [s for eid, s in by_id.items()
           if eid.startswith("person.") and eid not in ignored]

if not persons:
    print("❌ no person entities found — presence cannot be judged, and HA "
          "having none is itself wrong")
    sys.exit(1)

# Outstanding location requests, keyed by tracker:
#   {"asked_at": <epoch>, "reported": <tracker last_reported when asked>}
# An entry is dropped the moment its tracker is fresh or away, so the file only
# ever holds trackers that are silent at home right now.
probes = load_probes()
live_probes = {}
notify_available = None   # GET /api/services only if something needs asking

watched = 0
for person in sorted(persons, key=lambda s: s["entity_id"]):
    pid = person["entity_id"]
    label = person.get("attributes", {}).get("friendly_name") or pid
    state = person.get("state")
    if state in ("unknown", "unavailable"):
        issues.append("%s person entity is %s" % (label, state))

    trackers = person.get("attributes", {}).get("device_trackers") or []
    if not trackers:
        notes.append("%s has no device_trackers attached — presence for them is "
                     "unconfigured, so nothing here can watch it" % label)
        continue

    for tid in trackers:
        st = by_id.get(tid)
        if st is None:
            issues.append("%s: tracker %s is attached but does not exist in HA"
                          % (label, tid))
            continue
        watched += 1
        tstate = st.get("state")
        tlabel = "%s / %s" % (label, st.get("attributes", {}).get("friendly_name") or tid)

        if tstate == "unavailable":
            issues.append("%s tracker is unavailable — the app is not reporting at all"
                          % tlabel)
            continue

        # `last_reported`, not `last_changed`: the latter only moves when the
        # value differs, so a phone sitting at `home` all day would look stale
        # within the hour and page constantly.
        reported = st.get("last_reported") or st.get("last_updated")
        probe = probes.get(tid)
        if probe and restored_at_start(reported):
            # HA restarted while the phone owed an answer. The new stamp is
            # HA's own restore; the phone's last word is the one we asked on.
            reported = probe.get("reported")
            notes.append("%s: stamp is Home Assistant's restart at %s, not a "
                         "report — still waiting on the phone"
                         % (tlabel, ha_started.isoformat(timespec="seconds")))
        age = age_minutes(reported)
        if age is None:
            notes.append("%s: no timestamp on the state, cannot judge freshness" % tlabel)
            continue

        if age <= stale_hours * 60:
            continue
        if tstate != "home":
            notes.append(
                "%s quiet for %.0f h but reads '%s' — benign, phone is away or off"
                % (tlabel, age / 60.0, tstate))
            continue

        # Stale AND home. Silence alone cannot tell stationary from frozen, so
        # the phone is asked; see the header.
        if probe and probe.get("reported") != reported:
            probe = None   # it answered since, and has gone quiet again

        epoch = now.timestamp()
        if probe:
            waited = (epoch - probe.get("asked_at", 0)) / 60.0
            if waited < answer_minutes:
                live_probes[tid] = probe
                notes.append("%s quiet for %.0f h at home — asked for a location "
                             "%.0f min ago, waiting for the answer"
                             % (tlabel, age / 60.0, waited))
                continue
            if waited < probe_interval_hours * 60:
                live_probes[tid] = probe
                issues.append(
                    "%s tracker is FROZEN on 'home' — last reported %.0f h ago, and "
                    "the phone did not answer a location request sent %.0f min "
                    "ago. Presence is claiming someone is in; heating and "
                    "away-automations are running on a stale signal."
                    % (tlabel, age / 60.0, waited))
                continue
            # Unanswered for a whole interval: ask again below, and keep paging
            # while the new request is out.

        try:
            if notify_available is None:
                notify_available = notify_services()
            service = notify_service_for(tid, st, notify_available)
            if service is None:
                raise LookupError("no mobile_app notify service matches it")
            call_service("notify", service, {"message": "request_location_update"})
        except (HTTPError, URLError, TimeoutError, OSError, ValueError,
                LookupError) as exc:
            # Unable to ask is not evidence the phone is fine. Page, the way
            # this check did before it could ask, and say why.
            issues.append(
                "%s tracker is quiet on 'home' for %.0f h (threshold %.0f h) and "
                "the phone could not be asked for a location: %s"
                % (tlabel, age / 60.0, stale_hours, exc))
            continue

        live_probes[tid] = {"asked_at": epoch, "reported": reported}
        if probe:
            issues.append(
                "%s tracker is FROZEN on 'home' — last reported %.0f h ago, and "
                "the phone has not answered a location request in %.0f h; asked "
                "again via notify.%s" % (tlabel, age / 60.0, waited / 60.0, service))
        else:
            notes.append("%s quiet for %.0f h at home — asked the phone for a "
                         "location via notify.%s" % (tlabel, age / 60.0, service))

if live_probes != probes:
    try:
        save_probes(live_probes)
    except OSError as exc:
        # Without the record, every run asks again and nothing ever pages.
        issues.append("cannot write probe state %s: %s" % (state_file, exc))

for note in notes:
    print("⚠️  %s" % note)

if issues:
    for issue in issues:
        print("❌ %s" % issue)
    sys.exit(min(len(issues), 125))

print("✅ presence is live: %d person(s), %d tracker(s), all reporting"
      % (len(persons), watched))
sys.exit(0)
PYEOF
