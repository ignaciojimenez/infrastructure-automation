#!/bin/sh
# investigate.sh — Tier 2 investigation (managed by Ansible)
#
# Two modes:
#   (no args)   anomaly-triggered. Runs only when Tier 1 has written a NEWER
#               anomaly snapshot than the last one investigated. Costs nothing
#               on the overwhelming majority of runs, which is the point.
#   --digest    weekly fleet summary on a better model, posted to #home-logging.
#
# Deliberately separate from fleet_health_check.sh: Tier 1 must keep working —
# and stay free — even if this is broken, misconfigured, or out of credit.
#
# NOTE: never passes `--auto` to opencode. In headless mode `--auto` turns
# every "ask" permission into "allow"; the config denies rather than asks
# precisely so that this script needs no such flag.

set -u

ENV_FILE="{{ agent_env_file }}"
AGENT_DIR="{{ agent_state_dir }}"
PLANS_DIR="{{ agent_plans_dir }}"
ANOMALY_FILE="$AGENT_DIR/last_anomaly.json"
MARKER="$AGENT_DIR/.last_investigated"
FAIL_MARKER="$AGENT_DIR/.last_failure_alert"
FAIL_COOLDOWN_SECONDS={{ agent_failure_alert_cooldown_seconds }}
OPENCODE="{{ opencode_bin }}"
MONITOR_AGENT="infra-monitor"
DIGEST_MODEL="{{ agent_digest_model }}"

# Never run concurrently with ourselves. A single opencode run fans SSH out to
# the whole fleet and leaves a short-lived server; two or three at once will
# saturate this 1-CPU / 2GB box (learned the hard way during testing). In
# normal operation the crons never overlap, but a real investigation that ran
# long past the hour would otherwise collide with the next tick. Second caller
# exits immediately as a clean no-op.
LOCK="$AGENT_DIR/.investigate.lock"
mkdir -p "$AGENT_DIR"
exec 9>"$LOCK"
if ! flock -n 9; then
    echo "another investigate.sh holds the lock; exiting" >&2
    exit 0
fi

if [ ! -r "$ENV_FILE" ]; then
    echo "FATAL: cannot read $ENV_FILE — Tier 2 not configured" >&2
    exit 1
fi
# shellcheck disable=SC1090
. "$ENV_FILE"

if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "FATAL: ANTHROPIC_API_KEY unset in $ENV_FILE" >&2
    exit 1
fi
export ANTHROPIC_API_KEY
[ -n "${FIREWORKS_API_KEY:-}" ] && export FIREWORKS_API_KEY

mkdir -p "$PLANS_DIR"

# Posts to Slack. Body is JSON-escaped via python3 rather than sed, because
# investigation summaries contain quotes, newlines, and backslashes.
slack() {
    _webhook="$1"
    _text="$2"
    [ -z "$_webhook" ] && return 0
    _payload=$(printf '%s' "$_text" | python3 -c \
        'import json,sys; print(json.dumps({"text": sys.stdin.read()}))' 2>/dev/null) || return 0
    curl -s --max-time 15 -X POST \
        "https://hooks.slack.com/services/${_webhook}" \
        -H 'Content-Type: application/json' \
        -d "$_payload" >/dev/null 2>&1
}

# Alerts about *our own* failure, at most once per cooldown window.
#
# Without this, a persistent anomaly retries hourly (by design — the success
# marker is only written on success, so transient failures recover), and every
# retry would post another identical failure alert to the watched channel.
# Same flooding bug as the ssh_alert cooldown in Phase A; same fix.
alert_failure_throttled() {
    _msg="$1"
    _now=$(date +%s)
    _last=0
    [ -f "$FAIL_MARKER" ] && _last=$(cat "$FAIL_MARKER" 2>/dev/null || echo 0)
    case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
    if [ "$((_now - _last))" -ge "$FAIL_COOLDOWN_SECONDS" ]; then
        printf '%s\n' "$_now" > "$FAIL_MARKER"
        slack "${AGENT_SLACK_ALERT:-}" "$_msg"
    else
        echo "failure alert suppressed (cooldown active)" >&2
    fi
}

# run_agent <agent> <extra-args...> — prompt on stdin.
#
# Uses --format json, NOT the default text mode. Text mode dumps the entire
# session to stdout — every tool call, the agent's narration, and any
# permission-rejection error with its full rules payload — all wrapped in ANSI
# colour codes. Parsing a clean plan out of that is hopeless. The JSON stream
# is newline-delimited events; we keep only the text parts of the FINAL
# assistant message (the plan), and sum step costs for the log.
#
# Sets three globals: AGENT_OUTPUT (clean final text), AGENT_RC, AGENT_COST.
run_agent() {
    _agent="$1"
    shift
    _prompt=$(cat)

    _raw=$("$OPENCODE" run --agent "$_agent" --format json "$@" "$_prompt" 2>&1)
    AGENT_RC=$?

    # On a hard failure (credit/config/network) the output is an error string,
    # not JSON — the extractor yields nothing and we surface the raw error.
    if [ "$AGENT_RC" -ne 0 ]; then
        AGENT_OUTPUT="$_raw"
        AGENT_COST="0"
        return
    fi

    AGENT_OUTPUT=$(printf '%s' "$_raw" | python3 -c '
import json, sys
msgs, order = {}, []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    if ev.get("type") == "text":
        p = ev.get("part", {})
        mid = p.get("messageID")
        if mid not in msgs:
            msgs[mid] = []
            order.append(mid)
        msgs[mid].append(p.get("text", ""))
# The final assistant message is the plan; earlier ones are narration.
print("".join(msgs[order[-1]]) if order else "")
' 2>/dev/null)

    AGENT_COST=$(printf '%s' "$_raw" | python3 -c '
import json, sys
total = 0.0
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    if ev.get("type") == "step_finish":
        total += ev.get("part", {}).get("cost", 0) or 0
print(f"{total:.4f}")
' 2>/dev/null)
    [ -z "$AGENT_COST" ] && AGENT_COST="0"

    # An empty extraction after a clean exit means the contract broke (no text
    # events). Treat it as a failure so we alert rather than write an empty plan.
    if [ -z "$(printf '%s' "$AGENT_OUTPUT" | tr -d '[:space:]')" ]; then
        AGENT_RC=1
        AGENT_OUTPUT="agent exited 0 but produced no text output. Raw head:
$(printf '%s' "$_raw" | head -c 500)"
    fi
}

# ============================================================
# Weekly digest
# ============================================================

if [ "${1:-}" = "--digest" ]; then
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] weekly digest starting"
    run_agent "$MONITOR_AGENT" --model "$DIGEST_MODEL" <<'PROMPT'
Produce a weekly fleet health digest.

Sweep every host for slow-moving trends rather than acute faults: disk growth,
repeated service restarts, units that keep failing and self-healing, unusual
journal volume, and any host whose own monitoring has gaps.

Do not write any files. Output 5-10 bullet points to stdout, ordered by what
most deserves attention. If the fleet is simply healthy, say so in one line
rather than padding the list.
PROMPT
    echo "digest cost: \$${AGENT_COST}"
    if [ "$AGENT_RC" -ne 0 ]; then
        echo "digest failed (rc=$AGENT_RC): $AGENT_OUTPUT" >&2
        alert_failure_throttled ":warning: Weekly fleet digest failed on agent-lxc (rc=$AGENT_RC). See ~/.logs/investigate.log"
        exit "$AGENT_RC"
    fi
    slack "${AGENT_SLACK_LOGGING:-}" ":bar_chart: *Weekly fleet digest* (cost \$${AGENT_COST})

$AGENT_OUTPUT"
    echo "$AGENT_OUTPUT"
    exit 0
fi

# ============================================================
# Anomaly-triggered investigation
# ============================================================

[ -f "$ANOMALY_FILE" ] || { echo "no anomaly snapshot; nothing to do"; exit 0; }

# Debounce: only investigate a snapshot newer than the last one handled.
# Without this, a persistent fault would be re-investigated every hour and
# bill for the same finding indefinitely.
if [ -f "$MARKER" ] && [ ! "$ANOMALY_FILE" -nt "$MARKER" ]; then
    echo "anomaly snapshot unchanged since last investigation; skipping"
    exit 0
fi

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] investigating new anomaly"
anomaly=$(cat "$ANOMALY_FILE")

run_agent "$MONITOR_AGENT" <<PROMPT
The hourly Tier 1 fleet sweep reported the anomaly below. Investigate it and
produce a plan following your output contract.

Treat these findings as a starting point, not as ground truth: the sweep is
deliberately shallow and ran up to an hour ago. Confirm the symptom still
holds before reasoning about causes.

\`\`\`json
$anomaly
\`\`\`
PROMPT
echo "investigation cost: \$${AGENT_COST}"

if [ "$AGENT_RC" -ne 0 ]; then
    echo "investigation failed (rc=$AGENT_RC): $AGENT_OUTPUT" >&2
    alert_failure_throttled ":warning: Fleet investigation failed on agent-lxc (rc=$AGENT_RC). The Tier 1 alert still stands and needs a human. See ~/.logs/investigate.log"
    exit "$AGENT_RC"
fi
output="$AGENT_OUTPUT"

# Mark handled only on success, so a transient failure retries next hour
# rather than silently swallowing the anomaly.
date -u +%Y-%m-%dT%H:%M:%SZ > "$MARKER"
rm -f "$FAIL_MARKER"

# The agent is read-only by design and cannot write files. It emits its output
# bounded by two exact marker lines — ===PLAN=== <plan> ===SUMMARY=== <summary>.
# THIS script — trusted, running as the primary user, outside OpenCode's
# permission layer — extracts between the markers (discarding any narration or
# code fences the model added outside them), persists the plan, and posts the
# summary. Bounding by markers rather than trusting the model to emit no
# preamble is what makes this robust.
plan_body=$(printf '%s\n' "$output" \
    | awk '/^===PLAN===[[:space:]]*$/{f=1;next} /^===SUMMARY===[[:space:]]*$/{f=0} f' \
    | grep -v '^```')
summary=$(printf '%s\n' "$output" | sed '1,/^===SUMMARY===[[:space:]]*$/d' | grep -v '^```')

# Missing markers means the model broke the contract. Don't lose the
# investigation — persist the raw output and summarize its head so a human
# still gets something actionable.
if [ -z "$(printf '%s' "$plan_body" | tr -d '[:space:]')" ]; then
    echo "WARN: no ===PLAN=== marker in agent output; persisting raw output" >&2
    plan_body="$output"
fi
if [ -z "$(printf '%s' "$summary" | tr -d '[:space:]')" ]; then
    summary=$(printf '%s\n' "$plan_body" | grep -v '^[[:space:]]*$' | head -6)
fi

# Slug from the plan's own title line, else the timestamp.
slug=$(printf '%s\n' "$plan_body" | sed -n 's/^#[[:space:]]*//p' | head -1 \
       | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' \
       | sed 's/^-*//;s/-*$//' | cut -c1-50)
[ -z "$slug" ] && slug="anomaly"
plan_file="$PLANS_DIR/$(date -u +%Y-%m-%d)-${slug}.md"

if printf '%s\n' "$plan_body" > "$plan_file"; then
    plan_note="Plan: \`$plan_file\`"
else
    plan_note="(Could not write the plan file — check the log.)"
fi

slack "${AGENT_SLACK_ALERT:-}" ":mag: *Fleet investigation*

$summary

$plan_note"

echo "$output"
echo "--- wrote: $plan_file ---"
exit 0
