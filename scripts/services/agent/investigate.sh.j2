#!/bin/sh
# investigate.sh — Tier 2 investigation (managed by Ansible)
#
# Modes:
#   (no args)   anomaly-triggered. Runs only when Tier 1 wrote a NEWER anomaly
#               snapshot than the last one handled, and then only for hosts no
#               open incident already explains. Free on the vast majority of
#               ticks.
#   --slack     poll #home-alerts, investigate failure alerts the hourly sweep
#               can't see (per-service script failures, HA alerts) — again only
#               for hosts with no open incident, all new ones in ONE run.
#   --digest    weekly fleet summary, posted to #home-logging.
#
# Deliberately separate from fleet_health_check.sh: Tier 1 must keep working —
# and stay free — even if this is broken, misconfigured, or out of credit.
#
# The Slack read is done HERE, by this trusted script — not by the agent. The
# agent only ever investigates hosts over read-only SSH; its permission
# allowlist never needs to reach slack.com.
#
# Never passes --auto to opencode: headless, --auto turns every "ask" into
# "allow". The config denies rather than asks, so no such flag is needed.

set -u

ENV_FILE="{{ agent_env_file }}"
AGENT_DIR="{{ agent_state_dir }}"
PLANS_DIR="{{ agent_plans_dir }}"
ANOMALY_FILE="$AGENT_DIR/last_anomaly.json"
BACKOFF_DIR="$AGENT_DIR/ssh_backoff"
MARKER="$AGENT_DIR/.last_investigated"
FAIL_MARKER="$AGENT_DIR/.last_failure_alert"
FAIL_COOLDOWN_SECONDS={{ agent_failure_alert_cooldown_seconds }}
OPENCODE="{{ opencode_bin }}"
MONITOR_AGENT="infra-monitor"

# Slack watch
SLACK_CHANNEL="{{ agent_slack_channel }}"
SLACK_MAX_PER_RUN={{ agent_slack_max_per_run }}
SLACK_TS_FILE="$AGENT_DIR/.last_slack_ts"

# Incidents and spend — see the sections of the same names below.
INCIDENT_DIR="$AGENT_DIR/incidents"
INCIDENT_QUIET_SECONDS=$(( {{ agent_incident_quiet_hours }} * 3600 ))
INCIDENT_MAX_AGE_SECONDS=$(( {{ agent_incident_max_age_days }} * 86400 ))
SPEND_DIR="$AGENT_DIR/spend"
DAILY_SPEND_CAP="{{ agent_daily_spend_cap_usd }}"
FLEET_HOSTS="{% for h in agent_fleet_hosts %}{{ h.name }} {% endfor %}"

# Slack timestamps are decimal strings ("1754230021.123456"), which POSIX test
# cannot compare numerically — `[ "$ts" -gt 0 ]` errors on the decimal point,
# and `[ "$ts" != "0" ]` is true for "0.000000". Both mistakes were made here.
# awk coerces properly.
ts_is_positive() {
    awk -v v="${1:-}" 'BEGIN { exit !(v + 0 > 0) }'
}

# One opencode run fans SSH out to the whole fleet and leaves a short-lived
# server; two or three at once saturate this 1-CPU / 2GB box (learned the hard
# way). The lock makes any second caller a clean no-op — anomaly, slack, and
# digest modes all share it, so they serialize rather than pile up.
LOCK="$AGENT_DIR/.investigate.lock"
mkdir -p "$AGENT_DIR" "$INCIDENT_DIR" "$SPEND_DIR"

# Prompts are assembled into a file rather than piped, because run_and_report
# must run in THIS shell — it sets AGENT_RC/AGENT_COST that the callers read
# afterwards, and the right-hand side of a pipeline is a subshell.
PROMPT_FILE="$AGENT_DIR/.prompt.$$"
trap 'rm -f "$PROMPT_FILE"' EXIT INT TERM

exec 9>"$LOCK"
if ! flock -n 9; then
    echo "another investigate.sh holds the lock; exiting" >&2
    exit 0
fi

if [ ! -r "$ENV_FILE" ]; then
    echo "FATAL: cannot read $ENV_FILE — Tier 2 not configured" >&2
    exit 1
fi
# shellcheck disable=SC1090
. "$ENV_FILE"

if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "FATAL: ANTHROPIC_API_KEY unset in $ENV_FILE" >&2
    exit 1
fi
export ANTHROPIC_API_KEY
[ -n "${FIREWORKS_API_KEY:-}" ] && export FIREWORKS_API_KEY

mkdir -p "$PLANS_DIR"

# Closed incidents and old ledger days are dead weight; anything this old is
# past every window below.
find "$INCIDENT_DIR" "$SPEND_DIR" -type f -mtime +30 -exec rm -f {} + 2>/dev/null

# ============================================================
# SSH auth back-off — the hosts this agent must not touch
#
# The agent's only tool is `ssh <host>-agent`. So handing it "this host is
# rejecting our key" as something to investigate means it retries the exact
# authentication that is failing, dozens of times, from a container the
# firewall's IPS is watching. That is not a hypothetical: it is how agent-lxc
# banned itself off its own network on 2026-08-03, turning a single broken key
# on opnsense into a total loss of fleet visibility.
#
# Tier 1 records those hosts in BACKOFF_DIR when it stops probing them. Two
# consequences here: the agent is told, in the prompt, never to connect to
# them; and an anomaly that concerns nothing else is not investigated at all,
# because there is no evidence it could possibly gather.
# ============================================================

backed_off_hosts() {
    [ -d "$BACKOFF_DIR" ] || return 0
    for _f in "$BACKOFF_DIR"/*; do
        [ -f "$_f" ] || continue
        printf '%s\n' "${_f##*/}"
    done
}

# Hosts named by the findings in a Tier 1 snapshot. Findings are written as
# "<host>: <message>" strings, one per line; the surrounding JSON keys carry a
# quote immediately before their colon and so never match.
anomaly_finding_hosts() {
    sed -n 's/^[[:space:]]*"\([^":]*\):.*/\1/p' "$ANOMALY_FILE"
}

# Appended to every prompt. Emits nothing when no host is backed off, so the
# normal case is unchanged.
ssh_backoff_directive() {
    _blocked=$(backed_off_hosts | tr '\n' ' ' | sed 's/[[:space:]]*$//')
    [ -z "$_blocked" ] && return 0
    cat <<EOF

## Hosts you must NOT connect to

$_blocked

The Tier 1 sweep has suspended its own probing of these hosts because they are
REJECTING this container's SSH key. Do not run \`ssh <host>-agent ...\` against
any of them, not even once to confirm it. Repeated failed authentication from
this container is what caused the firewall's intrusion-prevention system to ban
it off the network on 2026-08-03 — an outage caused by the monitoring rather
than found by it.

Treat "SSH authentication is being rejected" as an established fact about those
hosts, not as a symptom to verify. Investigate whatever else the findings name,
from the hosts you can still reach. If a finding concerns only a blocked host,
say so and stop: that is a complete answer, and the fix belongs to a human with
credentials this agent does not have.
EOF
}

# compose_prompt — prompt body on stdin, written to PROMPT_FILE with the
# back-off directive appended.
compose_prompt() {
    cat > "$PROMPT_FILE"
    ssh_backoff_directive >> "$PROMPT_FILE"
}

# ============================================================
# Incidents — one paid investigation per problem, not per message
#
# Measured 2026-09-13: one fault (raspotify on hifipi) bought SIX
# investigations in ten hours, $1.57, all reaching the same conclusion. Three
# separate keys each let it through:
#   * the Slack watch deduped on message TEXT, and one fault speaks in several
#     voices — system_health_check's failure, check_raspotify's failure, and
#     the wrapper's "STILL FAILING" reminder are three texts, so three
#     signatures and three investigations;
#   * anomaly mode deduped on the WHOLE finding set, so vinylstreamer joining
#     it re-billed hifipi, and vinylstreamer leaving re-billed it again;
#   * the two modes shared no state, so each paid for what the other had just
#     explained.
#
# The key is now the HOST, shared by both modes. A host with an open incident
# is not re-investigated; a host without one is. Anything that names the host
# again — a reminder, a changed snapshot — keeps the incident open. It closes
# when nothing has named the host for INCIDENT_QUIET_SECONDS, so a fault that
# clears and later comes back is investigated afresh; and an incident older
# than INCIDENT_MAX_AGE_SECONDS is looked at again even if it never went quiet.
#
# ⚠️ The quiet window must outlast the wrapper's longest reminder gap
# (--alert-repeat-max, 24h). A still-failing check posts at least that often,
# and each post is what keeps its incident open; shorter, and a fault that has
# merely backed off its reminders looks resolved and is re-billed.
#
# Host-scoped, not (host, check), on purpose: the three hifipi messages were
# three checks describing one fault. The price is that a second, unrelated
# fault on the same host inside the window gets no plan of its own. Its alert
# still pages — only the explanation is withheld, and only until max age.
#
# State: one file per key holding "<opened_epoch> <last_seen_epoch> <plan>".
# ============================================================

now_epoch() { date +%s; }

# incident_key <text> — "host-hifipi" or "alert-<signature>", safe as a filename.
incident_key() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9.-' '-' \
        | sed 's/^-*//;s/-*$//' | cut -c1-80
}

# incident_covered <key> — true while an open incident already explains key.
incident_covered() {
    [ -f "$INCIDENT_DIR/$1" ] || return 1
    read -r _opened _seen _rest < "$INCIDENT_DIR/$1" || return 1
    case "$_opened" in ''|*[!0-9]*) return 1 ;; esac
    case "$_seen" in ''|*[!0-9]*) return 1 ;; esac
    _now=$(now_epoch)
    [ $((_now - _seen)) -lt "$INCIDENT_QUIET_SECONDS" ] &&
        [ $((_now - _opened)) -lt "$INCIDENT_MAX_AGE_SECONDS" ]
}

# incident_seen <key> — the host was named again; keep its incident open.
# Only an OPEN incident is refreshed. Refreshing a lapsed one would revive it,
# and the recurrence it exists to catch would never be investigated.
incident_seen() {
    incident_covered "$1" || return 0
    read -r _opened _seen _rest < "$INCIDENT_DIR/$1"
    printf '%s %s %s\n' "$_opened" "$(now_epoch)" "${_rest:--}" > "$INCIDENT_DIR/$1.tmp" &&
        mv -f "$INCIDENT_DIR/$1.tmp" "$INCIDENT_DIR/$1"
}

# incident_open <key> <plan> — a paid investigation has just explained it.
incident_open() {
    _t=$(now_epoch)
    printf '%s %s %s\n' "$_t" "$_t" "${2:--}" > "$INCIDENT_DIR/$1.tmp" &&
        mv -f "$INCIDENT_DIR/$1.tmp" "$INCIDENT_DIR/$1"
}

incident_plan() {
    read -r _o _s _p < "$INCIDENT_DIR/$1" 2>/dev/null
    printf '%s' "${_p:--}"
}

# ============================================================
# Helpers
# ============================================================

# Posts to Slack. JSON-escaped via python3 (summaries carry quotes/newlines).
slack() {
    _webhook="$1"; _text="$2"
    [ -z "$_webhook" ] && return 0
    _payload=$(printf '%s' "$_text" | python3 -c \
        'import json,sys; print(json.dumps({"text": sys.stdin.read()}))' 2>/dev/null) || return 0
    curl -s --max-time 15 -X POST \
        "https://hooks.slack.com/services/${_webhook}" \
        -H 'Content-Type: application/json' -d "$_payload" >/dev/null 2>&1
}

# Alerts about OUR OWN failure, at most once per cooldown window, so a
# persistent problem retrying hourly doesn't re-alert every hour.
alert_failure_throttled() {
    _msg="$1"; _now=$(date +%s); _last=0
    [ -f "$FAIL_MARKER" ] && _last=$(cat "$FAIL_MARKER" 2>/dev/null || echo 0)
    case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
    if [ "$((_now - _last))" -ge "$FAIL_COOLDOWN_SECONDS" ]; then
        printf '%s\n' "$_now" > "$FAIL_MARKER"
        slack "${AGENT_SLACK_ALERT:-}" "$_msg"
    else
        echo "failure alert suppressed (cooldown active)" >&2
    fi
}

# ============================================================
# Daily spend cap — the backstop, not the dedup
#
# Every run's cost goes into a per-UTC-day ledger, the digest's included. Past
# the cap, anomaly and Slack investigations stop until the day rolls over; the
# digest still runs, because skipping it loses a whole week. The incidents
# above are the control. This exists for the key that churns in a way nobody
# has seen yet, so it sits well above a real bad day. 0 disables it.
#
# ⚠️ It undercounts: a run that times out or fails is recorded as $0, though
# it may have spent tokens before it died.
# ============================================================

spend_file() { printf '%s/%s' "$SPEND_DIR" "$(date -u +%Y-%m-%d)"; }

spend_today() {
    _sf=$(spend_file)
    if [ -f "$_sf" ]; then
        awk 'NR == 1 { v = $1 } END { printf "%.4f\n", v + 0 }' "$_sf"
    else
        echo "0.0000"
    fi
}

spend_add() {
    _sf=$(spend_file)
    awk -v a="$(spend_today)" -v b="${1:-0}" 'BEGIN { printf "%.4f\n", a + b }' > "$_sf.tmp" &&
        mv -f "$_sf.tmp" "$_sf"
}

# over_spend_cap <what> — true, and says so (throttled), once today's spend
# has reached the cap.
over_spend_cap() {
    awk -v s="$(spend_today)" -v c="$DAILY_SPEND_CAP" \
        'BEGIN { exit !(c + 0 > 0 && s + 0 >= c + 0) }' || return 1
    echo "daily spend cap \$${DAILY_SPEND_CAP} reached (\$$(spend_today) today); not investigating $1" >&2
    alert_failure_throttled ":warning: Tier 2 daily spend cap (\$${DAILY_SPEND_CAP}) reached on agent-lxc — investigations paused until 00:00 UTC. See ~/.logs/investigate.log"
    return 0
}

# run_agent — prompt on stdin. Uses --format json (text mode dumps the whole
# ANSI-wrapped session); keeps only the final assistant message and sums cost.
# Sets AGENT_OUTPUT, AGENT_RC, AGENT_COST.
run_agent() {
    _prompt=$(cat)
    # Hard timeout on the opencode call. Without it, a run that hangs (observed:
    # opencode occasionally finishes its work but the process does not exit)
    # would block investigate.sh forever — and since we hold the flock, that
    # stalls ALL future Tier 2 work, not just this run. -k 15 SIGKILLs it if it
    # ignores SIGTERM; the stray-process sweep below clears any detached child
    # opencode leaves behind (safe: the flock guarantees we are the only run).
    _raw=$(timeout -k 15 {{ agent_run_timeout_seconds }} \
           "$OPENCODE" run --agent "$MONITOR_AGENT" --format json "$_prompt" 2>&1)
    AGENT_RC=$?
    pkill -u "$(id -un)" -f 'opencode run' 2>/dev/null || true
    if [ "$AGENT_RC" -eq 124 ]; then
        AGENT_OUTPUT="opencode timed out after {{ agent_run_timeout_seconds }}s and was killed"
        AGENT_COST="0"; return
    fi
    if [ "$AGENT_RC" -ne 0 ]; then
        AGENT_OUTPUT="$_raw"; AGENT_COST="0"; return
    fi
    AGENT_OUTPUT=$(printf '%s' "$_raw" | python3 -c '
import json, sys
msgs, order = {}, []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    if ev.get("type") == "text":
        p = ev.get("part", {})
        mid = p.get("messageID")
        if mid not in msgs:
            msgs[mid] = []; order.append(mid)
        msgs[mid].append(p.get("text", ""))
print("".join(msgs[order[-1]]) if order else "")
' 2>/dev/null)
    AGENT_COST=$(printf '%s' "$_raw" | python3 -c '
import json, sys
t = 0.0
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    if ev.get("type") == "step_finish":
        t += ev.get("part", {}).get("cost", 0) or 0
print(f"{t:.4f}")
' 2>/dev/null)
    [ -z "$AGENT_COST" ] && AGENT_COST="0"
    if [ -z "$(printf '%s' "$AGENT_OUTPUT" | tr -d '[:space:]')" ]; then
        AGENT_RC=1
        AGENT_OUTPUT="agent exited 0 but produced no text. Raw head:
$(printf '%s' "$_raw" | head -c 500)"
    fi
}

# run_and_report <slack_channel> <header> — prompt on stdin. Runs the agent and,
# on success, extracts the marker-bounded plan, writes it to a dated file, and
# posts the clean summary to <slack_channel>. On failure, throttled-alerts to
# the watched channel (always #home-alerts, whatever the success channel is).
# Returns the agent rc and sets REPORT_PLAN to the plan file written. Used by
# all three modes so the marker-split, plan-write, cost-log and ledger logic
# lives in exactly one place — the digest previously posted AGENT_OUTPUT raw,
# which leaked the ===PLAN===/===SUMMARY=== markers to Slack.
run_and_report() {
    _channel="$1"
    _header="$2"
    REPORT_PLAN=""
    run_agent
    echo "run cost: \$${AGENT_COST}"
    spend_add "$AGENT_COST"
    if [ "$AGENT_RC" -ne 0 ]; then
        echo "run failed (rc=$AGENT_RC): $AGENT_OUTPUT" >&2
        alert_failure_throttled ":warning: ${_header} failed on agent-lxc (rc=$AGENT_RC). See ~/.logs/investigate.log"
        return "$AGENT_RC"
    fi

    # The agent emits ===PLAN=== <plan> ===SUMMARY=== <summary>. Extract between
    # the markers (discarding any narration/fences outside them).
    _plan=$(printf '%s\n' "$AGENT_OUTPUT" \
        | awk '/^===PLAN===[[:space:]]*$/{f=1;next} /^===SUMMARY===[[:space:]]*$/{f=0} f' \
        | grep -v '^```')
    _summary=$(printf '%s\n' "$AGENT_OUTPUT" | sed '1,/^===SUMMARY===[[:space:]]*$/d' | grep -v '^```')
    if [ -z "$(printf '%s' "$_plan" | tr -d '[:space:]')" ]; then
        echo "WARN: no ===PLAN=== marker; persisting raw output" >&2
        _plan="$AGENT_OUTPUT"
    fi
    if [ -z "$(printf '%s' "$_summary" | tr -d '[:space:]')" ]; then
        _summary=$(printf '%s\n' "$_plan" | grep -v '^[[:space:]]*$' | head -6)
    fi

    _slug=$(printf '%s\n' "$_plan" | sed -n 's/^#[[:space:]]*//p' | head -1 \
        | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' \
        | sed 's/^-*//;s/-*$//' | cut -c1-50)
    [ -z "$_slug" ] && _slug="anomaly"
    _file="$PLANS_DIR/$(date -u +%Y-%m-%d)-${_slug}.md"
    if printf '%s\n' "$_plan" > "$_file"; then
        _note="Plan: \`$_file\`"
        REPORT_PLAN="$_file"
    else
        _note="(Could not write the plan file — check the log.)"
    fi

    slack "$_channel" "${_header} (cost \$${AGENT_COST})

$_summary

$_note"
    echo "--- wrote: $_file ---"
    return 0
}

# ============================================================
# Weekly digest
# ============================================================

if [ "${1:-}" = "--digest" ]; then
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] weekly digest starting"
    compose_prompt <<'PROMPT'
Produce a weekly fleet health digest, following your normal output contract
(the ===PLAN=== / ===SUMMARY=== structure).

Sweep every host for slow-moving trends rather than acute faults: disk growth,
repeated service restarts, units that keep failing and self-healing, unusual
journal volume, and any host whose own monitoring has gaps. Read the per-host
monitoring logs with `sudo agent_read log <name>` — that is where trends show.

The plan body is the detailed findings across the fleet; the summary is a
short, severity-first "what to watch this week" for a human skimming it in
#home-logging. If the fleet is simply healthy, say so in one line rather than
padding it.
PROMPT
    run_and_report "${AGENT_SLACK_LOGGING:-}" ":bar_chart: *Weekly fleet digest*" < "$PROMPT_FILE"
    exit "$AGENT_RC"
fi

# ============================================================
# Slack watch — investigate failures the sweep can't see
# ============================================================

if [ "${1:-}" = "--slack" ]; then
    if [ -z "${SLACK_READ_TOKEN:-}" ]; then
        echo "SLACK_READ_TOKEN unset; slack watch not configured" >&2
        exit 0
    fi

    # A watermark is only usable if it is a positive number. Anything else —
    # missing file, junk, or the degenerate "0.000000" this script used to
    # write to itself — means "no watermark", and the poll asks for the
    # channel default instead. Treating a zero watermark as absent is also what
    # makes this self-healing: a host whose file was already poisoned recovers
    # on its next run without anyone reseeding it by hand.
    _oldest=$(cat "$SLACK_TS_FILE" 2>/dev/null || echo "")
    case "$_oldest" in ''|*[!0-9.]*) _oldest="" ;; esac
    if [ -n "$_oldest" ] && ! ts_is_positive "$_oldest"; then
        echo "ignoring non-positive slack watermark '$_oldest'; polling channel default" >&2
        _oldest=""
    fi

    # `oldest` is omitted rather than sent as 0 when there is no watermark. The
    # API's treatment of oldest=0 is not something this script should be
    # betting on, and omitting the parameter asks for the documented default.
    _url="https://slack.com/api/conversations.history?channel=${SLACK_CHANNEL}&limit=50"
    [ -n "$_oldest" ] && _url="${_url}&oldest=${_oldest}"

    _resp=$(curl -s --max-time 20 \
        -H "Authorization: Bearer ${SLACK_READ_TOKEN}" \
        "$_url")

    # Filter to genuine failure alerts and key each one to its incident.
    # Excludes our own posts and the channel's non-failure noise so we never
    # investigate ourselves into a loop.
    _parsed=$(printf '%s' "$_resp" | python3 -c '
import json, sys, re
try:
    d = json.load(sys.stdin)
except ValueError:
    print("ERR json"); sys.exit(0)
if not d.get("ok"):
    print("ERR " + str(d.get("error", "unknown"))); sys.exit(0)

# Seed the high-water mark with the value the poll was made with, NOT with
# zero. A window containing no new messages must report back the watermark it
# started from; seeding at 0.0 made an empty poll say "the newest message I saw
# was at time zero", which the caller then persisted, destroying the watermark
# on the first quiet hour and permanently breaking the watch.
try:
    maxts = float(sys.argv[1]) if len(sys.argv) > 1 else 0.0
except ValueError:
    maxts = 0.0
fleet = sys.argv[2].split() if len(sys.argv) > 2 else []
rows = []
for m in d.get("messages", []):
    try:
        tsf = float(m.get("ts", "0"))
    except ValueError:
        tsf = 0.0
    maxts = max(maxts, tsf)
    text = m.get("text", "") or ""
    for a in m.get("attachments", []) or []:
        text += " " + (a.get("text", "") or a.get("fallback", "") or "")
    low = text.lower()
    t = text.strip()
    # A genuine alert STARTS with an alert emoji (wrapper uses :x:, HA uses
    # :warning:/:rotating_light:), or carries the "ALERT:" header the wrapper
    # emits. Requiring the prefix (not just a keyword anywhere) excludes leaked
    # plan text ("# ...", "The sweep reported..."), journal dumps (start with a
    # digit), and other prose that merely mentions failed/error.
    # NOTE: no apostrophes in this block — it is inside python3 -c '...' and a
    # single quote would terminate the shell quoting.
    looks_alert = t.startswith((":x:", ":warning:", ":rotating_light:",
                                "❌", "🚨", "⚠️")) or ("ALERT:" in text)
    if not looks_alert:
        continue
    # our own output / channel noise
    if "agent-lxc" in low or "fleet investigation" in low:
        continue
    if t.startswith(":mag:") or t.startswith(":robot_face:"):
        continue
    if any(w in low for w in ("agent key in use", "trains to", "away mode",
                              "back to normal", "heartbeat")):
        continue
    # The incident key is the HOST, wherever the message names one: the
    # wrapper footer and system_health_check both print "Host: <name>", wrapper
    # titles end "on <name>", and HA alerts lead with the fleet host they are
    # about. One fault reported by three checks is then one key, not three.
    host = ""
    hm = re.search(r"\bHost: *([A-Za-z0-9][A-Za-z0-9.-]*)", text)
    if not hm:
        hm = re.search(r"(?:STILL FAILING|Script Failed) on ([A-Za-z0-9][A-Za-z0-9.-]*)", text)
    if hm:
        host = hm.group(1).lower()
    else:
        first = (t.splitlines() or [""])[0].lower()
        for h in fleet:
            if re.search(r"(?<![a-z0-9-])" + re.escape(h.lower()) + r"(?![a-z0-9-])", first):
                host = h.lower()
                break
    if host:
        key = "host-" + host
    else:
        # No host to be found: fall back to a content signature, so an alert
        # that names nothing is still deduped against its own repeats.
        sig = re.sub(r"[^a-z0-9 ]", " ", low)
        sig = re.sub(r"\b\d+\b", " ", sig)
        sig = re.sub(r"\s+", " ", sig).strip()[:60]
        key = "alert-" + (re.sub(r"[^a-z0-9]+", "-", sig).strip("-")[:50] or "alert")
    rows.append((tsf, key, " ".join(text.split())[:1500]))

print(f"OK {maxts:.6f}")
for tsf, key, text in sorted(rows):
    print(f"{tsf}\t{key}\t{text}")
' "${_oldest:-0}" "$FLEET_HOSTS" 2>/dev/null)

    _status=$(printf '%s\n' "$_parsed" | head -1)
    case "$_status" in
        "OK "*)
            _maxts=$(printf '%s' "$_status" | cut -d' ' -f2)
            ;;
        *)
            echo "slack fetch failed: $_status" >&2
            alert_failure_throttled ":warning: Slack watch could not read #home-alerts on agent-lxc ($_status). Check the read token. See ~/.logs/investigate.log"
            exit 1
            ;;
    esac

    _tmp=$(mktemp)
    _batch=$(mktemp)
    printf '%s\n' "$_parsed" | tail -n +2 > "$_tmp"

    # Every new incident in this poll goes into ONE investigation. Alerts that
    # arrive together usually share a cause, and one run that sees them all is
    # both cheaper and better placed to notice it than N runs that each see one.
    _keys=""
    _count=0
    _investigated=0
    _tab=$(printf '\t')
    while IFS="$_tab" read -r _tsf _key _text; do
        [ -z "$_key" ] && continue
        _key=$(incident_key "$_key")
        if incident_covered "$_key"; then
            incident_seen "$_key"
            echo "open incident '$_key' already investigated (plan: $(incident_plan "$_key")); not re-billing" >&2
            continue
        fi
        case " $_keys " in *" $_key "*) continue ;; esac
        if [ "$_count" -ge "$SLACK_MAX_PER_RUN" ]; then
            echo "reached SLACK_MAX_PER_RUN=$SLACK_MAX_PER_RUN; '$_key' not investigated (its alert still paged)" >&2
            continue
        fi
        _keys="$_keys $_key"
        _count=$((_count + 1))
        printf '* [%s] "%s"\n\n' "$_key" "$_text" >> "$_batch"
    done < "$_tmp"

    if [ "$_count" -gt 0 ] && ! over_spend_cap "$_count Slack incident(s):$_keys"; then
        echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] investigating $_count new Slack incident(s):$_keys"
        compose_prompt <<PROMPT
New failure alerts were posted to the Slack channel #home-alerts, each tagged
with the incident it belongs to:

$(cat "$_batch")

The hourly Tier 1 sweep did not surface these — they are likely per-service
monitoring-script failures or Home Assistant alerts. Investigate the underlying
cause on the affected host(s) and produce ONE plan following your output
contract. If several alerts share a root cause, say so and treat them as one
problem. Confirm each failure is still current before proposing a fix; these
alerts often fire on a schedule and may have self-cleared.
PROMPT
        # Opened only on success: a failed run leaves the incident unexplained,
        # so the next alert about it is investigated instead of skipped.
        if run_and_report "${AGENT_SLACK_ALERT:-}" ":mag: *Fleet investigation*" < "$PROMPT_FILE"; then
            for _k in $_keys; do
                incident_open "$_k" "$REPORT_PLAN"
            done
            _investigated=$_count
        fi
    fi
    rm -f "$_tmp" "$_batch"

    # Advance the watermark only after a successful fetch, so a failed poll
    # retries the same window rather than skipping alerts.
    #
    # The comparison is numeric. It used to be `[ "$_maxts" != "0" ]`, a string
    # compare — and the value it was guarding against was "0.000000", which is
    # not the string "0". The guard was written for exactly this case and let
    # it through anyway, which is the whole reason the watch died.
    if [ -n "$_maxts" ] && ts_is_positive "$_maxts"; then
        printf '%s' "$_maxts" > "$SLACK_TS_FILE"
    else
        echo "poll returned no usable watermark ('$_maxts'); preserving $SLACK_TS_FILE" >&2
    fi
    echo "slack watch done; investigated $_investigated incident(s)"
    exit 0
fi

# ============================================================
# Anomaly-triggered investigation (default)
# ============================================================

[ -f "$ANOMALY_FILE" ] || { echo "no anomaly snapshot; nothing to do"; exit 0; }

# Only look at a snapshot newer than the last one handled. Free, and it keeps
# the incident refresh below honest: Tier 1 leaves the snapshot in place after
# the fleet recovers, so only a CHANGED snapshot is evidence the findings in it
# are current. Refreshing from an unchanged one would hold a healed host's
# incident open forever.
if [ -f "$MARKER" ] && [ ! "$ANOMALY_FILE" -nt "$MARKER" ]; then
    echo "anomaly snapshot unchanged since last investigation; skipping"
    exit 0
fi

# Split the snapshot's hosts into those an open incident already explains and
# those nobody has looked at yet. Only the second group is paid for — which is
# what stops a host joining or leaving the finding set from re-billing every
# host that was already in it.
new_hosts=""
open_hosts=""
named=0
for h in $(anomaly_finding_hosts | sort -u); do
    named=$((named + 1))
    k=$(incident_key "host-$h")
    if incident_covered "$k"; then
        incident_seen "$k"
        open_hosts="$open_hosts $h"
    else
        new_hosts="$new_hosts $h"
    fi
done
new_hosts=${new_hosts# }
open_hosts=${open_hosts# }

# A snapshot naming no host at all means its format moved under this parser.
# That falls through to investigating the whole thing: an unparsed finding must
# cost money, never vanish.
if [ "$named" -gt 0 ] && [ -z "$new_hosts" ]; then
    echo "every finding belongs to an open incident ($open_hosts); not re-billing"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$MARKER"
    exit 0
fi

# If every NEW finding names a host Tier 1 has stopped probing, there is
# nothing to investigate: the agent's only access to those hosts is the SSH
# that is being refused. Running anyway means paying an agent to rediscover an
# auth failure by reproducing it — which is what banned this container. The
# marker is left alone deliberately: the snapshot's mtime no longer advances
# while the findings hold, so this stays free and re-evaluates the moment they
# change.
blocked=$(backed_off_hosts | tr '\n' ' ' | sed 's/[[:space:]]*$//')
if [ -n "$blocked" ] && [ -n "$new_hosts" ]; then
    investigable=0
    for h in $new_hosts; do
        case " $blocked " in
            *" $h "*) ;;
            *) investigable=1 ;;
        esac
    done
    if [ "$investigable" -eq 0 ]; then
        echo "every new finding concerns a host in SSH back-off ($blocked); nothing this agent can reach — skipping"
        exit 0
    fi
fi

# Marker untouched: under the cap this retries, free, every hour until the day
# rolls over.
over_spend_cap "anomaly (${new_hosts:-unparsed snapshot})" && exit 0

if [ "$named" -gt 0 ]; then
    findings=$(awk -v hosts=" $new_hosts " '
        match($0, /^[[:space:]]*"[^":]*:/) {
            h = substr($0, RSTART, RLENGTH)
            sub(/^[[:space:]]*"/, "", h); sub(/:$/, "", h)
            if (index(hosts, " " h " ")) {
                l = $0
                sub(/^[[:space:]]*"/, "", l); sub(/",?[[:space:]]*$/, "", l)
                print "- " l
            }
        }' "$ANOMALY_FILE")
else
    findings=$(cat "$ANOMALY_FILE")
fi

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] investigating new anomaly: ${new_hosts:-unparsed snapshot}"

compose_prompt <<PROMPT
The hourly Tier 1 fleet sweep reported the findings below. Investigate them and
produce a plan following your output contract.

Treat these findings as a starting point, not as ground truth: the sweep is
deliberately shallow and ran up to an hour ago. Confirm the symptom still
holds before reasoning about causes.

\`\`\`
$findings
\`\`\`
$(if [ -n "$open_hosts" ]; then printf '\nThe same sweep also named %s. Each already has an open investigation and\nplan, so do not investigate those hosts again; mention them only if they turn\nout to share a cause with the findings above.\n' "$open_hosts"; fi)
PROMPT
run_and_report "${AGENT_SLACK_ALERT:-}" ":mag: *Fleet investigation*" < "$PROMPT_FILE"
rc=$?

# Mark handled only on success, so a transient failure retries next hour rather
# than silently swallowing the anomaly.
if [ "$rc" -eq 0 ]; then
    for h in $new_hosts; do
        incident_open "$(incident_key "host-$h")" "$REPORT_PLAN"
    done
    date -u +%Y-%m-%dT%H:%M:%SZ > "$MARKER"
    rm -f "$FAIL_MARKER"
fi
exit "$rc"
