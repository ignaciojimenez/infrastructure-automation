#!/bin/sh
# fleet_health_check.sh — Tier 1 fleet sweep (managed by Ansible)
#
# One SSH round-trip per host as read_agent, checking what that account can
# actually see. Exits non-zero on any finding, which makes the surrounding
# enhanced_monitoring_wrapper post to #home-alerts.
#
# On a finding it also writes a machine-readable snapshot to
# last_anomaly.json — the trigger input Tier 2 consumes later.
#
# POSIX /bin/sh: the probes run on FreeBSD as well as Debian.

set -u

DISK_THRESHOLD={{ agent_disk_threshold }}
WRAPPER_MAX_AGE_HOURS={{ agent_wrapper_max_age_hours }}
SSH_TIMEOUT={{ agent_ssh_timeout }}
BACKOFF_BASE_SECONDS={{ agent_ssh_backoff_base_seconds }}
BACKOFF_MAX_SECONDS={{ agent_ssh_backoff_max_seconds }}
AGENT_DIR="{{ agent_state_dir }}"
ANOMALY_FILE="$AGENT_DIR/last_anomaly.json"
BACKOFF_DIR="$AGENT_DIR/ssh_backoff"

# name:kind pairs, from group_vars/agent.yml
FLEET="{% for h in agent_fleet_hosts %}{{ h.name }}:{{ h.kind }} {% endfor %}"

mkdir -p "$AGENT_DIR" "$BACKOFF_DIR"

FINDINGS=$(mktemp)
PROBE_OUT=$(mktemp)
SSH_ERR=$(mktemp)
# In AGENT_DIR rather than /tmp, so replacing the snapshot below is a
# same-filesystem rename and never leaves a half-written file for Tier 2.
SNAPSHOT=$(mktemp "$AGENT_DIR/.anomaly.XXXXXX")
trap 'rm -f "$FINDINGS" "$PROBE_OUT" "$SSH_ERR" "$SNAPSHOT"' EXIT INT TERM

note() {
    # note <host> <message>
    printf '%s: %s\n' "$1" "$2" >> "$FINDINGS"
}

ssh_probe() {
    # ssh_probe <host> — probe script on stdin, KEY=VALUE lines on stdout.
    #
    # stderr is captured rather than discarded. Telling "the far side refused
    # our credentials" apart from "the far side is not there" is what the
    # back-off below rests on, and that distinction exists only in stderr.
    : > "$SSH_ERR"
    ssh -o BatchMode=yes \
        -o ConnectTimeout="$SSH_TIMEOUT" \
        -o StrictHostKeyChecking=accept-new \
        "${1}-agent" "sh -s" 2>"$SSH_ERR"
}

# Reads KEY from the probe output. Absent keys yield an empty string, so a
# partial probe degrades to "unknown" rather than a bogus numeric comparison.
field() {
    sed -n "s/^${1}=//p" "$PROBE_OUT" | head -1
}

# A value is only comparable if it is a non-empty run of digits. Guards every
# threshold test below: without this, an empty or error string silently
# becomes 0 in arithmetic and reads as healthy.
is_number() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# ============================================================
# SSH auth back-off
#
# 2026-08-03: a genuine read_agent key failure on opnsense became a fleet
# outage. Every sweep found the host unreachable, Tier 2 investigated that
# finding the only way it can — by SSHing at the host — and the resulting
# burst of failed publickey auth read to CrowdSec as a brute-force. CrowdSec
# runs on the firewall, the firewall is the gateway, so it banned this
# container off its own network. The monitoring caused an outage instead of
# detecting one.
#
# So a host that REJECTS us is not re-probed on a fixed hourly cadence: its
# probe is suspended for a doubling window. Scoped deliberately to
# authentication failures — a host that is merely down logs no failed auth and
# trips no IPS, and is still worth retrying every sweep.
#
# The finding is still emitted on every sweep. Only the connection stops; the
# human keeps being told. Its wording is deliberately constant across sweeps,
# because the snapshot dedup at the bottom of this file compares content.
# ============================================================

AUTH_REJECTED_NOTE="SSH auth rejected as read_agent — probing suspended (back-off); repeated failed auth trips the firewall IPS"

ssh_auth_rejected() {
    # Did the last probe fail on our credentials, rather than on reachability?
    grep -q -e 'Permission denied' \
            -e 'Too many authentication failures' \
            -e 'No supported authentication methods' "$SSH_ERR"
}

backoff_state() {
    # "<consecutive_rejections> <next_attempt_epoch>", or nothing.
    [ -f "$BACKOFF_DIR/$1" ] || return 1
    cat "$BACKOFF_DIR/$1" 2>/dev/null
}

backoff_active() {
    _state=$(backoff_state "$1") || return 1
    _next=${_state##* }
    is_number "$_next" || return 1
    [ "$(date +%s)" -lt "$_next" ]
}

backoff_record() {
    # Doubling window, capped: the first rejection suspends probing for
    # BACKOFF_BASE_SECONDS, and every rejection that survives a retry doubles
    # it. A host broken for a day therefore costs a handful of failed auths in
    # total rather than one an hour forever, while a transient failure is
    # retried on the next sweep.
    _prev=$(backoff_state "$1" || echo "0 0")
    _count=${_prev%% *}
    is_number "$_count" || _count=0
    _count=$((_count + 1))
    # Keeps the shift below inside integer range; the cap makes it moot anyway.
    [ "$_count" -gt 16 ] && _count=16
    _delay=$(( BACKOFF_BASE_SECONDS << (_count - 1) ))
    [ "$_delay" -gt "$BACKOFF_MAX_SECONDS" ] && _delay="$BACKOFF_MAX_SECONDS"
    printf '%s %s\n' "$_count" "$(( $(date +%s) + _delay ))" > "$BACKOFF_DIR/$1"
}

backoff_clear() {
    rm -f "$BACKOFF_DIR/$1"
}

check_disk() {
    disk=$(field DISK)
    if is_number "$disk"; then
        [ "$disk" -ge "$DISK_THRESHOLD" ] && \
            note "$1" "disk usage ${disk}% (threshold ${DISK_THRESHOLD}%)"
    else
        note "$1" "disk usage unreadable"
    fi
}

check_failed_units() {
    failed=$(field FAILED)
    if is_number "$failed"; then
        [ "$failed" -gt 0 ] && \
            note "$1" "$failed failed systemd unit(s): $(field FAILEDUNITS)"
    else
        note "$1" "failed-unit count unreadable"
    fi
}

check_wrapper_freshness() {
    last=$(field WRAPPER_LAST)
    if is_number "$last"; then
        age_h=$(( ( $(date +%s) - last ) / 3600 ))
        [ "$age_h" -ge "$WRAPPER_MAX_AGE_HOURS" ] && \
            note "$1" "monitoring last ran ${age_h}h ago (max ${WRAPPER_MAX_AGE_HOURS}h)"
    else
        note "$1" "no monitoring run found in the journal"
    fi
}

# ============================================================
# Probes — one per host kind
# ============================================================

probe_linux() {
    ssh_probe "$1" > "$PROBE_OUT" <<'REMOTE'
echo "DISK=$(df -P / | awk 'NR==2{print $5}' | tr -d '%')"
echo "FAILED=$(sudo systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ')"
echo "FAILEDUNITS=$(sudo systemctl --failed --no-legend --no-pager 2>/dev/null | awk '{printf "%s ", $1}')"
echo "WRAPPER_LAST=$(sudo journalctl -u cron --no-pager -o short-unix -n 500 2>/dev/null | grep enhanced_monitoring_wrapper | tail -1 | cut -d. -f1)"
REMOTE
}

probe_proxmox() {
    ssh_probe "$1" > "$PROBE_OUT" <<'REMOTE'
echo "DISK=$(df -P / | awk 'NR==2{print $5}' | tr -d '%')"
echo "FAILED=$(sudo systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ')"
echo "FAILEDUNITS=$(sudo systemctl --failed --no-legend --no-pager 2>/dev/null | awk '{printf "%s ", $1}')"
echo "WRAPPER_LAST=$(sudo journalctl -u cron --no-pager -o short-unix -n 500 2>/dev/null | grep enhanced_monitoring_wrapper | tail -1 | cut -d. -f1)"
echo "ZPOOL=$(sudo zpool list -H -o health rpool 2>/dev/null)"
# Only guests set to start at boot are expected to be running. CT 102 is
# deliberately stopped with onboot=0; reporting it would alarm forever.
for id in $(sudo pct list 2>/dev/null | awk 'NR>1{print $1}'); do
    [ "$(sudo pct config "$id" 2>/dev/null | awk '/^onboot:/{print $2}')" = "1" ] || continue
    [ "$(sudo pct status "$id" 2>/dev/null | awk '{print $2}')" = "running" ] || echo "GUESTDOWN=CT-$id"
done
for id in $(sudo qm list 2>/dev/null | awk 'NR>1{print $1}'); do
    [ "$(sudo qm config "$id" 2>/dev/null | awk '/^onboot:/{print $2}')" = "1" ] || continue
    [ "$(sudo qm status "$id" 2>/dev/null | awk '{print $2}')" = "running" ] || echo "GUESTDOWN=VM-$id"
done
REMOTE
}

probe_freebsd() {
    ssh_probe "$1" > "$PROBE_OUT" <<'REMOTE'
echo "DISK=$(df -P / | awk 'NR==2{print $5}' | tr -d '%')"
echo "GW=$(netstat -rn -f inet | awk '$1=="default"{print $2; exit}')"
REMOTE
}

# ============================================================
# Sweep
# ============================================================

reachable=0
total=0
for entry in $FLEET; do total=$((total + 1)); done

# Resolver pre-check.
#
# Every fleet name resolves as <host>.local through Unbound on the gateway.
# If that resolver is down, all seven SSH attempts fail and the sweep would
# report the entire fleet as unreachable — technically true, useless as a
# diagnosis, and actively misleading: it blames seven healthy hosts for one
# broken dependency, at exactly the moment the observer is being relied on.
# The gateway also runs as a VM on the same hypervisor as this container, so
# this is a plausible failure, not a theoretical one.
dns_probe="${FLEET%%:*}"

if getent hosts "$dns_probe" >/dev/null 2>&1; then
    fleet_to_check="$FLEET"
else
    note "resolver" "cannot resolve '${dns_probe}' — fleet names resolve as <host>.local via Unbound on the gateway. Per-host checks skipped: without DNS they would all report false failures."
    fleet_to_check=""
fi

for entry in $fleet_to_check; do
    host="${entry%%:*}"
    kind="${entry##*:}"

    # A host in back-off is reported, not contacted.
    if backoff_active "$host"; then
        note "$host" "$AUTH_REJECTED_NOTE"
        continue
    fi

    : > "$PROBE_OUT"
    "probe_${kind}" "$host"

    # Every probe emits DISK. Its absence means the host never answered —
    # the probe's own exit status is unreliable here, because the forced
    # command wrapper on the far side masks it.
    if [ -z "$(field DISK)" ]; then
        if ssh_auth_rejected; then
            backoff_record "$host"
            note "$host" "$AUTH_REJECTED_NOTE"
        else
            note "$host" "UNREACHABLE (no response as read_agent)"
        fi
        continue
    fi
    backoff_clear "$host"
    reachable=$((reachable + 1))

    check_disk "$host"

    case "$kind" in
        linux|proxmox)
            check_failed_units "$host"
            check_wrapper_freshness "$host"
            ;;
    esac

    if [ "$kind" = proxmox ]; then
        zpool=$(field ZPOOL)
        if [ -z "$zpool" ]; then
            note "$host" "zpool health unreadable"
        elif [ "$zpool" != "ONLINE" ]; then
            note "$host" "zpool rpool is $zpool"
        fi
        sed -n 's/^GUESTDOWN=//p' "$PROBE_OUT" | while read -r guest; do
            note "$host" "$guest is set onboot but not running"
        done
    fi

    if [ "$kind" = freebsd ] && [ -z "$(field GW)" ]; then
        note "$host" "no default route"
    fi
done

# ============================================================
# Report
# ============================================================

count=$(wc -l < "$FINDINGS" | tr -d ' ')

if [ "$count" -eq 0 ]; then
    echo "Fleet OK — ${reachable}/${total} hosts reachable, no findings"
    exit 0
fi

echo "Fleet check found ${count} issue(s) across ${total} hosts:"
cat "$FINDINGS"

# Machine-readable snapshot for Tier 2. Escapes backslash first, then quote,
# so the escaping is not applied twice to the same character.
{
    printf '{\n'
    printf '  "timestamp": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "hosts_total": %s,\n' "$total"
    printf '  "hosts_reachable": %s,\n' "$reachable"
    printf '  "finding_count": %s,\n' "$count"
    printf '  "findings": [\n'
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' "$FINDINGS" | \
        awk '{ printf "%s    \"%s\"", (NR>1 ? ",\n" : ""), $0 } END { print "" }'
    printf '  ]\n'
    printf '}\n'
} > "$SNAPSHOT"

# Replace the snapshot only when the FINDINGS change.
#
# Tier 2 decides whether to investigate by comparing this file's mtime against
# its own marker, with the stated intent that a persistent fault is not
# re-investigated every hour. Rewriting the file on every sweep that found
# anything advanced that mtime hourly and defeated the guard completely: a
# fault lasting days was re-investigated, and re-billed, every hour.
#
# The timestamp line is excluded from the comparison because it changes on
# every run by construction — comparing whole files would leave the guard just
# as dead, in a subtler way.
if [ -f "$ANOMALY_FILE" ] &&
   [ "$(grep -v '"timestamp":' "$ANOMALY_FILE")" = "$(grep -v '"timestamp":' "$SNAPSHOT")" ]; then
    echo "(findings unchanged since the last sweep — $ANOMALY_FILE left untouched)"
else
    mv -f "$SNAPSHOT" "$ANOMALY_FILE"
fi

exit 1
