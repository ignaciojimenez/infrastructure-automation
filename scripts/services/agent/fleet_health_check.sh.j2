#!/bin/sh
# fleet_health_check.sh — Tier 1 fleet sweep (managed by Ansible)
#
# One SSH round-trip per host as read_agent, checking what that account can
# actually see — except opnsense, which is read over its HTTPS API because a
# shell there is not something OPNsense lets a non-admin account keep. Exits
# non-zero on any finding, which makes the surrounding
# enhanced_monitoring_wrapper post to #home-alerts.
#
# On a finding it also writes a machine-readable snapshot to
# last_anomaly.json — the trigger input Tier 2 consumes later.
#
# POSIX /bin/sh: the probes run on FreeBSD as well as Debian.

set -u

DISK_THRESHOLD={{ agent_disk_threshold }}
WRAPPER_MAX_AGE_HOURS={{ agent_wrapper_max_age_hours }}
SSH_TIMEOUT={{ agent_ssh_timeout }}
HEALTHCHECK_URL="{{ agent_sweep_healthcheck_url }}"
BACKOFF_BASE_SECONDS={{ agent_ssh_backoff_base_seconds }}
BACKOFF_MAX_SECONDS={{ agent_ssh_backoff_max_seconds }}
FLEET_WIDE_THRESHOLD={{ agent_fleet_wide_threshold }}
AGENT_DIR="{{ agent_state_dir }}"
ANOMALY_FILE="$AGENT_DIR/last_anomaly.json"
BACKOFF_DIR="$AGENT_DIR/ssh_backoff"

# ── OPNsense, which is read over its API and not over a shell ──────────────
#
# The firewall is the one host this container never SSHes into. OPNsense
# rewrites every non-admin account's shell to /usr/sbin/nologin whenever it
# regenerates users from config.xml (auth.inc:351), so a shell for read_agent
# is not a thing that can be granted once — it is reclaimed on the firmware's
# own schedule, and it was, twice. The API needs no login shell at all, so
# there is nothing left for an account regeneration to take away.
#
# It also retires a risk class rather than backing off from it: the 2026-08-03
# outage happened because failed SSH auth against the gateway reads to
# CrowdSec as a brute-force, and the gateway then banned this container off
# its own network. Nothing below ever authenticates over SSH to opnsense.
OPNSENSE_API_HOST="{{ agent_opnsense_api_host }}"
OPNSENSE_API_IP="{{ agent_opnsense_api_ip }}"
OPNSENSE_API_CA="{{ agent_opnsense_api_ca_path }}"
OPNSENSE_API_CREDS="{{ agent_opnsense_api_creds_path }}"
OPNSENSE_API_TIMEOUT={{ agent_opnsense_api_timeout }}

# ── opnsense monitoring freshness, read from healthchecks.io ───────────────
#
# NOT read from the firewall, and that is deliberate rather than a fallback.
#
# On every Linux host this question is answered by `journalctl -u cron`, because
# Debian's cron syslogs every CMD it runs. FreeBSD's does not — measured on this
# firewall 2026-08-17, its entire system log held five cron lines, all of them
# the service starting at boot, months apart. So there is no equivalent evidence
# on the box to read, over the API or otherwise.
#
# healthchecks.io answers it from outside instead, which is strictly stronger:
# it does not depend on the firewall being well enough to answer, and it does not
# depend on this container either.
#
# ⚠️ It reads the "monitoring alive" check, NOT the WAN or DNS ones. Those two
# ping only when the thing they check is healthy, so a stale timestamp on them
# means "WAN down" OR "monitoring stopped" — the exact two states this is here to
# separate. heartbeat_monitoring.sh on opnsense pings unconditionally for that
# reason.
HEALTHCHECKS_API_KEY_FILE="{{ agent_healthchecks_api_key_file }}"
HEALTHCHECKS_CHECK_NAME="{{ agent_opnsense_monitoring_check_name }}"

# name:kind pairs, from group_vars/agent.yml
FLEET="{% for h in agent_fleet_hosts %}{{ h.name }}:{{ h.kind }} {% endfor %}"

mkdir -p "$AGENT_DIR" "$BACKOFF_DIR"

FINDINGS=$(mktemp)
PROBE_OUT=$(mktemp)
SSH_ERR=$(mktemp)
API_OUT=$(mktemp)
# In AGENT_DIR rather than /tmp, so replacing the snapshot below is a
# same-filesystem rename and never leaves a half-written file for Tier 2.
SNAPSHOT=$(mktemp "$AGENT_DIR/.anomaly.XXXXXX")
trap 'rm -f "$FINDINGS" "$PROBE_OUT" "$SSH_ERR" "$API_OUT" "$SNAPSHOT"' EXIT INT TERM

# ⚠️ Appends to a FILE, and that is load-bearing rather than incidental.
#
# One caller runs inside `sed ... | while read`, and POSIX runs the right-hand
# side of a pipeline in a subshell — so anything `note` accumulated in a shell
# variable would be discarded when that loop exited, and the sweep would
# under-report without failing. Writing to $FINDINGS survives, because the file
# is not shell state.
#
# So do not "simplify" this into a counter or an appended-to variable. That is
# the exact bug `check_disk_usage` carried in system_health_check.sh: it
# printed a full disk correctly and still returned 0, because its increments
# happened in a subshell. Repo-wide audit 2026-08-06 found this to be the only
# remaining `cmd | while` that accumulates anything at all.
note() {
    # note <host> <message>
    printf '%s: %s\n' "$1" "$2" >> "$FINDINGS"
}

ssh_probe() {
    # ssh_probe <host> — probe script on stdin, KEY=VALUE lines on stdout.
    #
    # stderr is captured rather than discarded. Telling "the far side refused
    # our credentials" apart from "the far side is not there" is what the
    # back-off below rests on, and that distinction exists only in stderr.
    : > "$SSH_ERR"
    ssh -o BatchMode=yes \
        -o ConnectTimeout="$SSH_TIMEOUT" \
        -o StrictHostKeyChecking=accept-new \
        "${1}-agent" "sh -s" 2>"$SSH_ERR"
}

# Reads KEY from the probe output. Absent keys yield an empty string, so a
# partial probe degrades to "unknown" rather than a bogus numeric comparison.
field() {
    sed -n "s/^${1}=//p" "$PROBE_OUT" | head -1
}

# A value is only comparable if it is a non-empty run of digits. Guards every
# threshold test below: without this, an empty or error string silently
# becomes 0 in arithmetic and reads as healthy.
is_number() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# ============================================================
# SSH auth back-off
#
# 2026-08-03: a genuine read_agent key failure on opnsense became a fleet
# outage. Every sweep found the host unreachable, Tier 2 investigated that
# finding the only way it can — by SSHing at the host — and the resulting
# burst of failed publickey auth read to CrowdSec as a brute-force. CrowdSec
# runs on the firewall, the firewall is the gateway, so it banned this
# container off its own network. The monitoring caused an outage instead of
# detecting one.
#
# So a host that REJECTS us is not re-probed on a fixed hourly cadence: its
# probe is suspended for a doubling window. Scoped deliberately to
# authentication failures — a host that is merely down logs no failed auth and
# trips no IPS, and is still worth retrying every sweep.
#
# The finding is still emitted on every sweep. Only the connection stops; the
# human keeps being told. Its wording is deliberately constant across sweeps,
# because the snapshot dedup at the bottom of this file compares content.
# ============================================================

AUTH_REJECTED_NOTE="SSH auth rejected as read_agent — probing suspended (back-off); repeated failed auth trips the firewall IPS"

ssh_auth_rejected() {
    # Did the last probe fail on our credentials, rather than on reachability?
    grep -q -e 'Permission denied' \
            -e 'Too many authentication failures' \
            -e 'No supported authentication methods' "$SSH_ERR"
}

backoff_state() {
    # "<consecutive_rejections> <next_attempt_epoch>", or nothing.
    [ -f "$BACKOFF_DIR/$1" ] || return 1
    cat "$BACKOFF_DIR/$1" 2>/dev/null
}

backoff_active() {
    _state=$(backoff_state "$1") || return 1
    _next=${_state##* }
    is_number "$_next" || return 1
    [ "$(date +%s)" -lt "$_next" ]
}

backoff_record() {
    # Doubling window, capped: the first rejection suspends probing for
    # BACKOFF_BASE_SECONDS, and every rejection that survives a retry doubles
    # it. A host broken for a day therefore costs a handful of failed auths in
    # total rather than one an hour forever, while a transient failure is
    # retried on the next sweep.
    _prev=$(backoff_state "$1" || echo "0 0")
    _count=${_prev%% *}
    is_number "$_count" || _count=0
    _count=$((_count + 1))
    # Keeps the shift below inside integer range; the cap makes it moot anyway.
    [ "$_count" -gt 16 ] && _count=16
    _delay=$(( BACKOFF_BASE_SECONDS << (_count - 1) ))
    [ "$_delay" -gt "$BACKOFF_MAX_SECONDS" ] && _delay="$BACKOFF_MAX_SECONDS"
    printf '%s %s\n' "$_count" "$(( $(date +%s) + _delay ))" > "$BACKOFF_DIR/$1"
}

backoff_clear() {
    rm -f "$BACKOFF_DIR/$1"
}

check_disk() {
    disk=$(field DISK)
    if is_number "$disk"; then
        [ "$disk" -ge "$DISK_THRESHOLD" ] && \
            note "$1" "disk usage ${disk}% (threshold ${DISK_THRESHOLD}%)"
    else
        note "$1" "disk usage unreadable"
    fi
}

check_failed_units() {
    failed=$(field FAILED)
    if is_number "$failed"; then
        [ "$failed" -gt 0 ] && \
            note "$1" "$failed failed systemd unit(s): $(field FAILEDUNITS)"
    else
        note "$1" "failed-unit count unreadable"
    fi
}

check_wrapper_freshness() {
    last=$(field WRAPPER_LAST)
    if is_number "$last"; then
        age_h=$(( ( $(date +%s) - last ) / 3600 ))
        [ "$age_h" -ge "$WRAPPER_MAX_AGE_HOURS" ] && \
            note "$1" "monitoring last ran ${age_h}h ago (max ${WRAPPER_MAX_AGE_HOURS}h)"
    else
        note "$1" "no monitoring run found in the journal"
    fi
}

# ============================================================
# Dead-man's switch
#
# Everything above reports what the sweep FOUND. This reports that the sweep
# RAN — the one fault it is structurally incapable of noticing itself. It is
# not hypothetical: this container executed no jobs at all for its first 12
# days (every cron died on a redirect into a directory that did not exist,
# before the script was ever reached) and the silence went unnoticed because
# agent-lxc was the only host in the fleet without a healthchecks.io check.
# A ping from inside the script covers that exact shape — the cron dying early
# means no ping, which is precisely what should page.
#
# Pinged UNCONDITIONALLY, including when the sweep found problems and will
# exit 1. The gap this closes is silence, not findings: findings already reach
# #home-alerts through the wrapper. Gating the ping on a clean sweep would mean
# a sweep that runs and works stops pinging the moment it has something to say,
# conflating "the observer is dead" with "the fleet is unwell" — the two states
# that most need telling apart. (This deliberately differs from
# heartbeat_backup.sh, which pings only on recent success because it is
# asserting freshness of a backup, not existence of a run.)
#
# Never allowed to affect the sweep's own exit status: a dead-man's switch that
# can fail the thing it watches is a liability. hc-ping.com being unreachable
# is healthchecks' problem to alert on, not a fleet finding.
# ============================================================

# ⚠️ The ping's own exit status is reported, not swallowed.
#
# This was `|| true` with stderr discarded, which leaves the switch unable to
# say that ITS OWN ping failed — and those two states look identical from the
# outside. healthchecks.io shows the check DOWN whether the observer died or
# merely could not reach hc-ping.com, and with the status discarded there was
# nothing on this side to tell them apart afterwards. Same defect as
# heartbeat_backup.sh:30, fixed in the same change.
#
# Reported to stdout, so it lands in the wrapper's captured output and the
# fleet_health_check.log — deliberately NOT via note(), which would make it a
# fleet finding and page you because a third party's web service blipped.
ping_healthcheck() {
    [ -n "$HEALTHCHECK_URL" ] || return 0
    _ping_rc=0
    _ping_err=''
    if command -v curl >/dev/null 2>&1; then
        _ping_err=$(curl -fsS -m 10 --retry 3 "$HEALTHCHECK_URL" 2>&1 >/dev/null) || _ping_rc=$?
    elif command -v wget >/dev/null 2>&1; then
        _ping_err=$(wget -q -T 10 -t 3 -O /dev/null "$HEALTHCHECK_URL" 2>&1 >/dev/null) || _ping_rc=$?
    else
        echo "dead-man's switch: neither curl nor wget present — heartbeat NOT sent"
        return 0
    fi
    [ "$_ping_rc" -ne 0 ] && \
        echo "dead-man's switch: heartbeat ping FAILED (exit ${_ping_rc}): ${_ping_err}"
    return 0
}

# ============================================================
# Probes — one per host kind
# ============================================================

probe_linux() {
    ssh_probe "$1" > "$PROBE_OUT" <<'REMOTE'
echo "DISK=$(df -P / | awk 'NR==2{print $5}' | tr -d '%')"
echo "FAILED=$(sudo systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ')"
echo "FAILEDUNITS=$(sudo systemctl --failed --no-legend --no-pager --plain 2>/dev/null | awk '{printf "%s ", $1}')"
echo "WRAPPER_LAST=$(sudo journalctl -u cron --no-pager -o short-unix -n 500 2>/dev/null | grep enhanced_monitoring_wrapper | tail -1 | cut -d. -f1)"
REMOTE
}

probe_proxmox() {
    ssh_probe "$1" > "$PROBE_OUT" <<'REMOTE'
echo "DISK=$(df -P / | awk 'NR==2{print $5}' | tr -d '%')"
echo "FAILED=$(sudo systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ')"
echo "FAILEDUNITS=$(sudo systemctl --failed --no-legend --no-pager --plain 2>/dev/null | awk '{printf "%s ", $1}')"
echo "WRAPPER_LAST=$(sudo journalctl -u cron --no-pager -o short-unix -n 500 2>/dev/null | grep enhanced_monitoring_wrapper | tail -1 | cut -d. -f1)"
echo "ZPOOL=$(sudo zpool list -H -o health rpool 2>/dev/null)"
# Only guests set to start at boot are expected to be running. CT 102 is
# deliberately stopped with onboot=0; reporting it would alarm forever.
for id in $(sudo pct list 2>/dev/null | awk 'NR>1{print $1}'); do
    [ "$(sudo pct config "$id" 2>/dev/null | awk '/^onboot:/{print $2}')" = "1" ] || continue
    [ "$(sudo pct status "$id" 2>/dev/null | awk '{print $2}')" = "running" ] || echo "GUESTDOWN=CT-$id"
done
for id in $(sudo qm list 2>/dev/null | awk 'NR>1{print $1}'); do
    [ "$(sudo qm config "$id" 2>/dev/null | awk '/^onboot:/{print $2}')" = "1" ] || continue
    [ "$(sudo qm status "$id" 2>/dev/null | awk '{print $2}')" = "running" ] || echo "GUESTDOWN=VM-$id"
done
REMOTE
}

# ============================================================
# OPNsense over its API
#
# Not a probe_* function, because it does not go through ssh_probe and must
# not go through the SSH-shaped failure handling in the sweep loop below:
# there is no back-off to apply (nothing authenticates over SSH here) and no
# "answered but no usable shell" state to distinguish (there is no shell).
# ============================================================

# Set by api_call for its caller. API_FAIL classifies the failure so the sweep
# can tell "the firewall is not there" (which is a fleet-wide signal, and is
# collapsed with the other silent hosts) apart from "the firewall answered and
# refused us" (which is a credential problem and must never look like an
# outage). L-F's whole lesson: the detection worked, the wording hid what it
# found.
API_ERR=''
API_FAIL=''

api_call() {
    # api_call <method> <path> [extra curl args...] — body lands in $API_OUT.
    #
    # Returns 0 ONLY for: verified TLS, HTTP 200, and a body that parses as
    # JSON. Every one of those three is load-bearing; see below.
    _method=$1
    _path=$2
    shift 2
    API_ERR=''
    API_FAIL=''
    : > "$API_OUT"

    if ! command -v jq >/dev/null 2>&1; then
        API_ERR="jq is not installed on this container, so API responses cannot be parsed"
        API_FAIL=local
        return 1
    fi
    if [ ! -r "$OPNSENSE_API_CREDS" ]; then
        API_ERR="API credentials file $OPNSENSE_API_CREDS is missing or unreadable"
        API_FAIL=local
        return 1
    fi
    _key=$(sed -n 's/^key=//p' "$OPNSENSE_API_CREDS" | head -1)
    _secret=$(sed -n 's/^secret=//p' "$OPNSENSE_API_CREDS" | head -1)
    if [ -z "$_key" ] || [ -z "$_secret" ]; then
        API_ERR="API credentials file $OPNSENSE_API_CREDS holds no key/secret pair"
        API_FAIL=local
        return 1
    fi

    # ⚠️ The credential is fed to curl as a config file on STDIN, never as an
    # argument. Every process on this container can read /proc/*/cmdline, and
    # `-u key:secret` would put a firewall credential there for the lifetime
    # of the call.
    #
    # ⚠️ --location is deliberately absent, and that is a correctness
    # requirement rather than tidiness. Measured against this firewall
    # 2026-08-17:
    #
    #   no credential at all  → 302, an HTML redirect to the login page
    #   wrong key/secret      → 401, {"status":401,"message":"Authentication Failed"}
    #
    # So with -L the 302 is followed and comes back 200 with an HTML login
    # form — a revoked credential reading as a healthy response. And because
    # the 401 body is itself valid JSON, "the body parses as JSON" does not
    # catch that case either. Only requiring 200 AND JSON catches both.
    #
    # TLS is fully verified against the firewall's own self-signed certificate
    # rather than waved through with -k. The SAN is OPNsense.internal and the
    # host is reached by IP, so --resolve supplies the name that makes the
    # certificate match — which also means this check does not depend on DNS,
    # on a firewall whose own resolver is one of the things it is watching.
    _rc=0
    API_HTTP=$(printf 'user = "%s:%s"\n' "$_key" "$_secret" | \
        curl -K - \
             -s -o "$API_OUT" -w '%{http_code}' \
             -X "$_method" \
             --cacert "$OPNSENSE_API_CA" \
             --resolve "${OPNSENSE_API_HOST}:443:${OPNSENSE_API_IP}" \
             --max-time "$OPNSENSE_API_TIMEOUT" \
             "$@" \
             "https://${OPNSENSE_API_HOST}/${_path}" 2>/dev/null) || _rc=$?

    if [ "$_rc" -ne 0 ]; then
        # curl exit codes, verified against this firewall on 2026-08-17 rather
        # than quoted from the manual: a wrong --cacert gives 60, an
        # unreadable one gives 77.
        case "$_rc" in
            35|51|58|59|60|77|83)
                API_ERR="TLS verification failed (curl exit ${_rc}) — the firewall's web certificate no longer matches ${OPNSENSE_API_CA}. It is self-signed and gets replaced on regeneration or expiry, so this is a certificate to re-pin, not necessarily an attack."
                API_FAIL=tls
                ;;
            6|7|28)
                API_ERR="no answer from ${OPNSENSE_API_IP}:443 (curl exit ${_rc})"
                API_FAIL=unreachable
                ;;
            *)
                API_ERR="curl exit ${_rc} talking to the OPNsense API"
                API_FAIL=other
                ;;
        esac
        return 1
    fi

    case "$API_HTTP" in
        200) ;;
        302)
            API_ERR="HTTP 302 on ${_path} — the API redirected to the login page, which is how OPNsense answers a call carrying no usable credential at all"
            API_FAIL=auth
            return 1 ;;
        401)
            API_ERR="HTTP 401 on ${_path} — the API user's key/secret was rejected (revoked, regenerated, or the account is disabled)"
            API_FAIL=auth
            return 1 ;;
        403)
            API_ERR="HTTP 403 on ${_path} — authenticated but not authorised. The API user is missing the privilege whose ACL pattern covers this endpoint."
            API_FAIL=priv
            return 1 ;;
        *)
            API_ERR="HTTP ${API_HTTP} on ${_path}"
            API_FAIL=other
            return 1 ;;
    esac

    if ! jq -e . "$API_OUT" >/dev/null 2>&1; then
        API_ERR="HTTP 200 on ${_path} but the body is not JSON: $(head -c 120 "$API_OUT" | tr -d '\n')"
        API_FAIL=other
        return 1
    fi
    return 0
}

# Is the last api_call failure a property of the CONNECTION rather than of the
# endpoint it was aimed at? No credential, a rejected credential and a
# certificate that no longer matches all fail every call identically, so
# reporting them once per endpoint prints one fact three times — the alert
# flood wearing a different hat, which is the same reason the fleet-wide
# collapse further down exists.
#
# 403 is deliberately NOT in this set. Privileges in OPNsense are per-endpoint
# ACL patterns, so "disk reads fine but routes are forbidden" is a true and
# useful thing to be told, and collapsing it would hide exactly the failure
# this design was gated on.
api_fatal() {
    case "$API_FAIL" in
        local|auth|tls) return 0 ;;
        *) return 1 ;;
    esac
}

# Reads the "monitoring alive" check from healthchecks.io.
#
# ⚠️ The three outcomes are deliberately three, not two. Getting this wrong is
# the whole risk of sourcing a fleet signal from a third party:
#
#   check is down / stale  → the FIREWALL's monitoring stopped. A real finding.
#   we cannot ask          → UNKNOWN. Also a finding, worded so nobody reads it
#                            as the firewall being unwell.
#   check is up            → silence.
#
# A healthchecks.io outage, an expired key or a renamed check must never render
# as "opnsense monitoring is dead". That would page about the firewall because a
# third-party web service blipped — the same class of lie as a silent check, just
# in the other direction.
check_opnsense_monitoring_alive() {
    _host=$1
    _unknown="monitoring freshness UNKNOWN — could not reach healthchecks.io (this says nothing about the firewall itself)"

    if ! command -v jq >/dev/null 2>&1; then
        note "$_host" "$_unknown: jq is not installed on this container"
        return 0
    fi
    if [ ! -r "$HEALTHCHECKS_API_KEY_FILE" ]; then
        note "$_host" "$_unknown: API key file $HEALTHCHECKS_API_KEY_FILE is missing or unreadable"
        return 0
    fi
    _hc_key=$(sed -n 's/^api_key=//p' "$HEALTHCHECKS_API_KEY_FILE" | head -1)
    if [ -z "$_hc_key" ]; then
        note "$_host" "$_unknown: API key file holds no api_key= line"
        return 0
    fi

    # Key on stdin as a curl config file, never argv — /proc/*/cmdline is
    # world-readable on this container.
    #
    # The whole check list is fetched and matched by NAME rather than fetching
    # one check by uuid: a read-only healthchecks.io key omits uuid entirely and
    # exposes only unique_key, so name is the stable identifier available to the
    # least-privileged key that can answer this. Read-only is the right key here
    # — nothing should be able to pause or delete checks from this container.
    _hc_rc=0
    _hc_http=$(printf 'header = "X-Api-Key: %s"\n' "$_hc_key" | \
        curl -K - -s -o "$API_OUT" -w '%{http_code}' \
             --max-time "$OPNSENSE_API_TIMEOUT" \
             "https://healthchecks.io/api/v3/checks/" 2>/dev/null) || _hc_rc=$?

    if [ "$_hc_rc" -ne 0 ]; then
        note "$_host" "$_unknown: curl exit ${_hc_rc}"
        return 0
    fi
    if [ "$_hc_http" != "200" ]; then
        note "$_host" "$_unknown: HTTP ${_hc_http} from the healthchecks.io API"
        return 0
    fi
    if ! jq -e . "$API_OUT" >/dev/null 2>&1; then
        note "$_host" "$_unknown: the API returned a non-JSON body"
        return 0
    fi

    # `// empty` rather than a default, so a renamed or deleted check falls into
    # the UNKNOWN branch below instead of quietly evaluating as healthy.
    _hc_status=$(jq -r --arg n "$HEALTHCHECKS_CHECK_NAME" \
        'first(.checks[]? | select(.name == $n) | .status) // empty' "$API_OUT" 2>/dev/null)
    _hc_last=$(jq -r --arg n "$HEALTHCHECKS_CHECK_NAME" \
        'first(.checks[]? | select(.name == $n) | .last_ping) // empty' "$API_OUT" 2>/dev/null)

    if [ -z "$_hc_status" ]; then
        note "$_host" "$_unknown: no check named '${HEALTHCHECKS_CHECK_NAME}' exists in the account (renamed, deleted, or the key cannot see it)"
        return 0
    fi

    # `down` is healthchecks.io's own verdict against the period+grace configured
    # there, and it is trusted rather than recomputed. `grace` is deliberately NOT
    # a finding: it means one period was missed, which on a */5 heartbeat is a
    # dropped packet far more often than a dead cron.
    if [ "$_hc_status" = "down" ]; then
        note "$_host" "monitoring has STOPPED running — healthchecks.io reports '${HEALTHCHECKS_CHECK_NAME}' down (last ping ${_hc_last:-never})"
        return 0
    fi

    # Independent age check on top of the status, because the two can disagree:
    # the check's period/grace live in healthchecks.io's UI where this repo cannot
    # see them, so a period widened by hand there would silently widen this check
    # too. This bounds it from our side against the same threshold every other
    # host uses.
    if [ -n "$_hc_last" ]; then
        if _hc_epoch=$(date -d "$_hc_last" +%s 2>/dev/null) && is_number "$_hc_epoch"; then
            _hc_age=$(( ( $(date +%s) - _hc_epoch ) / 3600 ))
            [ "$_hc_age" -ge "$WRAPPER_MAX_AGE_HOURS" ] && \
                note "$_host" "monitoring last ran ${_hc_age}h ago (max ${WRAPPER_MAX_AGE_HOURS}h) — healthchecks.io still reports '${_hc_status}', so its period/grace is wider than this fleet's threshold"
        else
            note "$_host" "$_unknown: could not parse last_ping '${_hc_last}'"
        fi
    else
        note "$_host" "monitoring has NEVER pinged '${HEALTHCHECKS_CHECK_NAME}' — the check exists but the firewall has not reached it"
    fi
    return 0
}

check_opnsense() {
    # check_opnsense <host> — the whole firewall check, API-only.
    #
    # Returns 0 if the firewall answered at all (whatever it said), 1 if it is
    # not there. The caller uses that to decide whether this host joins the
    # fleet-wide silence collapse.
    _host=$1

    # ── Root filesystem ──
    #
    # Covered by the "Lobby: Dashboard" privilege (page-system-login-logout),
    # whose ACL lists api/diagnostics/system/system_disk literally.
    if api_call GET "api/diagnostics/system/system_disk"; then
        # The response is {"devices":[{...,"mountpoint":"/","used_pct":N}]}.
        # Selecting on mountpoint rather than taking the first device matters:
        # OPNsense returns every ufs/zfs/tmpfs filesystem, and on this box / is
        # not first. `// empty` keeps a shape change from yielding "null",
        # which is_number would then report as unreadable rather than healthy.
        disk=$(jq -r 'first(.devices[]? | select(.mountpoint == "/") | .used_pct) // empty' \
               "$API_OUT" 2>/dev/null | tr -d '% ')
        if is_number "$disk"; then
            [ "$disk" -ge "$DISK_THRESHOLD" ] && \
                note "$_host" "disk usage ${disk}% (threshold ${DISK_THRESHOLD}%)"
        else
            note "$_host" "disk usage unreadable — the API answered but no / filesystem with a numeric used_pct was in it"
        fi
    else
        [ "$API_FAIL" = unreachable ] && return 1
        if api_fatal; then
            note "$_host" "$API_ERR"
            return 0
        fi
        note "$_host" "disk usage unreadable over the API: $API_ERR"
    fi

    # ── Default route ──
    #
    # Covered by "Diagnostics: Routing tables" (page-diagnostics-routingtables),
    # whose ACL pattern is api/diagnostics/interface/get_routes*.
    #
    # This asks the firewall whether it still has a way out, which is the one
    # question its own monitoring cannot answer credibly: those crons only run
    # while the box is well, and the WAN heartbeat only proves packets move,
    # not that the routing table is intact.
    if api_call GET "api/diagnostics/interface/get_routes"; then
        gw=$(jq -r 'first(.[]? | select(.destination == "default") | .gateway) // empty' \
             "$API_OUT" 2>/dev/null)
        [ -z "$gw" ] && note "$_host" "no default route in the firewall's routing table"
    else
        [ "$API_FAIL" = unreachable ] && return 1
        if api_fatal; then
            note "$_host" "$API_ERR"
            return 0
        fi
        note "$_host" "default route unreadable over the API: $API_ERR"
    fi

    # ── Its own monitoring's freshness ──
    #
    # Answered from healthchecks.io, not from the firewall. See the block at the
    # top of this file for why there is nothing on the box to read.
    check_opnsense_monitoring_alive "$_host"

    return 0
}

# ============================================================
# Sweep
# ============================================================

reachable=0
total=0
for entry in $FLEET; do total=$((total + 1)); done

# Silent hosts are collected here rather than reported as they are found, so
# the decision below can see HOW MANY there are. See the collapse block after
# the loop for why that matters.
SILENT=$(mktemp)
trap 'rm -f "$FINDINGS" "$PROBE_OUT" "$SSH_ERR" "$API_OUT" "$SNAPSHOT" "$SILENT"' EXIT INT TERM

# Resolver pre-check.
#
# Every fleet name resolves as <host>.local through Unbound on the gateway.
# If that resolver is down, all seven SSH attempts fail and the sweep would
# report the entire fleet as unreachable — technically true, useless as a
# diagnosis, and actively misleading: it blames seven healthy hosts for one
# broken dependency, at exactly the moment the observer is being relied on.
# The gateway also runs as a VM on the same hypervisor as this container, so
# this is a plausible failure, not a theoretical one.
dns_probe="${FLEET%%:*}"

if getent hosts "$dns_probe" >/dev/null 2>&1; then
    fleet_to_check="$FLEET"
else
    # The SSH probes all need a name and would report false failures without
    # one. opnsense does not: its check reaches the firewall by IP and
    # supplies the certificate's name with curl --resolve, so it is kept in
    # the sweep here rather than skipped with the rest.
    #
    # That is the useful case, not an edge case. Unbound runs ON the gateway,
    # so "the whole fleet stopped resolving" and "the firewall is unwell" are
    # very often the same event — and this is the moment you most want an
    # independent read of the firewall rather than a sweep that has gone
    # quiet about it.
    fleet_to_check=""
    for entry in $FLEET; do
        [ "${entry##*:}" = opnsense ] && fleet_to_check="$fleet_to_check $entry"
    done
    note "resolver" "cannot resolve '${dns_probe}' — fleet names resolve as <host>.local via Unbound on the gateway. SSH-based per-host checks skipped: without DNS they would all report false failures. opnsense is still checked, over its API by IP."
fi

for entry in $fleet_to_check; do
    host="${entry%%:*}"
    kind="${entry##*:}"

    # opnsense is read over HTTPS and leaves the SSH machinery below entirely
    # alone — no probe, no back-off, no auth-rejection branch, because nothing
    # here authenticates over SSH to the firewall.
    #
    # A firewall that does not answer at all still joins $SILENT, so a site
    # power cut is still collapsed into one event rather than reported as six
    # hosts plus a separate firewall fault.
    if [ "$kind" = opnsense ]; then
        if check_opnsense "$host"; then
            reachable=$((reachable + 1))
        else
            echo "$host" >> "$SILENT"
        fi
        continue
    fi

    # A host in back-off is reported, not contacted.
    if backoff_active "$host"; then
        note "$host" "$AUTH_REJECTED_NOTE"
        continue
    fi

    : > "$PROBE_OUT"
    "probe_${kind}" "$host"

    # Every probe emits DISK. Its absence means the host never answered —
    # the probe's own exit status is unreliable here, because the forced
    # command wrapper on the far side masks it.
    if [ -z "$(field DISK)" ]; then
        if ssh_auth_rejected; then
            backoff_record "$host"
            note "$host" "$AUTH_REJECTED_NOTE"
        elif [ -s "$PROBE_OUT" ]; then
            # ── The third branch: answered, but with no usable shell ──
            #
            # "UNREACHABLE" is what a powered-off box looks like, and until now
            # a host that authenticated us fine and then refused to run
            # anything collapsed into the same words. That is this session's
            # own topic in miniature: the detection worked, the wording hid
            # what it found.
            #
            # Measured from agent-lxc against opnsense on 2026-08-13 rather
            # than reasoned about, and the measurement corrected the plan:
            #
            #   SSH_RC=1   STDERR=[]   STDOUT=[This account is currently not
            #                                  available.]
            #
            # So the discriminator is not the exit status (1, not 0) and not
            # stderr (empty) — it is that the far side sent us SOMETHING that
            # simply was not probe output. A live host answering with a banner,
            # a nologin refusal, or a forced-command rejection all land here,
            # and all of them mean the box is up.
            #
            # opnsense is the standing case: OPNsense rewrites the account's
            # shell to /usr/sbin/nologin on every regeneration from config.xml,
            # so this state returns on its own schedule.
            note "$host" "UP but no usable shell as read_agent — SSH authenticated and the host answered: $(head -1 "$PROBE_OUT")"
        else
            # Nothing at all came back. Held rather than reported, so the
            # collapse below can weigh it against the other hosts.
            echo "$host" >> "$SILENT"
        fi
        continue
    fi
    backoff_clear "$host"
    reachable=$((reachable + 1))

    check_disk "$host"

    case "$kind" in
        linux|proxmox)
            check_failed_units "$host"
            check_wrapper_freshness "$host"
            ;;
    esac

    if [ "$kind" = proxmox ]; then
        zpool=$(field ZPOOL)
        if [ -z "$zpool" ]; then
            note "$host" "zpool health unreadable"
        elif [ "$zpool" != "ONLINE" ]; then
            note "$host" "zpool rpool is $zpool"
        fi
        sed -n 's/^GUESTDOWN=//p' "$PROBE_OUT" | while read -r guest; do
            note "$host" "$guest is set onboot but not running"
        done
    fi
done

# ============================================================
# Fleet-wide absence is ONE signal, not N
#
# The power events of 2026-07-26 and 2026-08-09 took six hosts down inside a
# 15-second window and brought them back inside a 19-second one. That is a
# single external event, and reporting it as six independent host failures is
# the alert flood wearing a different hat — at precisely the moment the output
# most needs to be readable.
#
# It also says something different and more useful. Six silent hosts is not six
# faults to chase; it is "the site lost power" or "the gateway is gone", and
# the action is not per-host. Collapsing says that out loud.
#
# ⚠️ Deliberately NOT a suppression: the collapsed finding still fails the
# sweep, still pages, and still names every affected host. It changes how the
# event is described, not whether it is reported.
#
# The threshold is a judgement, so it is a variable rather than a constant.
# Below it, individual hosts are named as before — one Pi that did not come
# back is a real, chaseable fault and must keep reading like one.
# ============================================================

silent_count=$(wc -l < "$SILENT" | tr -d ' ')
is_number "$silent_count" || silent_count=0

if [ "$silent_count" -ge "$FLEET_WIDE_THRESHOLD" ]; then
    note "fleet" "FLEET-WIDE: ${silent_count}/${total} hosts silent at once ($(tr '\n' ' ' < "$SILENT" | sed 's/ $//')) — treat as ONE event (site power or gateway/network loss), not ${silent_count} host faults"
elif [ "$silent_count" -gt 0 ]; then
    while read -r silent_host; do
        [ -n "$silent_host" ] || continue
        # Deliberately not "as read_agent" any more: opnsense reaches this
        # line too and is never contacted as that user. A credential problem
        # never lands here on either path — SSH rejections go to the
        # auth-rejected branch and API rejections are named by HTTP status —
        # so silence really does mean silence, whatever the transport was.
        note "$silent_host" "UNREACHABLE — no response at all (host down, or off the network)"
    done < "$SILENT"
fi

# ============================================================
# Report
# ============================================================

count=$(wc -l < "$FINDINGS" | tr -d ' ')

# Before the branch, so there is exactly one call site and neither exit path
# can drift away from it.
ping_healthcheck

if [ "$count" -eq 0 ]; then
    echo "Fleet OK — ${reachable}/${total} hosts reachable, no findings"
    exit 0
fi

echo "Fleet check found ${count} issue(s) across ${total} hosts:"

# ❌ per finding, matching print_status in system_health_check.sh and every
# service check in this repo. Cosmetic here, load-bearing in the wrapper:
# enhanced_monitoring_wrapper builds its repeat-detection signature from the
# ❌-marked lines when any exist, and from the whole output when none do.
#
# Measured on agent-lxc 2026-08-14, which is why this line exists. Unmarked,
# the signature covered the whole output — including the bookkeeping line
# "(findings unchanged since the last sweep …)", which by construction appears
# only from the SECOND consecutive identical sweep onward. So the first repeat
# of every fault looked like a different fault and paged again: 2 alerts per
# fault rather than 1, for a reason that had nothing to do with the fleet.
#
# Marking the findings scopes the signature to what was actually found, and
# leaves the observer's own bookkeeping out of it.
#
# $FINDINGS itself is left unmarked on purpose — the JSON snapshot below and
# the unchanged-comparison both read that file, and neither should acquire a
# decorative character.
sed 's/^/❌ /' "$FINDINGS"

# Machine-readable snapshot for Tier 2. Escapes backslash first, then quote,
# so the escaping is not applied twice to the same character.
{
    printf '{\n'
    printf '  "timestamp": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "hosts_total": %s,\n' "$total"
    printf '  "hosts_reachable": %s,\n' "$reachable"
    printf '  "finding_count": %s,\n' "$count"
    printf '  "findings": [\n'
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' "$FINDINGS" | \
        awk '{ printf "%s    \"%s\"", (NR>1 ? ",\n" : ""), $0 } END { print "" }'
    printf '  ]\n'
    printf '}\n'
} > "$SNAPSHOT"

# Replace the snapshot only when the FINDINGS change.
#
# Tier 2 decides whether to investigate by comparing this file's mtime against
# its own marker, with the stated intent that a persistent fault is not
# re-investigated every hour. Rewriting the file on every sweep that found
# anything advanced that mtime hourly and defeated the guard completely: a
# fault lasting days was re-investigated, and re-billed, every hour.
#
# The timestamp line is excluded from the comparison because it changes on
# every run by construction — comparing whole files would leave the guard just
# as dead, in a subtler way.
if [ -f "$ANOMALY_FILE" ] &&
   [ "$(grep -v '"timestamp":' "$ANOMALY_FILE")" = "$(grep -v '"timestamp":' "$SNAPSHOT")" ]; then
    echo "(findings unchanged since the last sweep — $ANOMALY_FILE left untouched)"
else
    mv -f "$SNAPSHOT" "$ANOMALY_FILE"
fi

exit 1
