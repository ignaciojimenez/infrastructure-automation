#!/bin/bash
#
# Enhanced Monitoring Wrapper
# A smart monitoring wrapper with state tracking and intelligent notification rules
#
# Usage: enhanced_monitoring_wrapper [options] monitor_token alert_token script_path [script_args]
#
# Options:
#   --heartbeat-interval=daily|hourly|always|never  How often to send success heartbeats (default: daily; unknown values are fatal)
#   --state-file=/path/to/state.json          Custom state file location (default: in logs_dir)
#   --notify-fixed=true|false                 Whether to notify on self-healing (default: true)
#   --monitoring-name=name                    Name of the monitoring task. REQUIRED whenever two jobs
#                                             on the same host wrap the same script: without it the
#                                             state file is derived from the script's basename and
#                                             the jobs share — and corrupt — one state file.
#   --alert-repeat-base=SECONDS               Delay before an UNCHANGED failure is re-alerted
#                                             (default 3600). 0 disables suppression entirely.
#   --alert-repeat-max=SECONDS                Cap on that doubling delay (default 86400), so a
#                                             fault that persists still speaks at least daily.

# Don't use set -e here as we want to capture script failures
set -u          # stop on unset variables
set -o pipefail # stop on pipe failures

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Function for logging messages with timestamp
log_msg() {
  echo -e "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

# Function to safely escape JSON strings - using Python for reliability
escape_json() {
  local input="$1"
  # Limit input length to prevent oversized payloads
  if [ ${#input} -gt 1500 ]; then
    input="${input:0:1500}... (output truncated)"
  fi
  
  # Use Python for proper JSON string escaping - this is much more reliable than sed/tr
  python3 -c "import json; print(json.dumps('''$input''')[1:-1])" 2>/dev/null || \
  python -c "import json; print(json.dumps('''$input''')[1:-1])" 2>/dev/null || \
  echo "$input" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\r/\\r/g; s/\t/\\t/g' | tr '\n' ' '
}

# Function to display usage information
usage() {
  echo "Usage: $(basename "$0") [options] monitor_webhook_id [alert_webhook_id] path_to_script [all_arguments]"
  echo ""
  echo "Options:"
  echo "  --heartbeat-interval=daily|hourly|always|never  How often to send success heartbeats (default: daily; unknown values are fatal)"
  echo "  --state-file=/path/to/state.json          Custom state file location (default: in logs_dir)"
  echo "  --notify-fixed=true|false                 Whether to notify on self-healing (default: true)"
  echo "  --monitoring-name=name                    Name of the monitoring task. REQUIRED whenever two"
  echo "                                            jobs on the same host wrap the same script: without"
  echo "                                            it the state file is derived from the script's"
  echo "                                            basename and the jobs share - and corrupt - one"
  echo "                                            state file."
  echo "  --alert-repeat-base=SECONDS               Delay before an UNCHANGED failure is re-alerted"
  echo "                                            (default 3600). 0 disables suppression entirely."
  echo "  --alert-repeat-max=SECONDS                Cap on that doubling delay (default 86400)."
  echo ""
  echo "  monitor_webhook_id: Slack webhook ID for regular monitoring notifications"
  echo "  alert_webhook_id: Optional Slack webhook ID for error alerts (failures only)"
  echo "                    If not provided, monitor_webhook_id will be used for alerts too"
  echo "  path_to_script: Path to the script to execute"
  echo "  all_arguments: Arguments to pass to the script (optional)"
  echo ""
  echo "Examples:"
  echo "  # With separate alert webhook:"
  echo "  $(basename "$0") --heartbeat-interval=daily TXXXX/BXXXX/monitor_token TXXXX/BXXXX/alert_token /path/to/script.sh arg1"
  echo ""
  echo "  # With single webhook:"
  echo "  $(basename "$0") --notify-fixed=false TXXXX/BXXXX/webhook_token /path/to/script.sh arg1 arg2"
  echo ""
}

# Function to send Slack notifications
send_slack_notification() {
  local status=$1
  local execution_time=$2
  local exit_code=$3
  local output=$4
  local webhook_url=$5
  local is_alert=${6:-false}
  # Set only for a REPEAT alert (see the repeat-suppression block below). It
  # carries how long the fault has persisted and how many runs it has survived
  # — a reminder therefore says strictly more than the original page, not less.
  local repeat_note=${7:-}

  if [ -n "$repeat_note" ]; then
    output="${repeat_note}"$'\n\n'"${output}"
  fi

  # Truncate output if too long (Slack has a limit)
  local max_output_length=1500
  if [ ${#output} -gt $max_output_length ]; then
    output="${output:0:$max_output_length}...\n[Output truncated due to size limits]"
  fi
  
  # Determine emoji and color based on status
  local emoji=":white_check_mark:"
  local color="#36a64f"  # Green
  if [ "$status" != "SUCCESS" ]; then
    emoji=":x:"
    color="#ff0000"  # Red
  fi
  
  # Get hostname and timestamp
  local hostname=$(hostname)
  local timestamp=$(date +"%Y-%m-%d %H:%M:%S")
  
  # Escape all variables individually for JSON
  local escaped_output="$(escape_json "$output")"
  local escaped_script="$(escape_json "${script_path_sanitized} ${script_args_sanitized}")"
  local escaped_hostname="$(escape_json "$hostname")"
  local escaped_status="$(escape_json "$status")"
  local escaped_exit_code="$(escape_json "$exit_code")"
  local escaped_execution_time="$(escape_json "$execution_time")"
  local escaped_timestamp="$(escape_json "$timestamp")"
  local escaped_date_started="$(escape_json "$date_started")"
  
  # Create a more informative title for alerts
  local title="${emoji} Script Execution: ${status}"
  if [ "$is_alert" = "true" ]; then
    if [ -n "$repeat_note" ]; then
      title="${emoji} STILL FAILING on ${hostname}"
    else
      title="${emoji} ALERT: Script Failed on ${hostname}"
    fi
  fi
  
  # Create a JSON payload using a template approach
  local json_template='{
    "text": "TITLE",
    "attachments": [
      {
        "color": "COLOR",
        "fields": [
          {
            "title": "Host",
            "value": "HOSTNAME",
            "short": true
          },
          {
            "title": "Script",
            "value": "SCRIPT",
            "short": true
          },
          {
            "title": "Started",
            "value": "STARTED",
            "short": true
          },
          {
            "title": "Duration",
            "value": "DURATION seconds",
            "short": true
          },
          {
            "title": "Status",
            "value": "STATUS",
            "short": true
          },
          {
            "title": "Exit Code",
            "value": "EXIT_CODE",
            "short": true
          }
        ],
        "footer": "Enhanced Monitoring Wrapper • TIMESTAMP",
        "text": "*Output:*\n```OUTPUT```"
      }
    ]
  }'
  
  # Replace placeholders with escaped values
  local json_payload="${json_template}"
  json_payload="${json_payload//TITLE/$(escape_json "$title")}"
  json_payload="${json_payload//COLOR/$color}"
  json_payload="${json_payload//HOSTNAME/$escaped_hostname}"
  json_payload="${json_payload//SCRIPT/$escaped_script}"
  json_payload="${json_payload//STARTED/$escaped_date_started}"
  json_payload="${json_payload//DURATION/$escaped_execution_time}"
  json_payload="${json_payload//STATUS/$escaped_status}"
  json_payload="${json_payload//EXIT_CODE/$escaped_exit_code}"
  json_payload="${json_payload//TIMESTAMP/$escaped_timestamp}"
  json_payload="${json_payload//OUTPUT/$escaped_output}"
  
  # Save payload to debug file before sending
  echo "${json_payload}" > /tmp/slack_payload_debug.json
  
  # Log the payload for debugging (without sensitive information)
  if [ "$is_alert" = "true" ]; then
    log_msg "Sending notification to Slack (ALERT)"
  else
    log_msg "Sending notification to Slack (MONITORING)"
  fi
  
  # Send to Slack with proper Content-Type header
  local response=$(curl -s -X POST -H 'Content-type: application/json; charset=utf-8' --data "${json_payload}" "${webhook_url}" || echo "Failed to send notification")
  
  if [ "$response" != "ok" ]; then
    log_msg "${YELLOW}Warning: Slack notification may not have been sent properly. Response: ${response}${NC}"
    log_msg "${YELLOW}Debug payload saved to /tmp/slack_payload_debug.json${NC}"
    
    # Try an even simpler payload as fallback
    local fallback_payload="{\"text\":\"${emoji} Script execution on ${escaped_hostname}: ${escaped_status} (Exit code: ${escaped_exit_code})\"}"
    log_msg "${YELLOW}Trying fallback simple notification...${NC}"
    local fallback_response=$(curl -s -X POST -H 'Content-type: application/json; charset=utf-8' --data "${fallback_payload}" "${webhook_url}" || echo "Failed to send notification")
    if [ "$fallback_response" != "ok" ]; then
      log_msg "${RED}Fallback notification also failed. Response: ${fallback_response}${NC}"
      return 1
    else
      log_msg "${GREEN}Fallback notification sent successfully${NC}"
      return 0
    fi
  else
    log_msg "${GREEN}Notification sent successfully${NC}"
    return 0
  fi
}

# Parse options
HEARTBEAT_INTERVAL="daily"
NOTIFY_FIXED="true"
STATE_FILE=""
MONITORING_NAME=""
ALERT_REPEAT_BASE=3600
ALERT_REPEAT_MAX=86400

while [[ "$1" == --* ]]; do
  case "$1" in
    --heartbeat-interval=*)
      HEARTBEAT_INTERVAL="${1#*=}"
      shift
      ;;
    --state-file=*)
      STATE_FILE="${1#*=}"
      shift
      ;;
    --notify-fixed=*)
      NOTIFY_FIXED="${1#*=}"
      shift
      ;;
    --monitoring-name=*)
      MONITORING_NAME="${1#*=}"
      shift
      ;;
    --alert-repeat-base=*)
      ALERT_REPEAT_BASE="${1#*=}"
      shift
      ;;
    --alert-repeat-max=*)
      ALERT_REPEAT_MAX="${1#*=}"
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      log_msg "${RED}Unknown option: $1${NC}"
      usage
      exit 1
      ;;
  esac
done

# Validate the heartbeat interval up front.
#
# The dispatch below is an if/elif chain over daily|hourly|always, so any other
# value simply matched no branch and silently disabled heartbeats altogether.
# Two live jobs were relying on that by accident: `weekly` on dockassist's
# docker_system_prune (unintended — it had never heartbeated) and `never` on
# the OPNsense VPN gateway job (intended, but working only because the value
# was unrecognised). A monitoring job that goes quiet by typo is exactly the
# failure this wrapper exists to prevent, so an unknown value is now fatal.
#
# `never` is a supported value rather than another frequency: the cadence is
# already carried by the job's own cron schedule, and this setting only says
# how often to speak about it.
case "$HEARTBEAT_INTERVAL" in
  daily|hourly|always|never) ;;
  *)
    log_msg "${RED}Error: unrecognised --heartbeat-interval='${HEARTBEAT_INTERVAL}'${NC}"
    log_msg "${RED}Valid values: daily, hourly, always, never${NC}"
    exit 1
    ;;
esac

# A value is only usable if it is a non-empty run of digits. Same guard, and
# the same reasoning, as the sweep's: an empty or malformed string silently
# becomes 0 in arithmetic, and 0 here means "suppress nothing" — a typo would
# quietly restore the flood this option exists to stop. Fatal, like the
# heartbeat interval above, for the same reason.
is_number() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

if ! is_number "$ALERT_REPEAT_BASE"; then
  log_msg "${RED}Error: --alert-repeat-base must be a whole number of seconds, got '${ALERT_REPEAT_BASE}'${NC}"
  exit 1
fi
if ! is_number "$ALERT_REPEAT_MAX"; then
  log_msg "${RED}Error: --alert-repeat-max must be a whole number of seconds, got '${ALERT_REPEAT_MAX}'${NC}"
  exit 1
fi

if [ "$ALERT_REPEAT_MAX" -lt "$ALERT_REPEAT_BASE" ]; then
  log_msg "${RED}Error: --alert-repeat-max ($ALERT_REPEAT_MAX) is below --alert-repeat-base ($ALERT_REPEAT_BASE)${NC}"
  exit 1
fi

# Validate arguments
E_NOARGS=85
wh_regex="T[A-Z0-9]*\/B[A-Z0-9]*\/[a-zA-Z0-9]*"

# Check if we have at least the monitoring webhook and script path
if [ -z ${1+x} ] || [ -z ${2+x} ]; then
  log_msg "${RED}Error: Missing required arguments${NC}"
  usage
  exit "$E_NOARGS"
fi

# Check if the first argument is a valid webhook
if ! [[ $1 =~ $wh_regex ]]; then
  log_msg "${RED}Error: Monitor webhook format invalid. Expected format $wh_regex${NC}"
  usage
  exit 1
fi

# Determine if we have a separate alert webhook
monitor_wh=$1
monitor_hook="https://hooks.slack.com/services/$monitor_wh"

# Check if second argument is a webhook or a script path
if [[ $2 =~ $wh_regex ]]; then
  # We have a separate alert webhook
  alert_wh=$2
  alert_hook="https://hooks.slack.com/services/$alert_wh"
  
  # Check if we have a script path (now the third argument)
  if [ -z ${3+x} ]; then
    log_msg "${RED}Error: Missing script path${NC}"
    usage
    exit "$E_NOARGS"
  fi
  
  script_path=$3
  script_args="${*:4}"
  
  log_msg "Using separate webhooks for monitoring and alerts"
else
  # No separate alert webhook, use the monitor webhook for alerts too
  alert_wh=$monitor_wh
  alert_hook=$monitor_hook
  
  script_path=$2
  script_args="${*:3}"
  
  log_msg "Using single webhook for both monitoring and alerts"
fi

# Check if the script exists and is executable
if [ ! -f "$script_path" ]; then
  log_msg "${RED}Error: Script not found: $script_path${NC}"
  exit 1
elif [ ! -x "$script_path" ]; then
  log_msg "${YELLOW}Warning: Script is not executable. Attempting to execute anyway.${NC}"
fi

# Sanitize script path and args for logging (remove sensitive info)
script_path_sanitized=$(echo "$script_path" | sed "s/${wh_regex}/SLACK_TOKEN/g")
script_args_sanitized=$(echo "$script_args" | sed "s/${wh_regex}/SLACK_TOKEN/g")

# Get name for state file (prefer monitoring name if provided, otherwise use script name)
STATE_NAME="${MONITORING_NAME:-$(basename "$script_path")}"
if [ -z "$STATE_FILE" ]; then
  # Get username in a way that works in cron jobs (where $USER might be unset)
  CURRENT_USER="${USER:-$(whoami)}"
  # Fallback chain: use $SUDO_USER if available (for sudo commands), then $CURRENT_USER, then 'nobody'
  EFFECTIVE_USER="${SUDO_USER:-${CURRENT_USER:-nobody}}"
  STATE_DIR="${logs_dir:-/home/${EFFECTIVE_USER}/.log}"
  STATE_FILE="$STATE_DIR/${STATE_NAME}.json"
fi

# Ensure state directory exists
mkdir -p "$(dirname "$STATE_FILE")"

# Initialize state file if it doesn't exist
if [ ! -f "$STATE_FILE" ]; then
  echo '{"last_notification": "never", "last_status": "unknown", "last_success_notification": "never"}' > "$STATE_FILE"
fi

# Read previous state
LAST_STATUS=$(jq -r '.last_status' "$STATE_FILE" 2>/dev/null || echo "unknown")
LAST_NOTIFICATION=$(jq -r '.last_notification' "$STATE_FILE" 2>/dev/null || echo "never")
LAST_SUCCESS_NOTIFICATION=$(jq -r '.last_success_notification' "$STATE_FILE" 2>/dev/null || echo "never")

# Repeat-suppression state. Absent on every state file written before this
# change, and `jq -r` renders a missing key as the string "null" — which
# is_number rejects, so the first run after deploy takes the "fail open" path
# and alerts. That is the intended migration: a fleet mid-upgrade pages once
# more than it needs to, never once less.
LAST_FAILURE_SIGNATURE=$(jq -r '.failure_signature // ""' "$STATE_FILE" 2>/dev/null || echo "")
FAILURE_SINCE=$(jq -r '.failure_since // ""' "$STATE_FILE" 2>/dev/null || echo "")
FAILURE_RUNS=$(jq -r '.failure_runs // ""' "$STATE_FILE" 2>/dev/null || echo "")
FAILURE_ALERTS=$(jq -r '.failure_alerts // ""' "$STATE_FILE" 2>/dev/null || echo "")
NEXT_ALERT_EPOCH=$(jq -r '.next_alert_epoch // ""' "$STATE_FILE" 2>/dev/null || echo "")

# Digest of WHAT failed, used to tell "the same fault, again" from "a second,
# different fault on an already-failing host". The second must always page
# immediately, cooldown or not — otherwise suppression becomes the very thing
# it was written to prevent.
#
# Two normalisations, both measured against real captured output rather than
# assumed (2026-08-13, agent-lxc, two consecutive runs 15 min apart):
#
#   * ANSI colour codes are stripped. The markers below sit *between* SGR
#     sequences in the real output (`ESC[0;31m❌ESC[0m`), so anything matching
#     or hashing raw bytes is at the mercy of whether a tty was attached.
#   * digits collapse to `#`. Consecutive healthy runs differ only in numbers
#     — uptime, load average, `Memory: -447%` vs `-448%`. Hashing them raw
#     re-alerts on every single run and suppresses nothing at all.
#
# Then: prefer the lines that actually carry a failure. Digit-masking alone is
# not enough, because the header line `Date: Fri Aug 14 00:00:01 CEST 2026`
# varies by weekday and month *name* — non-numeric, so it survives the mask and
# would mint a new signature every midnight. Nearly every wrapped script in this
# repo marks errors with ❌ via print_status. Scripts that do not — the Tier 1
# sweep is the one that matters, and its output is byte-identical across runs —
# fall back to the whole masked body, which is correct for them.
#
# cksum, not sha256: POSIX, present on both Debian and FreeBSD (verified on
# opnsense), and this is change detection, not a security boundary. It emits a
# byte count alongside the CRC, so length changes alone already differ.
failure_signature() {
  local body marked esc
  esc=$'\033'
  body=$(printf '%s\n' "$1" | sed "s/${esc}\[[0-9;]*m//g")

  marked=$(printf '%s\n' "$body" | grep -F '❌' || true)
  if [ -n "$marked" ]; then
    body="$marked"
  fi

  printf '%s\n' "$body" \
    | sed -e 's/[0-9][0-9]*/#/g' \
          -e 's/[[:space:]][[:space:]]*/ /g' \
          -e 's/^ //' -e 's/ $//' \
    | cksum \
    | awk -v rc="$2" '{print rc ":" $1 "-" $2}'
}

# Get current date/time information
CURRENT_DATE=$(date +"%Y-%m-%d")
CURRENT_HOUR=$(date +"%H")
LAST_NOTIFICATION_DATE=${LAST_NOTIFICATION:0:10}
LAST_NOTIFICATION_HOUR=${LAST_NOTIFICATION:11:2}

# Record start time
date_started=$(date +"%Y-%m-%d %H:%M:%S")
start_seconds=$(date +%s)

log_msg "${GREEN}Starting execution of: ${script_path_sanitized} ${script_args_sanitized}${NC}"

# Create a temporary file for output
output_file=$(mktemp)

# Execute the script and capture both stdout and stderr
if [ -z "$script_args" ]; then
  "$script_path" > "$output_file" 2>&1
  exit_code=$?
else
  # Execute the script with arguments, preserving quotes
  # Create an array with the script path and all arguments
  declare -a cmd_array=( "$script_path" )
  
  # Parse the arguments properly, preserving quotes
  # This approach handles arguments with spaces correctly
  while IFS= read -r -d '' arg; do
    cmd_array+=("$arg")
  done < <(xargs printf '%s\0' <<< "$script_args")
  
  # Execute the command with all arguments
  "${cmd_array[@]}" > "$output_file" 2>&1
  exit_code=$?
fi

# Record end time and calculate duration
end_seconds=$(date +%s)
execution_time=$((end_seconds - start_seconds))

# Read the output
execution_result=$(cat "$output_file")
rm -f "$output_file"

# Determine if there were self-healing actions
ACTIONS_TAKEN=$(echo "$execution_result" | grep -c "ACTIONS TAKEN\|Fixed Issues\|Successfully restarted\|Restarted" || true)

# Determine current status based on exit code
if [ $exit_code -eq 0 ]; then
  CURRENT_STATUS="success"
  log_msg "${GREEN}Script completed successfully (exit code: $exit_code)${NC}"
else
  CURRENT_STATUS="failure"
  log_msg "${RED}Script failed with exit code: $exit_code${NC}"
fi

# Determine if we should send a notification
SEND_TO_MONITOR=false
SEND_TO_ALERT=false
REPEAT_NOTE=""
NOW_EPOCH=$(date +%s)
# Initialised before the branch so `set -u` cannot trip on the state write
# below if a future edit adds a status that neither branch handles.
CURRENT_FAILURE_SIGNATURE=""

# ============================================================
# Failure repeat suppression
#
# This branch used to read, in full:
#
#     # Always notify on failures
#     if [ "$CURRENT_STATUS" = "failure" ]; then
#       SEND_TO_ALERT=true
#
# No cooldown, no dedup. A fault that persists pages on every single run, so
# the alert rate is set by cron's schedule rather than by anything about the
# fault. Measured 2026-08-13: agent-lxc's hourly sweep had posted
# `ALERT: Script Failed` at :37 of every hour for 24 hours, all of them the
# same opnsense finding. On opnsense itself, where checks run every 1–5
# minutes, the same branch is worth up to 288 pages a day from one fault.
#
# The cost is not the noise. It is that a correct detection of a real outage
# — the sweep calling vinylstreamer UNREACHABLE, which was true for days — was
# buried inside its own repetition and went unread. The detection worked; the
# alerting hid it.
#
# So an UNCHANGED failure is re-alerted on a doubling delay: immediately, then
# after base, 2×base, 4×base … capped at max. Over a four-day outage that is
# roughly 8 pages instead of 96.
#
# Three properties keep this a fix rather than a lobotomy, and each has its own
# regression test in tests/unit/wrapper_alert_dedup_test.sh:
#
#   1. A CHANGED failure alerts immediately, whatever the cooldown says. A
#      second, different fault arriving on an already-failing host is exactly
#      the case where silence would be most expensive.
#   2. The cap is a floor on speech, not a ceiling on silence: while a fault
#      persists it is re-stated at least once per max (default: daily). It can
#      never go quiet permanently.
#   3. Unparseable or absent state fails OPEN — it alerts. Same rule as the
#      sweep's back-off state machine.
#
# ⚠️ Not covered, stated rather than implied: a FLAPPING fault. Success clears
# the failure state, so fail→recover→fail pages on every cycle. That is
# deliberate — each recovery is real and suppressing it would hide a genuine
# state change — but it means flap sources must be fixed at the source. The one
# known live case, vinylstreamer's single-ping connectivity check, is fixed in
# system_health_check.sh in this same change.
# ============================================================

if [ "$CURRENT_STATUS" = "failure" ]; then
  CURRENT_FAILURE_SIGNATURE=$(failure_signature "$execution_result" "$exit_code")

  if [ "$CURRENT_FAILURE_SIGNATURE" != "$LAST_FAILURE_SIGNATURE" ]; then
    # A new or changed fault. Always speaks, and resets the ladder.
    SEND_TO_ALERT=true
    FAILURE_SINCE="$NOW_EPOCH"
    FAILURE_RUNS=1
    FAILURE_ALERTS=1
    NEXT_ALERT_EPOCH=$((NOW_EPOCH + ALERT_REPEAT_BASE))
    log_msg "Sending alert (new or changed failure)"
  else
    is_number "$FAILURE_RUNS" || FAILURE_RUNS=0
    FAILURE_RUNS=$((FAILURE_RUNS + 1))
    is_number "$FAILURE_ALERTS" || FAILURE_ALERTS=1
    is_number "$FAILURE_SINCE" || FAILURE_SINCE="$NOW_EPOCH"

    if [ "$ALERT_REPEAT_BASE" -eq 0 ]; then
      SEND_TO_ALERT=true
      log_msg "Sending alert (repeat suppression disabled)"
    elif ! is_number "$NEXT_ALERT_EPOCH" || [ "$NOW_EPOCH" -ge "$NEXT_ALERT_EPOCH" ]; then
      SEND_TO_ALERT=true
      FAILURE_ALERTS=$((FAILURE_ALERTS + 1))
      # Keeps the shift below inside integer range; the cap makes it moot.
      [ "$FAILURE_ALERTS" -gt 16 ] && FAILURE_ALERTS=16
      _delay=$(( ALERT_REPEAT_BASE << (FAILURE_ALERTS - 1) ))
      [ "$_delay" -gt "$ALERT_REPEAT_MAX" ] && _delay="$ALERT_REPEAT_MAX"
      NEXT_ALERT_EPOCH=$((NOW_EPOCH + _delay))

      _elapsed=$(( (NOW_EPOCH - FAILURE_SINCE) / 60 ))
      REPEAT_NOTE=":repeat: Unchanged failure — ${FAILURE_RUNS} consecutive failing runs over ${_elapsed} minute(s). Next reminder in $(( _delay / 60 )) minute(s) unless the failure changes or clears."
      log_msg "Sending alert (repeat reminder: run ${FAILURE_RUNS}, next in ${_delay}s)"
    else
      log_msg "Alert suppressed: unchanged failure, ${FAILURE_RUNS} consecutive runs, next reminder in $(( (NEXT_ALERT_EPOCH - NOW_EPOCH) / 60 )) minute(s)"
    fi
  fi

# For successes, notification rules depend on settings
elif [ "$CURRENT_STATUS" = "success" ]; then
  # Heartbeat notifications based on interval setting
  if [ "$HEARTBEAT_INTERVAL" = "daily" ] && [ "$CURRENT_DATE" != "$LAST_NOTIFICATION_DATE" ]; then
    SEND_TO_MONITOR=true
    log_msg "Sending daily heartbeat notification"
  elif [ "$HEARTBEAT_INTERVAL" = "hourly" ] && ([ "$CURRENT_DATE" != "$LAST_NOTIFICATION_DATE" ] || [ "$CURRENT_HOUR" != "$LAST_NOTIFICATION_HOUR" ]); then
    SEND_TO_MONITOR=true
    log_msg "Sending hourly heartbeat notification"
  elif [ "$HEARTBEAT_INTERVAL" = "always" ]; then
    SEND_TO_MONITOR=true
    log_msg "Sending notification (always mode)"
  elif [ "$HEARTBEAT_INTERVAL" = "never" ]; then
    # Explicit, not incidental. Recovery notifications below still apply — a
    # job that never heartbeats must still say when it comes back from failure.
    log_msg "Heartbeat suppressed (never mode)"
  fi
  
  # Recovery notifications (previous status was failure)
  if [ "$LAST_STATUS" = "failure" ]; then
    SEND_TO_MONITOR=true
    log_msg "Sending recovery notification (previous run failed)"
  fi
  
  # Self-healing notifications
  if [ "$NOTIFY_FIXED" = "true" ] && [ $ACTIONS_TAKEN -gt 0 ]; then
    SEND_TO_MONITOR=true
    log_msg "Sending notification for self-healing actions"
  fi

  # A success ends the current failure episode. The next failure is therefore
  # a NEW one and pages at once, even if it turns out to be the same fault
  # returning — the recovery in between was a real state change, and the ladder
  # must not carry across it.
  CURRENT_FAILURE_SIGNATURE=""
  FAILURE_SINCE=""
  FAILURE_RUNS=""
  FAILURE_ALERTS=""
  NEXT_ALERT_EPOCH=""
fi

# Send notifications if needed
if [ "$SEND_TO_ALERT" = true ]; then
  send_slack_notification "FAILED" "$execution_time" "$exit_code" "$execution_result" "$alert_hook" "true" "$REPEAT_NOTE"
  echo "$(date) - Sent alert notification" >> "${STATE_FILE}.log"
elif [ "$CURRENT_STATUS" = "failure" ]; then
  # Logged locally even though nothing was sent. A suppressed alert that leaves
  # no trace is indistinguishable from a check that stopped running, which is
  # the failure mode this whole file exists to avoid.
  echo "$(date) - Suppressed alert (unchanged failure, run ${FAILURE_RUNS})" >> "${STATE_FILE}.log"
fi

if [ "$SEND_TO_MONITOR" = true ]; then
  send_slack_notification "SUCCESS" "$execution_time" "$exit_code" "$execution_result" "$monitor_hook" "false"
  echo "$(date) - Sent monitor notification" >> "${STATE_FILE}.log"
  LAST_SUCCESS_NOTIFICATION=$(date +"%Y-%m-%d %H:%M:%S")
fi

# Update state file
#
# The temp file is unique per invocation. It used to be a fixed
# "${STATE_FILE}.tmp", which two jobs writing the same state file in the same
# second would trample: the first mv wins and the second fails with
# "mv: cannot stat ...tmp". On dockassist three container checks shared one
# state file that way, so state never persisted, the daily heartbeat fired on
# every 10-minute run, and those three jobs alone produced ~92% of
# #home-logging. Their collision was caused by a missing --monitoring-name,
# but the fixed tmp path is what turned it into corruption instead of a
# harmless overwrite — and it is armed on every host for every future job.
#
# A failed update is also logged now. Previously `... && mv` simply carried on
# as though the state had persisted.
if command -v jq >/dev/null 2>&1; then
  state_tmp=$(mktemp "${STATE_FILE}.XXXXXX" 2>/dev/null)
  if [ -z "$state_tmp" ]; then
    log_msg "${YELLOW}Warning: could not create temp file for state update; state not persisted${NC}"
  elif jq --arg status "$CURRENT_STATUS" \
     --arg notification "$(date +"%Y-%m-%d %H:%M:%S")" \
     --arg success_notification "$LAST_SUCCESS_NOTIFICATION" \
     --arg failure_signature "$CURRENT_FAILURE_SIGNATURE" \
     --arg failure_since "$FAILURE_SINCE" \
     --arg failure_runs "$FAILURE_RUNS" \
     --arg failure_alerts "$FAILURE_ALERTS" \
     --arg next_alert_epoch "$NEXT_ALERT_EPOCH" \
     '.last_status = $status | .last_notification = $notification | .last_success_notification = $success_notification
      | .failure_signature = $failure_signature | .failure_since = $failure_since
      | .failure_runs = $failure_runs | .failure_alerts = $failure_alerts
      | .next_alert_epoch = $next_alert_epoch' \
     "$STATE_FILE" > "$state_tmp" && mv "$state_tmp" "$STATE_FILE"; then
    :
  else
    rm -f "$state_tmp"
    log_msg "${YELLOW}Warning: state update failed; $STATE_FILE left unchanged${NC}"
  fi
else
  # Fallback if jq is not available. Carries the repeat-suppression fields too:
  # without them the signature read back is always empty, so every failure looks
  # like a new one and the host silently keeps the old page-every-run behaviour.
  echo "{\"last_status\": \"$CURRENT_STATUS\", \"last_notification\": \"$(date +"%Y-%m-%d %H:%M:%S")\", \"last_success_notification\": \"$LAST_SUCCESS_NOTIFICATION\", \"failure_signature\": \"$CURRENT_FAILURE_SIGNATURE\", \"failure_since\": \"$FAILURE_SINCE\", \"failure_runs\": \"$FAILURE_RUNS\", \"failure_alerts\": \"$FAILURE_ALERTS\", \"next_alert_epoch\": \"$NEXT_ALERT_EPOCH\"}" > "$STATE_FILE"
fi

# Always log the execution to the log file
echo "$(date) - Executed with exit code $exit_code" >> "${STATE_FILE}.log"

# Output a summary to console
log_msg "Execution summary:"
log_msg "  Script: ${script_path_sanitized} ${script_args_sanitized}"
log_msg "  Started: ${date_started}"
log_msg "  Duration: ${execution_time} seconds"
log_msg "  Status: ${CURRENT_STATUS}"
log_msg "  Exit code: ${exit_code}"
log_msg "  Notification sent: $([ "$SEND_TO_MONITOR" = true ] || [ "$SEND_TO_ALERT" = true ] && echo "Yes" || echo "No")"
if [ "$CURRENT_STATUS" = "failure" ] && [ "$SEND_TO_ALERT" != true ]; then
  log_msg "  Alert suppressed: unchanged failure, run ${FAILURE_RUNS}, signature ${CURRENT_FAILURE_SIGNATURE}"
fi

# If there was output, show a preview
if [ -n "$execution_result" ]; then
  log_msg "  Output preview (first 5 lines):"
  echo "$execution_result" | head -n 5 | while read -r line; do
    echo "    $line"
  done
  
  if [ $(echo "$execution_result" | wc -l) -gt 5 ]; then
    log_msg "    ...(output truncated, full output in log)"
  fi
fi

# Output the full result to stdout for cron logs
echo "$execution_result"

# Exit with the same code as the wrapped script
exit $exit_code
